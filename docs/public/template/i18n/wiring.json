{
  "form": [
    {
      "uid": "languageSwitcher",
      "kind": "input",
      "type": "dropdown",
      "path": "lang",
      "label": { "key": "languageLabel", "default": "Language" },
      "props": {
        "labelField": "label",
        "valueField": "value",
        "items": [
          { "value": "en", "label": "🇬🇧 English" },
          { "value": "es", "label": "🇪🇸 Spanish" },
          { "value": "fr", "label": "🇫🇷 French" }
        ]
      },
      "on": { "change": "changeLanguage" }
    },
    {
      "kind": "input",
      "type": "textinput",
      "path": "username",
      "label": { "key": "usernameLabel", "default": "Username" }
    }
  ]
}
