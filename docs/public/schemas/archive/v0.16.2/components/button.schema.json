{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/archive/v0.16.2/components/button.schema.json",
  "title": "Button Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "variantProp": {
      "enum": [
        "filled",
        "outlined",
        "link"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "action"
    },
    "type": {
      "const": "button"
    },
    "actionType": {
      "enum": [
        "button",
        "submit"
      ]
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "on": {
      "$ref": "../common.schema.json#/$defs/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "variant": {
          "$ref": "#/$defs/variantProp"
        },
        "icon": {
          "type": "string"
        },
        "iconPosition": {
          "enum": [
            "left",
            "right"
          ]
        }
      },
      "patternProperties": {
        "^variant\\.[^.]+$": {
          "$ref": "#/$defs/variantProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    }
  },
  "required": [
    "kind",
    "type"
  ],
  "unevaluatedProperties": false
}
