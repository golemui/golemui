{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/archive/v0.14.0/components/flex.schema.json",
  "title": "Flex Widget",
  "type": "object",
  "$defs": {
    "directionProp": {
      "enum": [
        "row",
        "row-reverse",
        "column",
        "column-reverse"
      ]
    },
    "justifyProp": {
      "enum": [
        "center",
        "start",
        "end",
        "stretch"
      ]
    },
    "alignProp": {
      "enum": [
        "center",
        "start",
        "end",
        "space-between",
        "space-around",
        "space-evenly"
      ]
    },
    "gapProp": {
      "type": "number"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "layout"
    },
    "type": {
      "const": "flex"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../form.schema.json#/$defs/formWidget"
      }
    },
    "props": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/directionProp"
        },
        "justify": {
          "$ref": "#/$defs/justifyProp"
        },
        "align": {
          "$ref": "#/$defs/alignProp"
        },
        "gap": {
          "$ref": "#/$defs/gapProp"
        }
      },
      "patternProperties": {
        "^direction\\.[^.]+$": {
          "$ref": "#/$defs/directionProp"
        },
        "^justify\\.[^.]+$": {
          "$ref": "#/$defs/justifyProp"
        },
        "^align\\.[^.]+$": {
          "$ref": "#/$defs/alignProp"
        },
        "^gap\\.[^.]+$": {
          "$ref": "#/$defs/gapProp"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "type",
    "children"
  ],
  "unevaluatedProperties": false
}
