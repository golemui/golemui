{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/archive/v0.16.1/components/markdowntext.schema.json",
  "title": "MarkdownText Widget",
  "type": "object",
  "$defs": {
    "mdProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "display"
    },
    "type": {
      "const": "markdownText"
    },
    "props": {
      "type": "object",
      "properties": {
        "md": {
          "$ref": "#/$defs/mdProp"
        }
      },
      "patternProperties": {
        "^md\\.[^.]+$": {
          "$ref": "#/$defs/mdProp"
        }
      },
      "required": [
        "md"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "type",
    "props"
  ],
  "unevaluatedProperties": false
}
