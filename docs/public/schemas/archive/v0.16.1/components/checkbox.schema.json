{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/archive/v0.16.1/components/checkbox.schema.json",
  "title": "Checkbox Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "checkboxPositionProp": {
      "enum": [
        "left",
        "right"
      ],
      "default": "left"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "checkbox"
    },
    "path": {
      "$ref": "../common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "defaultValue": {
      "type": "boolean"
    },
    "props": {
      "type": "object",
      "properties": {
        "checkboxPosition": {
          "$ref": "#/$defs/checkboxPositionProp"
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        }
      },
      "patternProperties": {
        "^checkboxPosition\\.[^.]+$": {
          "$ref": "#/$defs/checkboxPositionProp"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": [
    "kind",
    "type",
    "path"
  ],
  "unevaluatedProperties": false
}
