{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/archive/v0.12.2/common.schema.json",
  "title": "Golem Common Definitions",
  "$defs": {
    "reactiveExpression": {
      "type": "string",
      "description": "A reactive expression string. Use `$form` to access form data e.g. `$form.termsAccepted === true`"
    },
    "dotPath": {
      "type": "string",
      "description": "A dot-separated path to a property in the form data"
    },
    "uid": {
      "type": "string",
      "description": "Unique identifier for the widget"
    },
    "localizable": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "default": {
              "type": "string"
            },
            "params": {
              "type": "object"
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "include": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "in": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "in"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/reactiveExpression"
            }
          },
          "required": [
            "when"
          ],
          "additionalProperties": false
        }
      ]
    },
    "exclude": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/reactiveExpression"
            }
          },
          "required": [
            "when"
          ],
          "additionalProperties": false
        }
      ]
    },
    "boolOrWhen": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/reactiveExpression"
            }
          },
          "required": [
            "when"
          ],
          "additionalProperties": false
        }
      ]
    },
    "on": {
      "type": "object",
      "properties": {
        "load": {
          "type": "string"
        },
        "click": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "filter": {
          "type": "string"
        },
        "blur": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^load\\.[^.]+$": {
          "type": "string"
        },
        "^click\\.[^.]+$": {
          "type": "string"
        },
        "^change\\.[^.]+$": {
          "type": "string"
        },
        "^filter\\.[^.]+$": {
          "type": "string"
        },
        "^blur\\.[^.]+$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "baseWidget": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "uid": {
          "$ref": "#/$defs/uid"
        },
        "type": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "include": {
          "$ref": "#/$defs/include"
        },
        "exclude": {
          "$ref": "#/$defs/exclude"
        }
      },
      "required": [
        "type"
      ]
    }
  }
}
