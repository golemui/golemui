---
import Default from '@astrojs/starlight/components/SocialIcons.astro';

// Strip the DSL locale prefix (/dx, /json) so we can detect the section
// regardless of which DSL variant the docs are being viewed in.
const path = Astro.url.pathname.replace(/^\/(dx|json)(?=\/|$)/, '');
const isBlog = path === '/blog' || path.startsWith('/blog/');
---

<nav class="primary-nav sl-flex" aria-label="Primary">
  <a href="/dx/getting-started/installation" class="nav-link" aria-current={isBlog ? undefined : 'page'}>
    Docs
  </a>
  <a href="/blog" class="nav-link" aria-current={isBlog ? 'page' : undefined}>
    Blog
  </a>
</nav>
<Default><slot /></Default>

<style>
  .primary-nav {
    align-items: center;
    gap: 0.75rem;
    padding-inline-end: 0.75rem;
    margin-inline-end: 0.25rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  .nav-link {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    line-height: 1;
  }

  .nav-link:hover {
    color: var(--sl-color-white);
  }

  .nav-link[aria-current='page'] {
    color: var(--sl-color-text-accent);
  }
</style>
