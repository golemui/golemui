---
import config from 'virtual:starlight/user-config';
import Select from '@astrojs/starlight/components/Select.astro';

const localeKeys = Object.keys(config.locales ?? {}).filter((k) => k !== 'root');

/**
 * Get the equivalent of the current page path for the passed locale.
 * Replaces the current locale prefix in the URL with the target locale.
 */
function localizedPathname(targetLocale: string): string {
  const { pathname } = Astro.url;
  const currentLocale = Astro.locals.starlightRoute?.locale;

  if (currentLocale) {
    // Replace current locale prefix with target
    return pathname.replace(`/${currentLocale}`, `/${targetLocale}`);
  }
  // Root locale (no prefix) — prepend target locale
  return `/${targetLocale}${pathname}`;
}
---

{
  config.isMultilingual && (
    <starlight-lang-select>
      <Select
        icon="seti:code"
        label="Framework"
        options={Object.entries(config.locales)
          .filter(([code]) => code !== 'root')
          .map(([code, locale]) => ({
            value: localizedPathname(code),
            selected: code === Astro.locals.starlightRoute.locale,
            label: locale!.label,
          }))}
        width="8em"
      />
    </starlight-lang-select>
  )
}

<script>
  class StarlightLanguageSelect extends HTMLElement {
    constructor() {
      super();
      const select = this.querySelector('select');
      if (select) {
        select.addEventListener('change', (e) => {
          if (e.currentTarget instanceof HTMLSelectElement) {
            window.location.pathname = e.currentTarget.value;
          }
        });
        window.addEventListener('pageshow', (event) => {
          if (!event.persisted) return;
          const markupSelectedIndex =
            select.querySelector<HTMLOptionElement>('option[selected]')?.index;
          if (markupSelectedIndex !== select.selectedIndex) {
            select.selectedIndex = markupSelectedIndex ?? 0;
          }
        });
      }
    }
  }
  customElements.define('starlight-lang-select', StarlightLanguageSelect);
</script>
