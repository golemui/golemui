---
// The shared site footer — used on the homepage, the /demos page, and every
// Starlight docs page (via the PageFrame override). Self-contained: it carries
// its own colours and only flips on `[data-theme='dark']`, which all three
// contexts set on <html>, so it looks right everywhere with no page tokens.
---

<footer class="landing-footer">
  <div class="lf-container">
    <div class="footer-content">
      <div class="footer-col">
        <svg class="footer-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 220" width="140" height="42" role="img" aria-label="GolemUI">
          <defs>
            <linearGradient id="footer-brand" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#3b82f6" />
              <stop offset="50%" stop-color="#8b5cf6" />
              <stop offset="100%" stop-color="#a855f7" />
            </linearGradient>
          </defs>
          <text x="200" y="170" font-family="Inter, system-ui, -apple-system, sans-serif" font-weight="600" font-size="160" text-anchor="middle" letter-spacing="-2">
            <tspan fill="url(#footer-brand)">{'{'}</tspan><tspan fill="currentColor">gui.</tspan><tspan fill="url(#footer-brand)">{'}'}</tspan>
          </text>
        </svg>
        <p>The Declarative Form Engine.</p>
      </div>
      <div class="footer-col">
        <h4>Product</h4>
        <a href="/dx/getting-started/installation/">Documentation</a>
        <a href="https://github.com/golemui/golemui/blob/main/CHANGELOG.md" target="_blank">Changelog</a>
      </div>
      <div class="footer-col">
        <h4>Social</h4>
        <a href="https://github.com/golemui/golemui" target="_blank">GitHub</a>
        <a href="https://www.npmjs.com/org/golemui" target="_blank">NPM</a>
        <a href="https://youtube.com/@getgolemui" target="_blank">Youtube</a>
        <a href="https://x.com/getgolemui" target="_blank">X</a>
        <a href="https://www.linkedin.com/company/golemui/" target="_blank">Linkedin</a>
      </div>
      <div class="footer-col">
        <h4>Legal</h4>
        <a href="/legal/privacy">Privacy</a>
        <a href="/legal/terms">Terms</a>
        <a href="https://github.com/golemui/golemui/blob/main/LICENSE" target="_blank">License</a>
      </div>
    </div>
    <div class="copyright">&copy; 2025 GolemUI. All rights reserved.</div>
  </div>
</footer>

<style>
  .landing-footer {
    --ft-bg: #f8fafc;
    --ft-border: #e2e8f0;
    --ft-text: #0f172a;
    --ft-muted: #64748b;
    --ft-hover: #8b5cf6;
    position: relative;
    z-index: 1;
    padding: 5rem 0 2.5rem;
    border-top: 1px solid var(--ft-border);
    background: var(--ft-bg);
    color: var(--ft-text);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
  :global([data-theme='dark']) .landing-footer {
    --ft-bg: #111318;
    --ft-border: #1e293b;
    --ft-text: #f1f5f9;
    --ft-muted: #94a3b8;
  }
  .lf-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .footer-content {
    display: grid;
    grid-template-columns: 2.5fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 480px) {
    .footer-content {
      grid-template-columns: 1fr;
    }
  }
  .footer-mark {
    height: 36px;
    width: auto;
    display: block;
    margin: 0 0 0.75rem;
    color: var(--ft-text);
  }
  .footer-col h4 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 1.25rem;
    color: var(--ft-muted);
  }
  .footer-col p {
    color: var(--ft-muted);
    line-height: 1.6;
    font-size: 0.9375rem;
    margin: 0;
  }
  .footer-col a {
    display: block;
    color: var(--ft-muted);
    text-decoration: none;
    margin-bottom: 0.625rem;
    font-size: 0.9375rem;
    transition: color 0.2s;
  }
  .footer-col a:hover {
    color: var(--ft-hover);
  }
  .copyright {
    text-align: center;
    color: var(--ft-muted);
    font-size: 0.8125rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--ft-border);
  }
</style>
