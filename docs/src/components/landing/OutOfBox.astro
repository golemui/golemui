---
const cards = [
  {
    eyebrow: 'Accessibility',
    title: 'Accessible by default.',
    body: 'WCAG 2.1 AA, full keyboard nav, semantic HTML, ARIA managed for you. Errors wired to aria-describedby. Screen-reader friendly out of the gate.',
  },
  {
    eyebrow: 'Internationalization',
    title: 'Global by design.',
    body: 'Bring your own i18n library — i18next, Lingui, custom — through a simple adapter. Translate labels, hints, validators, dates. Switch languages live. Automatic RTL.',
  },
  {
    eyebrow: 'Validation',
    title: 'Bulletproof data.',
    body: 'Schema-driven, @standard-schema/spec compliant. Built-in rules plus your own custom validators. Localized error messages with smart timing that respects user interaction.',
  },
];
---

<section id="out-of-box" class="out-of-box-section">
  <div class="container">
    <div class="content">
      <h2>
        Three things every form needs. <span class="gradient-text">Already done</span>.
      </h2>
      <p class="subtitle">
        Accessibility, internationalization, validation — wired into the engine. Three categories that quietly eat months of project time, all handled before you write a single field.
      </p>
    </div>

    <div class="cards-grid">
      {cards.map((card) => (
        <article class="card">
          <p class="eyebrow">{card.eyebrow}</p>
          <h3 class="card-title">{card.title}</h3>
          <p class="card-body">{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  .out-of-box-section {
    padding: 1.5rem 0 4rem;
    overflow: hidden;
  }

  .container {
    display: flex;
    flex-direction: column;
  }

  .content {
    margin-bottom: 2rem;
  }

  h2 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.08;
    margin: 0 0 0.5rem;
    letter-spacing: -0.03em;

    @media (min-width: 768px) {
      font-size: 3rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
    max-width: 60rem;

    @media (min-width: 768px) {
      font-size: 1.25rem;
      line-height: 1.55;
    }
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;

    @media (min-width: 50rem) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    position: relative;
    padding: 2rem 1.75rem;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    background: var(--bg-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.3s ease;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #a855f7);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(59, 130, 246, 0.08);
    border-color: rgba(139, 92, 246, 0.25);
  }

  .card:hover::before {
    opacity: 1;
  }

  :global(html.dark) .card:hover {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .eyebrow {
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.65rem;
    letter-spacing: -0.01em;
    color: var(--text-color);
    line-height: 1.25;
  }

  .card-body {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }
</style>
