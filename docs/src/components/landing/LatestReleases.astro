---
---

<section class="latest-releases">
  <div class="container">
    <div class="header">
      <h2>Latest Updates</h2>
      <p class="subtitle">We ship fast. Here is what's new.</p>
    </div>

    <div class="timeline">
      <div class="release">
        <div class="date">Oct 24, 2025</div>
        <div class="content">
          <div class="version">v2.1.0</div>
          <h3>Data Grid & Charts</h3>
          <p>
            Introduced the new high-performance Data Grid component with virtualization support and
            a new charting library.
          </p>
          <div class="tags">
            <span class="tag new">New Feature</span>
            <span class="tag">Pro</span>
          </div>
        </div>
      </div>

      <div class="release">
        <div class="date">Oct 10, 2025</div>
        <div class="content">
          <div class="version">v2.0.5</div>
          <h3>Accessibility Improvements</h3>
          <p>
            Enhanced WAI-ARIA support across all core components and improved keyboard navigation.
          </p>
          <div class="tags">
            <span class="tag fix">Improvement</span>
            <span class="tag">Core</span>
          </div>
        </div>
      </div>

      <div class="release">
        <div class="date">Sep 28, 2025</div>
        <div class="content">
          <div class="version">v2.0.0</div>
          <h3>GolemUI 2.0</h3>
          <p>
            Major release with a completely rewritten reactivity engine, reducing bundle size by
            40%.
          </p>
          <div class="tags">
            <span class="tag major">Major Release</span>
          </div>
        </div>
      </div>
    </div>

    <div class="action">
      <a href="/changelog" class="btn btn-secondary">View Full Changelog</a>
    </div>
  </div>
</section>

<style lang="scss">
  .latest-releases {
    padding: 6rem 0;
    background: var(--bg-surface);
  }

  .header {
    text-align: center;
    margin-bottom: 4rem;

    h2 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .subtitle {
      font-size: 1.25rem;
      color: var(--text-muted);
    }
  }

  .timeline {
    max-width: 800px;
    margin: 0 auto 3rem;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 143px;
      width: 2px;
      background: var(--border-color);

      @media (max-width: 768px) {
        left: 20px;
      }
    }
  }

  .release {
    display: flex;
    gap: 3rem;
    margin-bottom: 3rem;
    position: relative;

    @media (max-width: 768px) {
      flex-direction: column;
      gap: 1rem;
      padding-left: 3rem;
    }

    &::before {
      content: '';
      position: absolute;
      left: 136px;
      top: 24px;
      width: 12px;
      height: 12px;
      background: var(--bg-color);
      border: 2px solid var(--accent-color);
      border-radius: 50%;
      z-index: 1;

      @media (max-width: 768px) {
        left: 15px;
        top: 5px;
      }
    }

    .date {
      width: 120px;
      text-align: right;
      font-size: 0.875rem;
      color: var(--text-muted);
      padding-top: 1.4rem;
      flex-shrink: 0;

      @media (max-width: 768px) {
        width: auto;
        text-align: left;
        padding-top: 0;
      }
    }

    .content {
      background: var(--bg-color);
      border: 1px solid var(--border-color);
      border-radius: 1rem;
      padding: 1.5rem;
      flex-grow: 1;

      .version {
        font-family: monospace;
        color: var(--accent-color);
        margin-bottom: 0.5rem;
      }

      h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      p {
        color: var(--text-muted);
        margin-bottom: 1rem;
        line-height: 1.6;
      }

      .tags {
        display: flex;
        gap: 0.5rem;

        .tag {
          font-size: 0.75rem;
          padding: 0.25rem 0.75rem;
          border-radius: 999px;
          background: var(--bg-surface);
          color: var(--text-muted);
          font-weight: 500;

          &.new {
            background: rgba(39, 201, 63, 0.1);
            color: #27c93f;
          }
          &.fix {
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
          }
          &.major {
            background: rgba(168, 85, 247, 0.1);
            color: #a855f7;
          }
        }
      }
    }
  }

  .action {
    text-align: center;

    .btn {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      border-radius: 0.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-color);

      &:hover {
        background: var(--bg-surface);
        border-color: var(--text-color);
      }
    }
  }
</style>
