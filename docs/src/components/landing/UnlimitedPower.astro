---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import AngularForm from '../../../public/template/code-samples/angular/my-golemui-form.component.ts?raw';
import ReactForm from '../../../public/template/code-samples/react/MyGolemUIForm.tsx?raw';
import LitForm from '../../../public/template/code-samples/lit/my-golemui-form.element.ts?raw';
---

<section class="custom-power">
  <div class="container">
    <div class="content">
      <h2>
        Unlimited <span class="gradient-text">Power</span>.<br />Made <span class="gradient-text"
          >Easy</span
        >.
      </h2>
      <p>GolemUI is the easiest and fastest library to build dynamic forms.</p>
    </div>
  </div>
  <div class="container-demo">
    <div class="home-examples">
      <Tabs>
        <TabItem label="Angular">
          <Code code={AngularForm} lang="ts" />
        </TabItem>
        <TabItem label="React">
          <Code code={ReactForm} lang="tsx" />
        </TabItem>
        <TabItem label="Lit">
          <Code code={LitForm} lang="ts" />
        </TabItem>
      </Tabs>
    </div>
    <div class="iframe-example">
      <iframe src="tiny/index.html" title="Custom components" width="100%" height="596px"></iframe>
    </div>
  </div>
</section>

<style lang="scss">
  iframe {
    border: none;
  }

  .iframe-example {
    width: 100%;
    height: 250px;

    @media (min-width: 50rem) {
      width: 50%;
      height: 596px;
    }
  }

  .home-examples {
    width: 100%;
    background-color: transparent;

    @media (min-width: 50rem) {
      width: 50%;
    }
  }

  .custom-power {
    padding: 4rem 0.25rem;
    background: var(--bg-color);
    overflow: hidden;

    @media (min-width: 361px) {
      padding: 4rem 1.5rem;
    }
  }

  .container-demo {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 20px;
    max-width: 1200px;
    margin: 0 auto;

    @media (min-width: 50rem) {
      flex-direction: row;
    }
  }

  .content {
    h2 {
      font-size: 2.5rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.5rem;

      @media (min-width: 768px) {
        font-size: 5rem;
      }
    }

    p {
      font-size: 1.25rem;
      color: var(--text-muted);
      margin-bottom: 3rem;
    }
  }

  iframe {
    border: 0;
  }

  html.dark {
    .home-examples {
      background-color: var(--ec-codeBg);
    }
  }
</style>
