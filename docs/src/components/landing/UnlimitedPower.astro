---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import AngularForm from '../../../public/template/code-samples/angular/my-golemui-form.component.ts?raw';
import ReactForm from '../../../public/template/code-samples/react/MyGolemUIForm.tsx?raw';
import LitForm from '../../../public/template/code-samples/lit/my-golemui-form.element.ts?raw';
---

<section class="custom-power">
  <div class="container">
    <div class="content">
      <h2>Unlimited <span class="gradient-text">Power</span>.<br />Made <span class="gradient-text">Easy</span>.</h2>
      <p>
        GolemUI is the easiest and fastest library to build dynamic forms.
      </p>
    </div>
  </div>
  <div class="container">
    <div class="home-examples">
      <Tabs>
        <TabItem label="Angular">
          <Code code={AngularForm} lang="ts" title="my-golemui-form.component.ts" />
        </TabItem>
        <TabItem label="React">
          <Code code={ReactForm} lang="tsx" title="MyGolemUIForm.tsx" />
        </TabItem>
        <TabItem label="Lit">
          <Code code={LitForm} lang="ts" title="my-golemui-form.element.ts" />
        </TabItem>
      </Tabs>
    </div>
    <div class="iframe-example">
      <iframe
        src="/template/index.html?form=home/form.json"
        title="Custom components"
        width="100%"
        height="571px"
      ></iframe>
    </div>
  </div>
</section>

<style lang="scss">
  iframe {
    border: none;
  }

  .iframe-example {
    width: 50%;
  }

  .home-examples {
    width: 50%;
  }

  .home-examples .expressive-code .frame pre {
    overflow-y: auto;
  }

  .custom-power {
    padding: 4rem 0;
    background: var(--bg-color);
    overflow: hidden;
  }

  .container {
    display: flex;
  }

  .content {
    h2 {
      font-size: 5rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.5rem;

      @media (max-width: 768px) {
        font-size: 2.5rem;
      }
    }

    p {
      font-size: 1.25rem;
      color: var(--text-muted);
      margin-bottom: 3rem;
    }
  }

  iframe {
    border: 0;
  }
</style>
