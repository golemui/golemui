---
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';
import ReactForm from '../../../public/template/code-samples/react/MyGolemUIForm.tsx?raw';

export const jsonDSL = `const authForm = golemForm().create({
  states: {
    registering: '$form.isRegistering === true',
  },
  form: [
    {
      kind: 'input',
      type: 'textinput',
      label: 'Email',
      path: 'email',
      validator: { type: 'string', required: true, format: 'email' },
    },
    {
      kind: 'input',
      type: 'toggle',
      label: 'Create an account?',
      path: 'isRegistering',
    },
    {
      kind: 'input',
      type: 'checkbox',
      label: 'Agree to terms',
      path: 'agree',
      include: { in: ['registering'] },
    },
    {
      kind: 'action',
      type: 'button',
      label: 'Sign In',
      'label.registering': 'Join Now',
      'disabled.registering': {
        when: '$form.isRegistering === true && $form.agree !== true',
      },
      on: { click: 'handleSubmit' },
    },
  ],
});`;
---

<section class="one-engine">
  <div class="container">
    <div class="content">
      <span class="section-label">Architecture</span>
      <h2>One <span class="gradient-text">Engine</span>.<br />Infinite <span class="gradient-text">Composability</span>.</h2>
      <p>
        GolemUI is built on a "Core-first" philosophy, allowing you to plug in your own implementation for every part of the library.
      </p>
    </div>
    <div class="visual">
      <ul class="visual-list">
        <li>
          <strong class="gradient-text">Bring Your Own Validation:</strong>
          <span>Seamlessly integrate <a href="https://zod.dev/" target="_blank">Zod</a>, <a href="https://valibot.dev/" target="_blank">Valibot</a>, or any library compliant with the <a href="https://standardschema.dev/" target="_blank">@standard-schema/spec</a>.</span>
        </li>
        <li>
          <strong class="gradient-text">Bring Your Own Components:</strong>
          <span>Extend our existing UI toolkit or build your own with minimal boilerplate. Simply map your components to one of our four core widget behaviors: <a href="components-reference/input-fields/overview/">input</a>, <a href="components-reference/action-fields/overview/">action</a>, <a href="components-reference/layout-fields/overview/">layout</a>, or <a href="components-reference/display-fields/overview/">display</a>.</span>
        </li>
        <li>
          <strong class="gradient-text">Bring Your Own i18n:</strong>
          <span>GolemUI is localization-agnostic by design. Implement our Translator interfaces to bridge your preferred library effortlessly.</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="container container-row">
    <div class="configuration">
      <Tabs>
        <TabItem label="Programmatic Configuration">
          <Code code={ReactForm} lang="tsx" />
        </TabItem>
        <TabItem label="JSON DSL Configuration">
          <Code code={jsonDSL} lang="ts" />
        </TabItem>
      </Tabs>
    </div>
    <div class="your-strategy">
      <h3>Your <span class="gradient-text">Strategy</span>.</h3>
      <p>
        Whether you prefer a programmatic API or the portability of a serializable JSON DSL, GolemUI adapts to your workflow.
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  a {
    color: var(--accent-color);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .visual {
    margin-bottom: 2rem;
  }

  .visual-list {
    font-size: 1.125rem;
    margin: 1.5rem 0;
    padding-left: 0;
    list-style: none;

    li {
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--border-color);
      line-height: 1.7;
      color: var(--text-muted);

      &:last-child {
        border-bottom: none;
      }

      strong {
        display: block;
        font-size: 1.25rem;
        margin-bottom: 0.375rem;
      }
    }

    @media (min-width: 768px) {
      font-size: 1.25rem;

      li strong {
        font-size: 1.375rem;
      }
    }
  }

  .one-engine {
    padding: 6rem 0;
    background: var(--bg-color);
    overflow: hidden;

    @media (min-width: 768px) {
      padding: 4rem 0;
    }
  }

  .container {
    display: flex;
    flex-direction: column;
  }

  .container-row {
    display: flex;
    flex-direction: column-reverse;

    @media (min-width: 50rem) {
      flex-direction: row;
      gap: 3rem;
    }
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.08;
    margin: 1.25rem 0;
    letter-spacing: -0.03em;

    @media (min-width: 768px) {
      font-size: 4.5rem;
    }
  }

  h3 {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 1.25rem 0;
    letter-spacing: -0.03em;

    @media (min-width: 768px) {
      font-size: 3.5rem;
    }
  }

  .content > p,
  .your-strategy > p {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    line-height: 1.7;

    @media (min-width: 768px) {
      font-size: 1.25rem;
    }
  }

  .your-strategy {
    flex: 4;
  }

  .configuration {
    flex: 5;
    overflow: hidden;
    border-radius: 16px;
    background-color: transparent;
    border: 1px solid var(--border-color);
  }

  iframe {
    border: none;
  }

  html.dark {
    .configuration {
      background-color: var(--ec-codeBg);
    }
  }
</style>
