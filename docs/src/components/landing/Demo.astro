---
interface Props {
  src: string;
  title?: string;
  minHeight?: string | number;
}

const { src, title = 'Component Demo', minHeight } = Astro.props;

let minHeightValue = (minHeight) ?? 0;
if (typeof minHeight === 'number') {
  minHeightValue = `${minHeight}px`;
} else if (typeof minHeight === 'string' && /^\d+$/.test(minHeight)) {
  minHeightValue = `${minHeight}px`;
}
---

<div class="demo-container">
  <iframe
    src={src}
    title={title}
    class="demo-iframe"
    loading="lazy"
    data-min-height={minHeightValue}
    style={`height: 0px; min-height: ${minHeightValue};`}></iframe>
</div>

<script>
  type StackId = 'react-rhf' | 'angular' | 'lit' | 'vue' | 'vanilla';
  type TemplateId = 'react' | 'angular' | 'lit' | 'vue' | 'js';

  const STACK_TO_TEMPLATE: Record<StackId, TemplateId> = {
    'react-rhf': 'react',
    angular: 'angular',
    lit: 'lit',
    vue: 'vue',
    vanilla: 'js',
  };

  const currentTheme = (): 'dark' | 'light' =>
    document.documentElement.classList.contains('dark') ? 'dark' : 'light';

  const currentFramework = (): TemplateId => {
    const versus = document.querySelector<HTMLElement>('.versus[data-stack]');
    const stack = (versus?.dataset['stack'] ?? 'lit') as StackId;
    return STACK_TO_TEMPLATE[stack] ?? 'lit';
  };

  const broadcastTheme = (target?: Window) => {
    const message = { type: 'golemui-theme', theme: currentTheme() };
    if (target) {
      target.postMessage(message, '*');
      return;
    }
    document.querySelectorAll<HTMLIFrameElement>('iframe.demo-iframe').forEach((iframe) => {
      iframe.contentWindow?.postMessage(message, '*');
    });
  };

  const broadcastFramework = (target?: Window) => {
    const message = { type: 'golemui-framework', framework: currentFramework() };
    if (target) {
      target.postMessage(message, '*');
      return;
    }
    document.querySelectorAll<HTMLIFrameElement>('iframe.demo-iframe').forEach((iframe) => {
      iframe.contentWindow?.postMessage(message, '*');
    });
  };

  document.querySelectorAll<HTMLIFrameElement>('iframe.demo-iframe').forEach((iframe) => {
    iframe.addEventListener('load', () => {
      broadcastTheme(iframe.contentWindow ?? undefined);
      broadcastFramework(iframe.contentWindow ?? undefined);
    });
  });

  window.addEventListener('message', (event) => {
    const type = (event.data as { type?: string } | null)?.type;
    if (type === 'golemui-theme-ready') {
      broadcastTheme((event.source as Window) ?? undefined);
      broadcastFramework((event.source as Window) ?? undefined);
    }
  });

  const themeObserver = new MutationObserver(() => broadcastTheme());
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class', 'data-theme'],
  });

  document.addEventListener('golemui:stack', () => broadcastFramework());
</script>

<style>
  .demo-container {
    width: 100%;
    border: 0;
    border-radius: 16px;
    overflow: hidden;
  }

  .demo-iframe {
    width: 100%;
    border: none;
    display: block;
    transition:
      height 0.3s ease-out,
      min-height 0.3s ease-out;
  }
</style>
