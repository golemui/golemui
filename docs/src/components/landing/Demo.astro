---
interface Props {
  src: string;
  title?: string;
}

const { src, title = "Component Demo" } = Astro.props;
// Ya no necesitamos generar un demoId manual para el script,
// el script identificará el iframe por su ventana de origen.
---

<div class="demo-container">
  <iframe
    src={src}
    title={title}
    class="demo-iframe"
    loading="lazy"
  ></iframe>
</div>

<style>
  .demo-container {
    width: 100%;
    border: 0;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .demo-iframe {
    width: 100%;
    height: 0;
    border: none;
    display: block;
    transition: height 0.2s ease-out;
  }
</style>
