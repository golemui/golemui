---
interface Props {
  src: string;
  title?: string;
  minHeight?: string | number;
}

const { src, title = 'Component Demo', minHeight } = Astro.props;

let minHeightValue = minHeight;
if (typeof minHeight === 'number') {
  minHeightValue = `${minHeight}px`;
} else if (typeof minHeight === 'string' && /^\d+$/.test(minHeight)) {
  minHeightValue = `${minHeight}px`;
}
---

<div class="demo-container">
  <iframe
    src={src}
    title={title}
    class="demo-iframe"
    loading="lazy"
    data-min-height={minHeightValue}
    style="height: 0px; min-height: 0px;"></iframe>
</div>

<style>
  .demo-container {
    width: 100%;
    border: 0;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .demo-iframe {
    width: 100%;
    border: none;
    display: block;
    transition:
      height 0.3s ease-out,
      min-height 0.3s ease-out;
  }
</style>
