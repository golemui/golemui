---
const metrics = [
  { label: 'Library Weight', value: 14.32, suffix: 'kb', sub: 'gzipped' },
  { label: 'LCP', value: 0.19, suffix: 'ms', sub: 'Largest Contentful Paint' },
  { label: 'Lighthouse', value: 100, suffix: '', sub: 'Perfect Score' }
];
---

<section class="metrics-section">
  <div class="container">
    <div class="content">
      <h2>Built for <span class="gradient-text">Speed</span></h2>
    </div>
  </div>
  <div class="metrics-grid">
    {metrics.map((metric) => (
      <div class="metric-card">
        <p class="metric-label">{metric.label}</p>
        <div class="metric-value-container">
          <span
            class="counter"
            data-target={metric.value}
            data-decimals={metric.value % 1 !== 0 ? 2 : 0}
          >0</span>
          <span class="suffix">{metric.suffix}</span>
        </div>
        <p class="metric-sub">{metric.sub}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .metrics-section {
    padding: 6rem 2rem;
    background: var(--bg-color);
  }

  .content {
    h2 {
      font-size: 4rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      text-align: center;

      @media (max-width: 768px) {
        font-size: 2.5rem;
      }
    }

    p {
      font-size: 1.25rem;
      color: var(--text-muted);
      margin-bottom: 3rem;
    }
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .metric-card {
    text-align: center;
    padding: 1.5rem;
  }

  .metric-label {
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    color: var(--text-color);
    margin-bottom: 0.5rem;
  }

  .metric-value-container {
    font-size: 3.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent-color) 0%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .suffix {
    font-size: 1.5rem;
    margin-left: 0.1rem;
  }

  .metric-sub {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-color);
  }

  @media (max-width: 640px) {
    .metric-value-container { font-size: 2.5rem; }
  }
</style>

<script>
  function animateValue(obj: Element, start: number, end: number, duration: number) {
    let startTimestamp: number | null = null;
    const decimals = parseInt((obj as HTMLElement).dataset.decimals ?? '') || 0;

    const step = (timestamp: number) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      const currentValue = progress * (end - start) + start;

      obj.innerHTML = currentValue.toFixed(decimals);

      if (progress < 1) {
        window.requestAnimationFrame(step);
      }
    };
    window.requestAnimationFrame(step);
  }

  const observerOptions = {
    threshold: 0.5
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const counters = entry.target.querySelectorAll('.counter');
        counters.forEach((counter: Element) => {
          const target = parseFloat(counter.getAttribute('data-target') ?? '');
          animateValue(counter, 0, target, 1500);
        });
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  const section = document.querySelector('.metrics-section');
  if (section) observer.observe(section);
</script>

