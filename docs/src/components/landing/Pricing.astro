---
---

<section class="pricing" id="pricing">
  <div class="container">
    <div class="header">
      <h2>Simple, Transparent Pricing</h2>
      <p class="subtitle">Start for free, scale when you need to.</p>
    </div>

    <div class="grid">
      <!-- Free Tier -->
      <div class="card free">
        <div class="card-header">
          <h3>Free</h3>
          <div class="price">$0<span>/mo</span></div>
          <p>Perfect for side projects and small apps.</p>
        </div>
        <div class="features">
          <ul>
            <li><span class="check">✓</span> 15+ Core Components</li>
            <li><span class="check">✓</span> Internationalization (i18n)</li>
            <li><span class="check">✓</span> WAI-ARIA Support</li>
            <li><span class="check">✓</span> Community Support</li>
          </ul>
        </div>
        <div class="action">
          <a href="/guides/getting-started" class="btn btn-outline">Start Free</a>
        </div>
      </div>

      <!-- Pro Tier -->
      <div class="card pro">
        <div class="badge">Most Popular</div>
        <div class="card-header">
          <h3>Pro</h3>
          <div class="price">$49<span>/mo</span></div>
          <p>For professional teams building data-heavy apps.</p>
        </div>
        <div class="features">
          <ul>
            <li><span class="check">✓</span> <strong>Everything in Free</strong></li>
            <li><span class="check">✓</span> 12+ Pro Components (Grid, Charts)</li>
            <li><span class="check">✓</span> Server-Side Rendering (SSR)</li>
            <li><span class="check">✓</span> Priority Feature Requests</li>
            <li><span class="check">✓</span> Basic Customer Support</li>
          </ul>
        </div>
        <div class="action">
          <a href="#" class="btn btn-primary">Upgrade to Pro</a>
        </div>
      </div>

      <!-- Enterprise Tier -->
      <div class="card enterprise">
        <div class="card-header">
          <h3>Enterprise</h3>
          <div class="price">Custom</div>
          <p>For large organizations with specific needs.</p>
        </div>
        <div class="features">
          <ul>
            <li><span class="check">✓</span> <strong>Everything in Pro</strong></li>
            <li><span class="check">✓</span> 24/7 Priority Support</li>
            <li><span class="check">✓</span> Custom SLA</li>
            <li><span class="check">✓</span> Dedicated Success Manager</li>
            <li><span class="check">✓</span> On-premise Deployment Options</li>
          </ul>
        </div>
        <div class="action">
          <a href="mailto:sales@golemui.com" class="btn btn-outline">Contact Sales</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .pricing {
    padding: 6rem 0;
    background: var(--bg-surface);
  }

  .header {
    text-align: center;
    margin-bottom: 4rem;

    h2 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .subtitle {
      font-size: 1.25rem;
      color: var(--text-muted);
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    align-items: start;
  }

  .card {
    background: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 2rem;
    position: relative;
    transition: transform 0.2s;

    &:hover {
      transform: translateY(-5px);
    }

    &.pro {
      border-color: var(--accent-color);
      box-shadow:
        0 0 0 1px var(--accent-color),
        0 20px 40px -10px rgba(var(--accent-color-rgb), 0.15);
      z-index: 1;
    }

    .badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent-color);
      color: white;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
    }

    .card-header {
      text-align: center;
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 2rem;

      h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      .price {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 0.5rem;

        span {
          font-size: 1rem;
          color: var(--text-muted);
          font-weight: 500;
        }
      }

      p {
        color: var(--text-muted);
        font-size: 0.875rem;
      }
    }

    .features {
      margin-bottom: 2rem;

      ul {
        list-style: none;
        padding: 0;
        margin: 0;

        li {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          margin-bottom: 1rem;
          font-size: 0.9375rem;
          color: var(--text-color);

          .check {
            color: var(--accent-color);
            font-weight: bold;
          }
        }
      }
    }

    .action {
      .btn {
        display: block;
        width: 100%;
        padding: 0.75rem;
        text-align: center;
        border-radius: 0.5rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;

        &.btn-primary {
          background: var(--accent-color);
          color: white;
          &:hover {
            filter: brightness(1.1);
          }
        }

        &.btn-outline {
          background: transparent;
          border: 1px solid var(--border-color);
          color: var(--text-color);
          &:hover {
            background: var(--bg-surface);
            border-color: var(--text-color);
          }
        }
      }
    }
  }
</style>
