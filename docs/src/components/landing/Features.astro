---

---

<section class="features">
  <div class="container">
    <div class="content">
      <span class="section-label">Features</span>
      <h2>Built-in <span class="gradient-text">Excellence</span>.</h2>
      <p>Native support for the features that matter most.</p>
    </div>
    <div class="bento-grid">
      <div class="bento-item i18n">
        <video src="/videos/i18n.mp4" autoplay loop muted playsinline></video>
        <div class="overlay overlay-i18n">
          <h3>Global by Design</h3>
          <p>Localize your forms with native-like performance in any language.</p>
        </div>
      </div>

      <div class="bento-item a11y">
        <video src="/videos/a11y.mp4" autoplay loop muted playsinline></video>
        <div class="overlay overlay-a11y">
          <h3>Accessible by Default</h3>
          <p>Exceed WCAG standards with fully compliant ARIA patterns built-in.</p>
        </div>
      </div>

      <div class="bento-item validations">
        <video src="/videos/validations.mp4" autoplay loop muted playsinline></video>
        <div class="overlay overlay-validations">
          <h3>Bulletproof Data</h3>
          <p>Smart, real-time validations driven by your JSON Schema.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    padding: 4rem 0;
    background: var(--bg-color);
  }

  @media (min-width: 768px) {
    .features {
      padding: 4rem 0;
    }
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 768px) {
    .container {
      padding: 0 2rem;
    }
  }

  .content h2 {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.08;
    margin: 1.25rem 0;
    letter-spacing: -0.03em;
  }

  @media (min-width: 768px) {
    .content h2 {
      font-size: 4.5rem;
    }
  }

  .content p {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .content p {
      font-size: 1.25rem;
    }
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 50rem) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bento-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bento-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
  }

  :global(html.dark) .bento-item:hover {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  video {
    width: 100%;
    display: block;
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    bottom: 0;
    padding: 1.5rem;
    color: white;
    width: 100%;
    box-sizing: border-box;
  }

  .overlay-i18n {
    background: linear-gradient(0deg, rgba(59, 130, 246, 0.92) 0%, rgba(139, 92, 246, 0.85) 100%);
  }

  .overlay-a11y {
    background: linear-gradient(0deg, rgba(59, 130, 246, 0.92) 0%, rgba(124, 58, 237, 0.85) 100%);
  }

  .overlay-validations {
    background: linear-gradient(0deg, rgba(59, 130, 246, 0.92) 0%, rgba(168, 85, 247, 0.85) 100%);
  }

  .overlay h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .overlay p {
    font-size: 0.875rem;
    opacity: 0.9;
    margin: 0.375rem 0 0;
    line-height: 1.5;
  }
</style>
