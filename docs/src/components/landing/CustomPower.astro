---
---

<section class="custom-power">
  <div class="container">
    <div class="content">
      <h2>Build Anything.<br />Create without limits.</h2>
      <p>
        Don't get locked into a rigid system. GolemUI gives you the low-level control you need to
        build custom requirements.
      </p>

      <div class="features">
        <div class="feature">
          <h3>Components</h3>
          <p>
            Build your own complex widgets that integrate seamlessly with the form state.
          </p>
        </div>
        <div class="feature">
          <h3>Middlewares</h3>
          <p>
            Intercept value changes, transform data, or trigger side effects with a powerful
            middleware pipeline.
          </p>
        </div>
        <div class="feature">
          <h3>Validators</h3>
          <p>
            Write complex async validators that run on the server or client with full type safety.
          </p>
        </div>
      </div>
    </div>
    <div class="visual">
      <div class="terminal">
        <div class="terminal-header">
          <span class="title">custom-validator.ts</span>
        </div>
        <pre><code>
export const uniqueUsername = async (value) =&gt; &lbrace;
  const exists = await api.checkUser(value);

  if (exists) &lbrace;
    return &lbrace;
      unique: 'Username is already taken'
    &rbrace;;
  &rbrace;

  return null;
&rbrace;;
        </code></pre>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .custom-power {
    padding: 8rem 0;
    background: var(--bg-color);
    overflow: hidden;
  }

  .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;

    @media (max-width: 960px) {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  .content {
    h2 {
      font-size: 3rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.5rem;

      @media (max-width: 768px) {
        font-size: 2.5rem;
      }
    }

    p {
      font-size: 1.25rem;
      color: var(--text-muted);
      margin-bottom: 3rem;
    }
  }

  .features {
    display: flex;
    flex-direction: column;
    gap: 2rem;

    .feature {
      h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-color);
      }

      p {
        font-size: 1rem;
        margin: 0;
      }
    }
  }

  .terminal {
    background: #1e1e1e;
    border-radius: 0.75rem;
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.5);
    border: 1px solid #333;
    overflow: hidden;

    .terminal-header {
      background: #2d2d2d;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid #333;

      .title {
        font-family: monospace;
        font-size: 0.875rem;
        color: #999;
      }
    }

    pre {
      margin: 0;
      padding: 1.5rem;
      font-family: 'Fira Code', monospace;
      font-size: 0.875rem;
      line-height: 1.5;
      color: #d4d4d4;
      overflow-x: auto;
    }
  }
</style>
