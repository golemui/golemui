---

<section class="frameworks">
  <div class="container">
    <div class="header">
      <h2>Write Once, Run Everywhere</h2>
      <p class="subtitle">Native support for the most popular enterprise frameworks.</p>
    </div>

    <div class="grid">
      <div class="framework-card angular">
        <div class="logo-placeholder"><svg _ngcontent-ng-c3804801859="" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 223 236" width="32" class="angular-logo"><g _ngcontent-ng-c3804801859="" clip-path="url(#a)"><path _ngcontent-ng-c3804801859="" fill="url(#b)" d="m222.077 39.192-8.019 125.923L137.387 0l84.69 39.192Zm-53.105 162.825-57.933 33.056-57.934-33.056 11.783-28.556h92.301l11.783 28.556ZM111.039 62.675l30.357 73.803H80.681l30.358-73.803ZM7.937 165.115 0 39.192 84.69 0 7.937 165.115Z"></path><path _ngcontent-ng-c3804801859="" fill="url(#c)" d="m222.077 39.192-8.019 125.923L137.387 0l84.69 39.192Zm-53.105 162.825-57.933 33.056-57.934-33.056 11.783-28.556h92.301l11.783 28.556ZM111.039 62.675l30.357 73.803H80.681l30.358-73.803ZM7.937 165.115 0 39.192 84.69 0 7.937 165.115Z"></path></g><defs _ngcontent-ng-c3804801859=""><linearGradient _ngcontent-ng-c3804801859="" id="b" x1="49.009" x2="225.829" y1="213.75" y2="129.722" gradientUnits="userSpaceOnUse"><stop _ngcontent-ng-c3804801859="" stop-color="#E40035"></stop><stop _ngcontent-ng-c3804801859="" offset=".24" stop-color="#F60A48"></stop><stop _ngcontent-ng-c3804801859="" offset=".352" stop-color="#F20755"></stop><stop _ngcontent-ng-c3804801859="" offset=".494" stop-color="#DC087D"></stop><stop _ngcontent-ng-c3804801859="" offset=".745" stop-color="#9717E7"></stop><stop _ngcontent-ng-c3804801859="" offset="1" stop-color="#6C00F5"></stop></linearGradient><linearGradient _ngcontent-ng-c3804801859="" id="c" x1="41.025" x2="156.741" y1="28.344" y2="160.344" gradientUnits="userSpaceOnUse"><stop _ngcontent-ng-c3804801859="" stop-color="#FF31D9"></stop><stop _ngcontent-ng-c3804801859="" offset="1" stop-color="#FF5BE1" stop-opacity="0"></stop></linearGradient><clipPath _ngcontent-ng-c3804801859="" id="a"><path _ngcontent-ng-c3804801859="" fill="#fff" d="M0 0h223v236H0z"></path></clipPath></defs></svg></div>
        <h3>Angular</h3>
        <p>
          Seamless integration with Angular's dependency injection and change detection. Full
          support for Signals and RxJS.
        </p>
      </div>

      <div class="framework-card react">
        <div class="logo-placeholder"><svg width="100%" height="100%" viewBox="-10.5 -9.45 21 18.9" fill="none" xmlns="http://www.w3.org/2000/svg" class="react-logo"><circle cx="0" cy="0" r="2" fill="currentColor"></circle><g stroke="currentColor" stroke-width="1" fill="none"><ellipse rx="10" ry="4.5"></ellipse><ellipse rx="10" ry="4.5" transform="rotate(60)"></ellipse><ellipse rx="10" ry="4.5" transform="rotate(120)"></ellipse></g></svg></div>
        <h3>React</h3>
        <p>
          First-class React hooks and components. Optimized for Concurrent Mode and Server
          Components.
        </p>
      </div>

      <div class="framework-card lit">
        <div class="logo-placeholder"><svg aria-label="Lit" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" id="full" class="lit-logo"><view id="flame" viewBox="-132.5 0 160 200"></view><symbol id="flame-symbol" viewBox="0 0 160 200"><path fill="var(--lit-logo-dark-cyan, #00e8ff)" d="M40 120l20-60l90 90l-30 50l-40-40h-20"></path><path fill="var(--lit-logo-dark-blue, #283198)" d="M80 160 L80 80 L120 40 L 120 120 M0 160 L40 200 L40 120 L20 120"></path><path fill="var(--lit-logo-blue, #324fff)" d="M40 120v-80l40-40v80M120 200v-80l40-40v80M0 160v-80l40 40"></path><path fill="var(--lit-logo-cyan, #0ff)" d="M40 200v-80l40 40"></path></symbol><use href="#flame-symbol" x="0"></use></svg></div>
        <h3>Lit</h3>
        <p>
          Lightweight Web Components that work anywhere. The foundation for a truly
          framework-agnostic design system.
        </p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .frameworks {
    padding: 6rem 0;
    background: var(--bg-color);
  }

  .header {
    text-align: center;
    margin-bottom: 4rem;

    h2 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .subtitle {
      font-size: 1.25rem;
      color: var(--text-muted);
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .framework-card {
    padding: 2rem;
    border-radius: 1rem;
    border: 1px solid var(--border-color);
    text-align: center;
    transition: all 0.2s;

    &:hover {
      border-color: var(--accent-color);
      background: rgba(var(--accent-color-rgb), 0.05);
    }

    .logo-placeholder {
      width: 64px;
      height: 64px;
      background: var(--bg-surface);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 800;
      margin: 0 auto 1.5rem;
      color: var(--text-color);

      svg {
        width: 40px;
        height: auto;
      }
    }

    &.angular .logo-placeholder {
      color: #dd0031;
    }
    &.react .logo-placeholder {
      color: #61dafb;
    }
    &.lit .logo-placeholder {
      color: #324fff;
    }

    h3 {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }

    p {
      color: var(--text-muted);
      line-height: 1.6;
    }
  }
</style>
