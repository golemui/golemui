---
---

<section class="hero">
  <div class="container">
    <div class="content">
      <h1 class="title">
        The <span class="gradient-text">Enterprise</span> Forms Library
      </h1>
    </div>
    <div class="example-container">
      <div class="visual">
        <iframe src="index.html" width="1024" height="897"></iframe>
      </div>
      <p class="subtitle">
        100% serializable, framework agnostic and AI ready. Built for enterprise teams who need performance, extensibility, and control.
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  iframe {
    border: none;
  }

  .hero {
    padding: 8rem 0 6rem;
    background: var(--bg-color);
    color: var(--text-color);
    overflow: hidden;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle at center, rgba(var(--accent-color-rgb), 0.15) 0%, transparent 50%);
      z-index: 0;
      pointer-events: none;
    }
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }

  .title {
    font-size: 7.5rem;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-align: center;

    @media (max-width: 768px) {
      font-size: 2.5rem;
    }
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    line-height: 1.6;
    text-align: center;
  }

  .cta-group {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;

    @media (max-width: 960px) {
      justify-content: center;
    }
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    font-size: 1rem;

    &.btn-primary {
      background: var(--accent-color);
      color: white;
      &:hover {
        filter: brightness(1.1);
        transform: translateY(-1px);
      }
    }

    &.btn-secondary {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-color);
      &:hover {
        background: var(--bg-surface);
        border-color: var(--text-color);
      }
    }
  }

  .frameworks {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.875rem;

    .framework-icons {
      display: flex;
      gap: 1rem;
      font-weight: 600;
      color: var(--text-color);
    }
  }

  .example-container {
    display: flex;
    justify-content: start;
    flex-direction: column;
    width: 100%;
    max-width: 1024px;
    height: 897px;
  }

  .visual {
    width: 100%;
    border-radius: 2.5rem;
    overflow: hidden;
    position: relative;

    .expressive-code {
      border-bottom: 1px solid #3b3e47;
    }
  }

  .angular-logo {
    width: 45px;
  }

  .react-logo {
    width: 45px;
    color: rgb(88 196 220 / 1);
  }

  .lit-logo {
    width: 45px;
  }
</style>
