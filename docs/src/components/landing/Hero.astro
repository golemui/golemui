---
import { Code } from 'astro:components';
import { stackTabs, golemui } from './paradigm-snippets';

const initialStack = stackTabs[0];

const formIframeSrc = import.meta.env.DEV
  ? 'http://localhost:4206/?form=/compare/signup.json'
  : '/template/index.html?form=/template/compare/signup.json';

const oobHighlights = [
  'Schema serialization (forms as JSON)',
  'A11y, keyboard, ARIA out of the box',
  'i18n adapter — bring your own library',
];
---

<section class="hero">
  <div class="container">
    <p class="hero-mark">Golem<span class="gradient-text">UI</span></p>
    <h1 class="title">
      The <span class="gradient-text">Declarative</span> Form Engine
    </h1>

    <ul class="frameworks" aria-label="Pick your framework" role="tablist" data-stack-pills>
      {stackTabs.map((s, i) => (
        <li>
          <button
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-pill={s.id}
            class={`framework framework--${s.pillIcon}${i === 0 ? ' is-active' : ''}`}
          >
            {s.pillIcon === 'react' && (
              <svg viewBox="-11.5 -10.232 23 20.463" width="20" height="20" fill="none" aria-hidden="true">
                <circle r="2.05" fill="currentColor"/>
                <g stroke="currentColor" stroke-width="1" fill="none">
                  <ellipse rx="11" ry="4.2"/>
                  <ellipse rx="11" ry="4.2" transform="rotate(60)"/>
                  <ellipse rx="11" ry="4.2" transform="rotate(120)"/>
                </g>
              </svg>
            )}
            {s.pillIcon === 'angular' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M12 0L1 4l1.7 14.5L12 24l9.3-5.5L23 4 12 0zm0 2.2L20.5 5.3 19 17.4 12 21.5 5 17.4 3.5 5.3 12 2.2zm0 2.6L7 16h2l1-2.5h4L15 16h2L12 4.8zm0 3.4L13.5 11h-3L12 7.8z"/>
              </svg>
            )}
            {s.pillIcon === 'lit' && (
              <svg viewBox="0 0 768 960" width="16" height="20" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
                <path d="M192 576l96-288 432 432-144 240-192-192h-96"/>
                <path d="M384 768V384l192-192v384m-480 0h96l96 192-96 192L0 768z"/>
                <path d="M192 576V192L384 0v384m192 576V576l192-192v384M0 768V384l192 192"/>
                <path d="M192 960V576l192 192"/>
              </svg>
            )}
            {s.pillIcon === 'js' && (
              <svg class="js-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <rect class="js-rect" width="24" height="24" rx="4" fill="currentColor"/>
                <text class="js-text" x="12" y="17" text-anchor="middle" font-family="ui-monospace, monospace" font-size="10" font-weight="800" fill="#0f172a">JS</text>
              </svg>
            )}
            {s.label}
          </button>
        </li>
      ))}
    </ul>

    <div class="versus" data-stack={initialStack.id}>
      <article class="col col-stack">
        <header class="col-head">
          <h3 class="col-title" data-stack-name>{initialStack.headerLabel}</h3>
        </header>

        <div class="col-body">
          <div class="metrics">
            <div class="metric">
              <span class="metric-value danger" data-stack-lines>{initialStack.lines}</span>
              <span class="metric-label">Lines</span>
            </div>
            <div class="metric">
              <span class="metric-value danger" data-stack-branches>{initialStack.branches}</span>
              <span class="metric-label">Branches</span>
            </div>
          </div>

          <ul class="oob-list" aria-label="Out-of-the-box features">
            {oobHighlights.map((feature) => (
              <li class="oob-item oob-no">
                <span class="oob-mark" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3l10 10M13 3L3 13"/>
                  </svg>
                </span>
                <span class="oob-label" set:html={feature.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              </li>
            ))}
          </ul>

          <button type="button" class="show-code-btn" data-show-code="stack">
            Show code
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </button>
        </div>
      </article>

      <div class="vs-cell" aria-hidden="true">
        <span class="vs-pill">vs</span>
      </div>

      <article class="col col-golem">
        <header class="col-head col-head-golem">
          <svg class="col-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 220" role="img" aria-label="GolemUI">
            <defs>
              <linearGradient id="col-golem-brand" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#3b82f6" />
                <stop offset="50%" stop-color="#8b5cf6" />
                <stop offset="100%" stop-color="#a855f7" />
              </linearGradient>
            </defs>
            <text x="200" y="170" font-family="Inter, system-ui, -apple-system, sans-serif" font-weight="600" font-size="160" text-anchor="middle" letter-spacing="-2">
              <tspan fill="url(#col-golem-brand)">{'{'}</tspan><tspan fill="currentColor">gui.</tspan><tspan fill="url(#col-golem-brand)">{'}'}</tspan>
            </text>
          </svg>
        </header>

        <div class="col-body">
          <div class="metrics">
            <div class="metric">
              <span class="metric-value brand">{golemui.lines}</span>
              <span class="metric-label">Lines</span>
            </div>
            <div class="metric">
              <span class="metric-value brand">{golemui.branches}</span>
              <span class="metric-label">Branches</span>
            </div>
          </div>

          <ul class="oob-list" aria-label="Out-of-the-box features">
            {oobHighlights.map((feature) => (
              <li class="oob-item oob-yes">
                <span class="oob-mark" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m3 8 3.5 3.5L13 5"/>
                  </svg>
                </span>
                <span class="oob-label" set:html={feature.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              </li>
            ))}
          </ul>
          <p class="oob-more oob-more-brand">…and more <span class="scroll-hint">(keep scrolling ↓)</span></p>

          <button type="button" class="show-code-btn show-code-brand" data-show-code="golemui">
            Show code
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </button>
        </div>
      </article>
    </div>

    <p class="compare-disclaimer">
      Numbers from a basic 9-field signup form rendered in each stack — same widgets, same conditionals, written idiomatically. Cross-field rules excluded (not first-class everywhere).
      <button type="button" class="form-link" data-form-modal>See the rendered form →</button>
    </p>

    <dialog class="spec-dialog" data-form-dialog>
      <div class="dialog-shell">
        <header class="dialog-head">
          <h3>The form we're comparing</h3>
          <button type="button" class="dialog-close" aria-label="Close" data-dialog-close>×</button>
        </header>
        <div class="dialog-body">
          <iframe
            src={formIframeSrc}
            title="The form we're comparing"
            class="form-iframe"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </dialog>

    <dialog class="code-dialog" data-code-dialog>
      <div class="dialog-shell">
        <header class="dialog-head">
          <h3 data-code-title>Source code</h3>
          <button type="button" class="dialog-close" aria-label="Close" data-code-close>×</button>
        </header>
        <div class="dialog-body code-dialog-body">
          {stackTabs.map((s) => (
            <div class="code-frame" data-code-frame={s.id} hidden>
              <Code code={s.code} lang={s.lang as any} theme="github-dark" />
            </div>
          ))}
          <div class="code-frame" data-code-frame="golemui" hidden>
            <Code code={golemui.code} lang={golemui.lang as any} theme="github-dark" />
          </div>
        </div>
      </div>
    </dialog>

    <div class="cta-group">
      <a href="/dx/getting-started/installation/" class="btn btn-primary">
        Get Started
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </a>
      <a href="https://github.com/golemui/golemui" class="btn btn-secondary" target="_blank">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        GitHub
      </a>
    </div>
  </div>
</section>

<script>
  type StackId = string;
  type Meta = { label: string; lines: number; branches: number };

  const meta: Record<StackId, Meta> = {
    'react-rhf': { label: 'React + React Hook Form', lines: 76, branches: 8 },
    'angular':   { label: 'Angular Signal Forms',    lines: 80, branches: 6 },
    'lit':       { label: 'Lit + Reactive Properties', lines: 93, branches: 8 },
    'vanilla':   { label: 'Vanilla JS',              lines: 86, branches: 9 },
  };

  const versus = document.querySelector<HTMLElement>('.versus');
  const pills = document.querySelectorAll<HTMLButtonElement>('[data-stack-pills] [data-pill]');
  const stackName = document.querySelector<HTMLElement>('[data-stack-name]');
  const stackLines = document.querySelector<HTMLElement>('[data-stack-lines]');
  const stackBranches = document.querySelector<HTMLElement>('[data-stack-branches]');

  if (versus) {
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const id = pill.dataset.pill ?? '';
        if (!meta[id]) return;

        pills.forEach((p) => {
          const active = p === pill;
          p.classList.toggle('is-active', active);
          p.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        if (stackName) stackName.textContent = meta[id].label;
        if (stackLines) stackLines.textContent = String(meta[id].lines);
        if (stackBranches) stackBranches.textContent = String(meta[id].branches);

        versus.setAttribute('data-stack', id);
        document.dispatchEvent(new CustomEvent('golemui:stack', { detail: { id } }));
      });
    });

    // Form dialog (iframe to rendered form)
    const formDialog = document.querySelector<HTMLDialogElement>('[data-form-dialog]');
    const formTrigger = document.querySelector<HTMLButtonElement>('[data-form-modal]');
    const formClose = document.querySelector<HTMLButtonElement>('[data-dialog-close]');
    if (formDialog && formTrigger) {
      formTrigger.addEventListener('click', () => formDialog.showModal());
    }
    if (formDialog && formClose) {
      formClose.addEventListener('click', () => formDialog.close());
    }
    if (formDialog) {
      formDialog.addEventListener('click', (e) => {
        if (e.target === formDialog) formDialog.close();
      });
    }

    // Code dialog
    const codeDialog = document.querySelector<HTMLDialogElement>('[data-code-dialog]');
    const codeTitle = document.querySelector<HTMLElement>('[data-code-title]');
    const codeClose = document.querySelector<HTMLButtonElement>('[data-code-close]');
    const codeFrames = document.querySelectorAll<HTMLElement>('[data-code-frame]');
    const showCodeBtns = document.querySelectorAll<HTMLButtonElement>('[data-show-code]');

    showCodeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const which = btn.dataset.showCode ?? '';
        const target =
          which === 'golemui'
            ? 'golemui'
            : (versus.dataset.stack ?? 'react-rhf');

        codeFrames.forEach((f) => {
          f.hidden = f.dataset.codeFrame !== target;
        });

        if (codeTitle) {
          codeTitle.textContent =
            target === 'golemui' ? 'GolemUI — source' : `${meta[target]?.label ?? target} — source`;
        }
        codeDialog?.showModal();
      });
    });

    if (codeDialog && codeClose) {
      codeClose.addEventListener('click', () => codeDialog.close());
    }
    if (codeDialog) {
      codeDialog.addEventListener('click', (e) => {
        if (e.target === codeDialog) codeDialog.close();
      });
    }
  }
</script>

<style lang="scss">
  .hero {
    padding: 5rem 0 1.5rem;
    background: var(--bg-color);
    color: var(--text-color);
    overflow: hidden;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: -30%;
      left: 50%;
      transform: translateX(-50%);
      width: 140%;
      height: 140%;
      background: radial-gradient(
        ellipse at center top,
        rgba(var(--accent-color-rgb), 0.08) 0%,
        rgba(168, 85, 247, 0.04) 30%,
        transparent 60%
      );
      z-index: 0;
      pointer-events: none;
    }
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
    gap: 1.25rem;
  }

  .hero-mark {
    margin: 0;
    font-size: 3rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--text-color);

    @media (min-width: 768px) { font-size: 4.5rem; }
    @media (min-width: 960px) { font-size: 6rem; }
  }

  .title {
    font-size: 2.5rem;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
    text-align: center;
    margin: 0;
    max-width: 800px;

    @media (min-width: 768px) { font-size: 3.5rem; }
    @media (min-width: 960px) { font-size: 4.5rem; }
  }

  .form-link {
    font: inherit;
    color: var(--accent-color);
    background: rgba(var(--accent-color-rgb), 0.08);
    border: 1px solid rgba(var(--accent-color-rgb), 0.25);
    padding: 0.05rem 0.4rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;

    &:hover {
      background: rgba(var(--accent-color-rgb), 0.16);
      color: var(--text-color);
    }
  }

  /* ---------- Pills ---------- */

  .frameworks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .framework {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    background: rgba(148, 163, 184, 0.05);
    border: 1px solid rgba(148, 163, 184, 0.18);
    color: var(--text-muted);
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s, border-color 0.2s, box-shadow 0.2s, color 0.2s;
    font-family: inherit;

    svg { flex: 0 0 auto; opacity: 0.7; transition: opacity 0.2s; }

    &:hover {
      transform: translateY(-1px);
      color: var(--text-color);
      svg { opacity: 1; }
    }

    &.is-active {
      transform: scale(1.06);
      color: white;
      svg { opacity: 1; }
    }

    &--react.is-active   { background: #61dafb; color: #0a1530; box-shadow: 0 0 0 4px rgba(97, 218, 251, 0.22), 0 8px 22px rgba(97, 218, 251, 0.35); }
    &--angular.is-active { background: #dd0031; box-shadow: 0 0 0 4px rgba(221, 0, 49, 0.22), 0 8px 22px rgba(221, 0, 49, 0.35); }
    &--lit.is-active     { background: #324fff; box-shadow: 0 0 0 4px rgba(50, 79, 255, 0.22), 0 8px 22px rgba(50, 79, 255, 0.35); }
    &--js.is-active      { background: #f7df1e; color: #0a1530; box-shadow: 0 0 0 4px rgba(247, 223, 30, 0.28), 0 8px 22px rgba(247, 223, 30, 0.4); }
  }

  /* JS icon: invert when active so the "JS" text stays readable */
  .framework--js.is-active .js-rect { fill: #0a1530; }
  .framework--js.is-active .js-text { fill: #f7df1e; }

  /* ---------- Versus block — compact, narrower ---------- */

  .versus {
    width: 100%;
    max-width: 880px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 0.875rem;

    @media (max-width: 880px) {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  /* Per-stack color tinting on the left column */
  .versus[data-stack="react-rhf"] { --stack-color: 97, 218, 251; }
  .versus[data-stack="angular"]   { --stack-color: 221, 0, 49; }
  .versus[data-stack="lit"]       { --stack-color: 50, 79, 255; }
  .versus[data-stack="vanilla"]   { --stack-color: 247, 223, 30; }

  .col {
    --col-bg: linear-gradient(180deg, var(--bg-color) 0%, var(--bg-surface) 100%);
    --col-head-bg: rgba(148, 163, 184, 0.08);
    position: relative;
    border-radius: 14px;
    background: var(--col-bg);
    border: 1px solid var(--border-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--text-color);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  :global(html.dark) .col {
    --col-bg: linear-gradient(180deg, #0b1020 0%, #050813 100%);
    --col-head-bg: rgba(2, 6, 23, 0.55);
  }

  /* Left card: receded, subtler chrome — visitor's current world */
  .col-stack {
    border-color: rgba(var(--stack-color, 148, 163, 184), 0.3);
    box-shadow:
      0 0 0 1px rgba(var(--stack-color, 148, 163, 184), 0.08),
      0 8px 22px -14px rgba(0, 0, 0, 0.18);
    opacity: 0.94;
  }

  /* Right card: lifted, brand glow — the destination */
  .col-golem {
    border-color: rgba(168, 85, 247, 0.5);
    box-shadow:
      0 0 0 1px rgba(168, 85, 247, 0.24),
      0 30px 70px -18px rgba(168, 85, 247, 0.35),
      0 12px 28px -12px rgba(59, 130, 246, 0.18);
  }

  .col-head {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.12);
    background: var(--col-head-bg);
    text-align: center;
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .col-stack .col-head {
    background: linear-gradient(180deg,
      rgba(var(--stack-color, 148, 163, 184), 0.16),
      var(--col-head-bg) 80%
    );
    border-bottom-color: rgba(var(--stack-color, 148, 163, 184), 0.25);
  }

  .col-golem .col-head {
    background: linear-gradient(180deg, rgba(168, 85, 247, 0.16), var(--col-head-bg) 80%);
    gap: 0.5rem;
  }


  .col-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;

    @media (min-width: 768px) { font-size: 1.25rem; }
  }

  .col-logo {
    height: 2rem;
    width: auto;
    display: block;

    @media (min-width: 768px) { height: 2.25rem; }
  }

  .col-body {
    flex: 1;
    padding: 1.25rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ---------- Metrics (Lines + Branches only) ---------- */

  .metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    align-items: end;
  }

  .metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
  }

  .metric-value {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;

    @media (min-width: 768px) { font-size: 2.5rem; }

    &.danger { color: #f87171; }

    &.brand {
      background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #a855f7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  }

  .metric-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- OOB list (3 highlights) ---------- */

  .oob-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .oob-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.875rem;
    line-height: 1.4;

    .oob-label code {
      font-family: 'Fira Code', ui-monospace, monospace;
      font-size: 0.875em;
      padding: 0.05em 0.3em;
      border-radius: 4px;
      background: rgba(148, 163, 184, 0.1);
      color: inherit;
    }
  }

  .oob-mark {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .oob-no {
    color: var(--text-muted);

    .oob-mark {
      background: rgba(248, 113, 113, 0.12);
      color: #f87171;
      border: 1px solid rgba(248, 113, 113, 0.3);
    }
  }

  .oob-yes {
    color: var(--text-color);

    .oob-mark {
      background: linear-gradient(135deg, #3b82f6, #a855f7);
      color: white;
      border: 1px solid rgba(168, 85, 247, 0.4);
      box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.12);
    }
  }

