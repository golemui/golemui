<section class="hero">
  <div class="container">
    <div class="content">
      <div class="badge">
        <span class="badge-text">New: GolemUI 2.0 is out!</span>
        <a href="/guides/getting-started" class="badge-link">Read the docs &rarr;</a>
      </div>
      <h1 class="title">
        The <span class="gradient-text">Ultra-Fast</span><br />
        Dynamic Forms Library
      </h1>
      <p class="subtitle">
        State-based, reactive, and 100% customizable. Built for enterprise teams who need performance, extensibility, and control.
      </p>
      <div class="cta-group">
        <a href="/guides/getting-started" class="btn btn-primary">Get Started Free</a>
        <a href="mailto:sales@golemui.com" class="btn btn-secondary">Request Enterprise Demo</a>
      </div>
      <div class="frameworks">
        <span>Works with:</span>
        <div class="framework-icons">
          <!-- Simple text placeholders for now, will replace with icons later -->
          <span class="framework">
            <a href="https://angular.dev" target="_blank">
