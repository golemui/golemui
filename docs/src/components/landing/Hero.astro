---
import Demo from './Demo.astro';
---

<section class="hero">
  <div class="container">
    <div class="content">
      <h1 class="title">
        The <span class="gradient-text">Enterprise</span> Forms Library
      </h1>
      <p class="subtitle">
        Open source forever, 100% serializable, framework agnostic and AI ready. Built for enterprise teams who need
        performance, extensibility, and control.
      </p>
      <div class="cta-group">
        <a href="/guides/getting-started" class="btn btn-primary">
          Get Started
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <a href="https://github.com/golemui/golemui" class="btn btn-secondary" target="_blank">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          GitHub
        </a>
      </div>
    </div>
    <div class="example-container">
      <div class="visual">
        <Demo src="/appetizer/index.html" minHeight="545" />
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  iframe {
    border: none;
  }

  .hero {
    padding: 9rem 0 5rem;
    background: var(--bg-color);
    color: var(--text-color);
    overflow: hidden;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: -30%;
      left: 50%;
      transform: translateX(-50%);
      width: 140%;
      height: 140%;
      background: radial-gradient(
        ellipse at center top,
        rgba(var(--accent-color-rgb), 0.08) 0%,
        rgba(168, 85, 247, 0.04) 30%,
        transparent 60%
      );
      z-index: 0;
      pointer-events: none;
    }
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    max-width: 800px;
    margin-bottom: 3.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent-color);
    background: rgba(var(--accent-color-rgb), 0.06);
    border: 1px solid rgba(var(--accent-color-rgb), 0.12);
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
    letter-spacing: 0.01em;
  }

  .title {
    font-size: 3rem;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
    text-align: center;
    margin: 1rem 0;

    @media (min-width: 768px) {
      font-size: 5rem;
    }

    @media (min-width: 960px) {
      font-size: 6rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-muted);
    line-height: 1.7;
    text-align: center;
    max-width: 580px;
    margin: 0;

    @media (min-width: 768px) {
      font-size: 1.25rem;
    }
  }

  .cta-group {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 0.9375rem;
    border: none;
    cursor: pointer;

    &.btn-primary {
      background: linear-gradient(135deg, var(--accent-color) 0%, #7c3aed 100%);
      color: white;
      box-shadow: 0 2px 8px rgba(var(--accent-color-rgb), 0.3);

      &:hover {
        box-shadow: 0 4px 16px rgba(var(--accent-color-rgb), 0.4);
        transform: translateY(-1px);
      }
    }

    &.btn-secondary {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      color: var(--text-color);

      &:hover {
        background: var(--border-color);
        transform: translateY(-1px);
      }
    }
  }

  .example-container {
    display: flex;
    align-items: center;
    justify-content: start;
    flex-direction: column;
    width: 100%;
    max-width: 1024px;
  }

  .visual {
    width: 100%;
    max-width: 1006px;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border-color);
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.05),
      0 20px 40px -4px rgba(0, 0, 0, 0.08);

    .expressive-code {
      border-bottom: 1px solid #3b3e47;
    }
  }

  html.dark .visual {
    border-color: var(--border-color);
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.2),
      0 20px 40px -4px rgba(0, 0, 0, 0.4);
  }
</style>
