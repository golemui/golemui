---
import Demo from './Demo.astro';

const demoSrc = import.meta.env.DEV
  ? 'http://localhost:4203/'
  : '/freedom/index.html';
---

<section class="freedom">
  <div class="container">
    <div class="content">
      <h2>
        A <span class="gradient-text">forms engine</span>, total <span class="gradient-text">freedom</span>.
      </h2>
      <p class="subtitle">
        Click any field's pill to swap its source — our built-ins, Material, Shoelace, or your own components. Because GolemUI is the engine, not a widget set, every field can come from anywhere: ship our defaults, drop in a third-party library, or wire up your own. Mix and match in the same form.
      </p>
    </div>
    <div class="visual">
      <Demo src={demoSrc} />
    </div>
  </div>
</section>

<style lang="scss">
  .freedom {
    padding: 1.5rem 0 4rem;
    overflow: hidden;
  }

  .container {
    display: flex;
    flex-direction: column;
  }

  .content {
    margin-bottom: 1.25rem;
  }

  .visual {
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }

  :global(html.dark) .visual {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  }

  h2 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.08;
    margin: 0 0 0.5rem;
    letter-spacing: -0.03em;

    @media (min-width: 768px) {
      font-size: 3rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
    max-width: 60rem;

    @media (min-width: 768px) {
      font-size: 1.25rem;
      line-height: 1.55;
    }
  }
</style>
