---
const cards = [
  {
    eyebrow: 'Persist',
    title: 'Save forms in a database.',
    body: 'Store form definitions in any data store. Version them. Diff them. Roll them back. The same way you treat content.',
  },
  {
    eyebrow: 'Ship',
    title: 'Serve forms from a CMS.',
    body: 'Marketers and ops teams can publish, update, and A/B test forms — no deploys, no engineering tickets.',
  },
  {
    eyebrow: 'Generate',
    title: 'Generate forms with an LLM.',
    body: 'Ask a model for a form schema and render it instantly. Auto-build flows from a prompt, a doc, or a database column list.',
  },
];
---

<section id="travel" class="travel-section">
  <div class="container">
    <div class="content">
      <h2>
        Your forms can <span class="gradient-text">live anywhere</span>.
      </h2>
      <p class="subtitle">
        Because the schema is data, not code, your form definition can travel where code can't. Most form libraries can't leave the codebase. GolemUI schemas can.
      </p>
    </div>

    <div class="cards-grid">
      {cards.map((card) => (
        <article class="card">
          <p class="eyebrow">{card.eyebrow}</p>
          <h3 class="card-title">{card.title}</h3>
          <p class="card-body">{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  .travel-section {
    padding: 1.5rem 0 4rem;
    overflow: hidden;
  }

  .container {
    display: flex;
    flex-direction: column;
  }

  .content {
    margin-bottom: 2rem;
  }

  h2 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.08;
    margin: 0 0 0.5rem;
    letter-spacing: -0.03em;

    @media (min-width: 768px) {
      font-size: 3rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
    max-width: 60rem;

    @media (min-width: 768px) {
      font-size: 1.25rem;
      line-height: 1.55;
    }
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;

    @media (min-width: 50rem) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    position: relative;
    padding: 2rem 1.75rem;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    background: var(--bg-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.3s ease;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6, #a855f7);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(59, 130, 246, 0.08);
    border-color: rgba(139, 92, 246, 0.25);
  }

  .card:hover::before {
    opacity: 1;
  }

  :global(html.dark) .card:hover {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
  }

  .eyebrow {
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.65rem;
    letter-spacing: -0.01em;
    color: var(--text-color);
    line-height: 1.25;
  }

  .card-body {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }
</style>
