---
import Demo from './Demo.astro';---

<section class="custom-power">
  <div class="container">
    <div class="content">
      <span class="section-label">Theming</span>
      <h2>Your <span class="gradient-text">Brand</span>.<br />Your <span class="gradient-text">Rules</span>.</h2>
      <p>
        Style GolemUI effortlessly using native CSS Variables. Quickly override our default tokens to match your brand or author a complete custom theme from scratch. Total design freedom, zero complexity.
      </p>
    </div>
    <div class="visual">
      <div>
        <Demo src="/theming/index.html" />
      </div>
    </div>
  </div>

  <div class="container container-row">
    <div class="material">
      <div>
        <iframe
          src="/material/index.html"
          title="Google Material"
          width="100%"
          height="260px"
        ></iframe>
      </div>
    </div>
    <div class="freedom">
      <h3>Total <span class="gradient-text">Freedom</span>.</h3>
      <p>
        Don't settle for the predefined. GolemUI is the agnostic engine that injects intelligence into any existing component library or even your own internal design system. Connect, render, and scale without limits using native web standards.
      </p>
    </div>
  </div>
</section>

<style lang="scss">
  a {
    color: var(--accent-color);
  }

  .visual {
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }

  html.dark .visual {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  }

  .custom-power {
    padding: 6rem 0;
    background: var(--bg-surface);
    overflow: hidden;

    @media (min-width: 768px) {
      padding: 4rem 0;
    }
  }

  .container {
    display: flex;
    flex-direction: column;
  }

  .custom-power .container-row {
    display: flex;
    flex-direction: column-reverse;

    @media (min-width: 50rem) {
      flex-direction: row;
      gap: 3rem;
      margin-top: 3rem;
    }
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.08;
    margin: 1.25rem 0;
    letter-spacing: -0.03em;

    @media (min-width: 768px) {
      font-size: 4.5rem;
    }
  }

  h3 {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 1.25rem 0;
    letter-spacing: -0.03em;

    @media (min-width: 768px) {
      font-size: 3.5rem;
    }
  }

  .content > p,
  .freedom > p {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    line-height: 1.7;

    @media (min-width: 768px) {
      font-size: 1.25rem;
    }
  }

  .freedom {
    flex: 3;
  }

  .material {
    flex: 2;
    height: 260px;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--border-color);
  }

  iframe {
    border: none;
  }
</style>
