---
import Demo from './Demo.astro';

const demoSrc = import.meta.env.DEV
  ? 'http://localhost:4205/'
  : '/theming/index.html';
---

<section class="theming">
  <div class="container">
    <div class="content">
      <h2>
        Your <span class="gradient-text">brand</span>. Your <span class="gradient-text">rules</span>.
      </h2>
      <p class="subtitle">
        Pick a theme and watch the form re-skin instantly. GolemUI ships sensible defaults — your brand layers on top by overriding native CSS variables, no rebuild, no compile step, no glue code. Author a complete custom theme or just nudge a token.
      </p>
    </div>
    <div class="visual">
      <Demo src={demoSrc} />
    </div>
  </div>
</section>

<style lang="scss">
  .theming {
    padding: 1.5rem 0 4rem;
    overflow: hidden;
  }

  .container {
    display: flex;
    flex-direction: column;
  }

  .content {
    margin-bottom: 1.25rem;
  }

  .visual {
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }

  :global(html.dark) .visual {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  }

  h2 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.08;
    margin: 0 0 0.5rem;
    letter-spacing: -0.03em;

    @media (min-width: 768px) {
      font-size: 3rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
    max-width: 60rem;

    @media (min-width: 768px) {
      font-size: 1.25rem;
      line-height: 1.55;
    }
  }
</style>
