---
---

<section class="custom-power">
  <div class="container">
    <div class="content">
      <h2>Your <span class="gradient-text">Brand</span>.<br />Your <span class="gradient-text">Rules</span>.</h2>
      <p>
        Style GolemUI effortlessly using native CSS Variables. Quickly override our default tokens to match your brand or author a complete custom theme from scratch. Total design freedom, zero complexity.
      </p>
    </div>
    <div class="visual">
      <div>
        <iframe
          src="/theming/index.html"
          title="Theming"
          width="100%"
          height="280px"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  a {
    color: var(--accent-color);
  }

  .custom-power {
    padding: 4rem 0;
    background: var(--bg-color);
    overflow: hidden;
  }

  .container {
    display: flex;
    flex-direction: column;

    @media (max-width: 960px) {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  .content {
    h2 {
      font-size: 5rem;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 1.5rem;

      @media (max-width: 768px) {
        font-size: 2.5rem;
      }
    }

    p {
      font-size: 1.25rem;
      color: var(--text-muted);
      margin-bottom: 3rem;
    }
  }

  .features {
    display: flex;
    flex-direction: column;
    gap: 2rem;

    .feature {
      h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-color);
      }

      p {
        font-size: 1rem;
        margin: 0;
      }
    }
  }

  iframe {
    border: none;
  }
</style>
