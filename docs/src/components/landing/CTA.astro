---
---

<section class="cta-section">
  <div class="cta-card">
    <div class="cta-content">
      <h2>Ready to Start Building?</h2>
      <p>
        Start creating smarter, faster, and fully accessible forms today. GolemUI provides the lightweight, open-source foundation your next enterprise project deserves.
      </p>
    </div>

    <div class="cta-buttons">
      <a href="/guides/getting-started" class="btn btn-docs">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Read the Docs
      </a>

      <a href="https://github.com/golemui/golemui" class="btn btn-github" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        View on GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 6rem 1.5rem;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .cta-section {
      padding: 8rem 2rem;
    }
  }

  .cta-card {
    background: linear-gradient(145deg, #3b82f6 0%, #7c3aed 50%, #a855f7 100%);
    padding: 4rem 2rem;
    border-radius: 20px;
    text-align: center;
    max-width: 900px;
    width: 100%;
    box-shadow:
      0 20px 40px rgba(59, 130, 246, 0.15),
      0 8px 16px rgba(124, 58, 237, 0.1);
    position: relative;
    overflow: hidden;
  }

  .cta-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(ellipse at 30% 0%, rgba(255, 255, 255, 0.12) 0%, transparent 60%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
  }

  .cta-content h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin: 1.25rem 0;
    line-height: 1.1;
    color: white;
    letter-spacing: -0.03em;
  }

  .cta-content p {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.88);
    max-width: 560px;
    margin: 0 auto 2.5rem auto;
    line-height: 1.7;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.75rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
  }

  .btn-docs {
    color: #0f172a;
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .btn-docs:hover {
    background: #f8fafc;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .btn-github {
    background: rgba(255, 255, 255, 0.12);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
  }

  .btn-github:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .cta-card { padding: 3rem 1.5rem; }
    .cta-buttons { flex-direction: column; }
    .btn { justify-content: center; }
  }
</style>
