---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';

interface Props {
  dxCode: string;
  jsonCode: string;
  dxTitle?: string;
  jsonTitle?: string;
  dxLang?: string;
  jsonLang?: string;
}

const { dxCode, jsonCode, dxTitle, jsonTitle, dxLang = 'ts', jsonLang = 'json' } = Astro.props;

const locale = Astro.locals.starlightRoute?.locale;
const isDx = locale === 'dx';
const isJson = locale === 'json';
const isDslRoute = isDx || isJson;
---

{
  isDslRoute ? (
    <>
      <div class:list={['dsl-slot', { 'dsl-hidden': !isDx }]}>
        <Code code={dxCode} lang={dxLang} title={dxTitle} />
      </div>
      <div class:list={['dsl-slot', { 'dsl-hidden': !isJson }]}>
        <Code code={jsonCode} lang={jsonLang} title={jsonTitle} />
      </div>
    </>
  ) : (
    <Tabs syncKey="dsl">
      <TabItem label="Programmatic">
        <Code code={dxCode} lang={dxLang} title={dxTitle} />
      </TabItem>
      <TabItem label="JSON">
        <Code code={jsonCode} lang={jsonLang} title={jsonTitle} />
      </TabItem>
    </Tabs>
  )
}

<style>
  .dsl-hidden {
    display: none !important;
  }
</style>
