---
import CTA from '../../components/landing/CTA.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const formsAsDataSrc = import.meta.env.DEV
  ? 'http://localhost:4220/'
  : '/sasha-demo/index.html';

const dxSrc = import.meta.env.DEV
  ? 'http://localhost:4221/'
  : '/rob-demo/index.html';

// The quests live in their own portal (extractable to quests.golemui.com).
const questPortal = import.meta.env.DEV
  ? 'http://localhost:4222'
  : 'https://quests.golemui.com';

// Five pillars, each a pain the visitor recognises. II + III are live demos;
// I, IV and V are "Coming soon" (no app yet — locked CTA + forging quest).
// The accent per pillar walks the brand gradient (blue → violet → magenta).
const PILLARS = [
  {
    num: 'I',
    accent: '#5b8cff',
    pain: 'My business users need to define their own forms.',
    title: 'Pillar I · Forms without code',
    blurb:
      '<strong>Studio</strong> is a form-authoring tool for the non-developers on your team. When your app needs the business to define its own forms, they build them in Studio — and they drop straight into GolemUI, live, with no handoff.',
    soon: true,
    quest: { line: 'A quest is being forged. Come back when Studio ships.' },
  },
  {
    num: 'II',
    accent: '#7d7cf5',
    pain: "I'm hand-coding form after form.",
    title: 'Pillar II · Forms compose',
    demo: 'forms-compose',
    open: true,
    blurb:
      'Real forms reuse the same fields, validators and logic. With GolemUI every one of those is just a <strong>block you compose once and reuse</strong> — plus third-party libraries and your own components wired in. No lock-in.',
    quest: {
      line: 'Survive <span class="boss">THE CLIENT</span> — whose requests never stop. A goofy little RPG that quietly teaches you composition.',
    },
  },
  {
    num: 'III',
    accent: '#9a6cff',
    pain: 'My server dictates the shape.',
    title: 'Pillar III · Forms as data',
    demo: 'forms-as-data',
    blurb:
      'When your server dictates the shape, just serialize it and send it to the UI — zero form code. Endpoints multiply and schemas mutate; the UI just keeps up.',
    quest: {
      line: 'Out-build <span class="boss">THE SERVER</span> — endpoints multiply, schemas mutate. A cheesy boss fight for forms-as-data.',
    },
  },
  {
    num: 'IV',
    accent: '#b566f0',
    pain: 'Good form components keep eating my sprints.',
    title: 'Pillar IV · Components out of the box',
    blurb:
      'Unbelievable components, out of the box. Comboboxes, date ranges, multi-step wizards, file dropzones, masked and rich inputs — designed, themeable and ready to go. Need something exotic? Drop in a third-party widget or your own component; they all speak {gui.}.',
    soon: true,
    quest: { line: 'A quest is being forged. Out-style THE DESIGNER — coming soon.' },
  },
  {
    num: 'V',
    accent: '#c861ec',
    pain: 'WCAG and a dozen locales are due at launch.',
    title: 'Pillar V · Enterprise-grade out of the box',
    blurb:
      "Enterprise-grade, on day one. Accessibility and internationalization aren't add-ons — every form ships WCAG-ready ARIA, full keyboard nav and screen-reader semantics, RTL, and locale-aware formatting, validation and translations. Nothing to bolt on later.",
    soon: true,
    quest: { line: 'A quest is being forged. Clear THE AUDITOR — coming soon.' },
  },
];

// The convergence rail: every pillar feeds the one {gui.} surface.
const MM_INPUTS = [
  { num: 'I', k: 'studio', accent: '#5b8cff', name: 'Forms without code', tag: 'author · soon' },
  { num: 'II', k: 'compose', accent: '#7d7cf5', name: 'Forms compose', tag: 'compose' },
  { num: 'III', k: 'data', accent: '#9a6cff', name: 'Forms as data', tag: 'serialize' },
  { num: 'IV', k: 'components', accent: '#b566f0', name: 'Components out of the box', tag: 'drop in · soon' },
  { num: 'V', k: 'enterprise', accent: '#c861ec', name: 'Enterprise-grade out of the box', tag: 'localize · soon' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GolemUI — Demos</title>
    <script is:inline>
      const setDarkMode = () => {
        const theme =
          typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
        if (
          theme === 'dark' ||
          (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
          document.documentElement.dataset.theme = 'dark';
        } else if (theme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.dataset.theme = 'light';
        } else {
          const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
        }
      };
      setDarkMode();
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', setDarkMode);
      // Deep-linked / returning from a quest (?demo= or ?open=)? Hide the
      // selector before first paint so it never flashes before the app opens.
      if (/[?&](demo|open)=/.test(location.search)) {
        document.documentElement.classList.add('deep-quest');
      }
    </script>
    <meta
      name="description"
      content="Try GolemUI for yourself — five live, runnable demos: forms-compose, forms-as-data, and more."
    />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fira+Code&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="landing-header">
      <div class="container">
        <a href="/" class="logo" aria-label="GolemUI home">
          <svg class="logo-lockup" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 220" role="img" aria-label="GolemUI">
            <defs>
              <linearGradient id="header-brand" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#3b82f6" />
                <stop offset="50%" stop-color="#8b5cf6" />
                <stop offset="100%" stop-color="#a855f7" />
              </linearGradient>
            </defs>
            <text x="200" y="170" font-family="Inter, system-ui, -apple-system, sans-serif" font-weight="600" font-size="160" text-anchor="middle" letter-spacing="-2">
              <tspan fill="url(#header-brand)">{'{'}</tspan><tspan fill="currentColor">gui.</tspan><tspan fill="url(#header-brand)">{'}'}</tspan>
            </text>
          </svg>
        </a>
        <nav class="pill-nav">
          <a href="/demos/" data-nav="demos" aria-current="page">Demos</a>
          <a href="/dx/getting-started/installation/">Docs</a>
          <a href="https://github.com/golemui/golemui" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- ── Selector: hero + five-pillar router + mix & match ───────── -->
      <div class="demos-select">
        <!-- Quest entry — same 8-bit banner the demos carry below their bar. -->
        <a class="quest-banner" href={questPortal} aria-label="Play the 8-bit quest">
          <span class="qb-tag">■ 8-bit quest</span>
          <span class="qb-text">
            Want the story? Every demo has a goofy little 8-bit RPG that quietly teaches the concept.
          </span>
          <span class="qb-btn">▶ Play the quest</span>
        </a>

        <section class="hero">
          <div class="wrap">
            <div class="hero-copy">
              <div class="section-kicker"><span class="tick"></span>Demos</div>
              <h1 class="hero-title">See it for yourself — <span class="grad-text">five live demos</span></h1>
              <p class="lead">
                Each demo is a small, runnable app built with GolemUI. Open one to try it live —
                or play its quest for the guided, hands-on story.
                <b>Whatever your form problem is, there’s a pillar for it</b> — and they combine.
              </p>
            </div>
          </div>
        </section>

        <section class="pillars-section">
          <div class="wrap">
            <div class="ra">
              <div class="rt-prompt">
                <span class="hb-q mono">Which problem is yours?</span>
                <span class="rt-prompt-hint">Open the one that sounds like your week.</span>
              </div>
              <div class="ra-rows">
                {PILLARS.map((p) => (
                  <div class:list={['ra-row', { upcoming: p.soon, open: p.open }]} style={`--accent: ${p.accent}`}>
                    <button class="ra-head" aria-expanded={p.open ? 'true' : 'false'}>
                      <span class="rt-num mono">{p.num}</span>
                      <span class="rt-headtext">
                        <span class="rt-pain">{p.pain}</span>
                        <span class="rt-title mono">{p.title}</span>
                      </span>
                      {p.soon && <span class="rt-soon mono">SOON</span>}
                      <span class="rt-chev" aria-hidden="true"><span></span><span></span></span>
                    </button>
                    <div class="ra-panel">
                      <div class="pd">
                        <p class="pd-body" set:html={p.blurb}></p>
                        {p.soon ? (
                          <span class="btn btn-disabled pd-cta">Coming soon</span>
                        ) : (
                          <button class="btn btn-primary pd-cta" data-demo={p.demo}>
                            Open the demo
                            <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                              <path d="M3 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                          </button>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section class="mm-section">
          <div class="wrap">
            <div class="mm-head">
              <div class="section-kicker"><span class="tick"></span>Not exclusive</div>
              <h2 class="mm-title">Most real apps <span class="grad-text">mix &amp; match</span> all five.</h2>
              <p class="lead">
                Every pillar feeds the same {'{gui.}'} surface — so whichever ones you reach for,
                they compose into a single form. Pick a mix; ship it.
              </p>
            </div>
            <div class="mm2">
              <div class="mm2-flow" data-hot="">
                <div class="mm2-inputs">
                  {MM_INPUTS.map((m) => (
                    <div class="mm2-input" data-k={m.k} style={`--a: ${m.accent}`}>
                      <span class="mm2-input-num mono">{m.num}</span>
                      <span class="mm2-input-txt"><b>{m.name}</b><em class="mono">{m.tag}</em></span>
                    </div>
                  ))}
                </div>
                <svg class="mm2-wires" viewBox="0 0 120 340" preserveAspectRatio="none" aria-hidden="true">
                  <path class="w-studio" d="M0,34 C72,34 52,170 120,170" fill="none" style="--a: #5b8cff"></path>
                  <path class="w-compose" d="M0,102 C72,102 56,170 120,170" fill="none" style="--a: #7d7cf5"></path>
                  <path class="w-data" d="M0,170 L120,170" fill="none" style="--a: #9a6cff"></path>
                  <path class="w-components" d="M0,238 C72,238 56,170 120,170" fill="none" style="--a: #b566f0"></path>
                  <path class="w-enterprise" d="M0,306 C72,306 52,170 120,170" fill="none" style="--a: #c861ec"></path>
                </svg>
                <div class="mm2-core">
                  <span class="mm2-core-mark mono">{'{gui.}'}</span>
                  <span class="mm2-core-sub mono">one surface</span>
                </div>
                <div class="mm2-tail" aria-hidden="true"><span class="mm2-tail-line"></span><span class="mm2-tail-tip"></span></div>
                <div class="mm2-result">
                  <span class="mm2-result-eyebrow mono">The result</span>
                  <span class="mm2-result-title">Every form problem,<br /><span class="grad-text">solved.</span></span>
                  <span class="mm2-result-sub">Pick any mix of the five. It composes into one form — and ships.</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Same "Ready to start building?" CTA as the homepage. -->
        <CTA />
      </div>

      <!-- ── App-direct host (hidden until a demo is opened) ─────────── -->
      <section class="demos-viewport" data-quest-portal={questPortal}>
        <div id="demo-pane-forms-as-data" role="tabpanel" class="demo-pane is-active">
          <iframe class="demo-iframe" data-base={formsAsDataSrc} title="Forms-as-data demo"></iframe>
        </div>
        <div id="demo-pane-forms-compose" role="tabpanel" class="demo-pane" hidden>
          <iframe class="demo-iframe" data-base={dxSrc} title="Forms-compose demo"></iframe>
        </div>
      </section>
    </main>

    <!-- Same footer as the homepage. Hidden while a demo is embedded. -->
    <SiteFooter />

    <script>
      type DemoId = 'forms-as-data' | 'forms-compose';

      const demoBtns = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.pd-cta[data-demo]'),
      );
      const panes = Array.from(document.querySelectorAll<HTMLElement>('.demo-pane'));
      const viewport = document.querySelector<HTMLElement>('.demos-viewport')!;
      const intro = document.querySelector<HTMLElement>('.demos-select');

      const questPortal = viewport.dataset['questPortal'] || '';
      let open: DemoId | null = null;

      function paneFor(demo: DemoId): HTMLElement | undefined {
        return panes.find((p) => p.id === `demo-pane-${demo}`);
      }
      function isDemoId(v: string | null): v is DemoId {
        return v === 'forms-as-data' || v === 'forms-compose';
      }

      // Open the runnable app inline under the header (app-direct).
      function openApp(demo: DemoId, push = true) {
        panes.forEach((p) => {
          const active = p.id === `demo-pane-${demo}`;
          p.toggleAttribute('hidden', !active);
          p.classList.toggle('is-active', active);
        });
        const iframe = paneFor(demo)?.querySelector<HTMLIFrameElement>('iframe.demo-iframe');
        if (iframe && !iframe.src) {
          const base = iframe.dataset['base'] || '';
          // Height is driven by the demo's golemui-resize messages (see below).
          iframe.src = `${base}?mode=bare&fw=react&n=${Date.now()}`;
          iframe.addEventListener(
            'load',
            () => {
              try {
                iframe.focus();
                iframe.contentWindow?.focus();
              } catch {
                /* cross-origin focus is best-effort */
              }
            },
            { once: true },
          );
        }
        open = demo;
        viewport.classList.add('is-embedded');
        intro?.classList.add('is-hidden');
        document.title = `GolemUI — ${demo === 'forms-as-data' ? 'Forms as data' : 'Forms compose'} demo`;
        if (push) history.pushState({ demo }, '', `?demo=${demo}`);
      }

      function backToSelect(push = true) {
        if (!open) return;
        open = null;
        // `deep-quest` was only a pre-paint hint to suppress the initial flash;
        // JS now owns visibility, so drop it or its CSS keeps the selector hidden.
        document.documentElement.classList.remove('deep-quest');
        viewport.classList.remove('is-embedded');
        intro?.classList.remove('is-hidden');
        panes.forEach((p) => {
          const iframe = p.querySelector<HTMLIFrameElement>('iframe.demo-iframe');
          if (iframe) iframe.removeAttribute('src');
        });
        document.title = 'GolemUI — Demos';
        if (push) history.pushState({}, '', location.pathname);
      }

      // "Open the demo" → embed the live app inline.
      demoBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const demo = btn.dataset['demo'] as DemoId | undefined;
          if (demo) openApp(demo);
        });
      });

      // Accordion — single row open at a time.
      const heads = Array.from(document.querySelectorAll<HTMLButtonElement>('.ra-head'));
      heads.forEach((h) => {
        h.addEventListener('click', () => {
          const row = h.closest('.ra-row');
          if (!row) return;
          const wasOpen = row.classList.contains('open');
          document.querySelectorAll<HTMLElement>('.ra-row.open').forEach((r) => {
            r.classList.remove('open');
            r.querySelector('.ra-head')?.setAttribute('aria-expanded', 'false');
          });
          if (!wasOpen) {
            row.classList.add('open');
            h.setAttribute('aria-expanded', 'true');
          }
        });
      });

      // Mix & match — light up the hovered pillar's wire into {gui.}.
      const flow = document.querySelector<HTMLElement>('.mm2-flow');
      document.querySelectorAll<HTMLElement>('.mm2-input').forEach((inp) => {
        inp.addEventListener('mouseenter', () => {
          if (flow) flow.dataset['hot'] = inp.dataset['k'] || '';
        });
        inp.addEventListener('mouseleave', () => {
          if (flow) flow.dataset['hot'] = '';
        });
      });

      // The header "Demos" pill returns to the selector without a full reload.
      document.querySelector<HTMLAnchorElement>('nav a[data-nav="demos"]')?.addEventListener(
        'click',
        (e) => {
          if (open) {
            e.preventDefault();
            backToSelect();
          }
        },
      );

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') backToSelect();
      });

      // Browser back/forward: reflect ?demo= so every state has a real URL.
      window.addEventListener('popstate', () => {
        const demo = new URLSearchParams(location.search).get('demo');
        if (isDemoId(demo)) openApp(demo, false);
        else backToSelect(false);
      });

      // Messages from the embedded app — only trust our own demo iframes, never
      // an arbitrary frame (the demos can host third-party widgets).
      const demoWindows = () =>
        Array.from(document.querySelectorAll<HTMLIFrameElement>('iframe.demo-iframe')).map(
          (f) => f.contentWindow,
        );
      window.addEventListener('message', (event) => {
        if (!demoWindows().includes(event.source as Window)) return;
        const data = event.data as { type?: string; height?: number } | null;
        if (data?.type === 'golemui-resize' && typeof data.height === 'number') {
          // Grow the reporting iframe to its content height so the page scrolls
          // as one (no nested scrollbar inside the demo).
          const iframe = Array.from(
            document.querySelectorAll<HTMLIFrameElement>('iframe.demo-iframe'),
          ).find((f) => f.contentWindow === event.source);
          if (iframe) iframe.style.height = `${data.height}px`;
        } else if (data?.type === 'golemui-demo-exit') backToSelect();
        else if (data?.type === 'golemui-play-quest') {
          const id = panes.find(
            (p) =>
              p.querySelector<HTMLIFrameElement>('iframe.demo-iframe')?.contentWindow ===
              event.source,
          )?.id?.replace('demo-pane-', '');
          if (isDemoId(id ?? null) && questPortal) {
            location.href = `${questPortal}/?demo=${id}&fw=react&from=app`;
          }
        } else if (data?.type === 'golemui-theme-ready')
          broadcastTheme((event.source as Window) ?? undefined);
      });

      // Theme broadcast to the embedded app.
      const currentTheme = (): 'dark' | 'light' =>
        document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      function broadcastTheme(target?: Window) {
        const msg = { type: 'golemui-theme', theme: currentTheme() };
        if (target) {
          target.postMessage(msg, '*');
          return;
        }
        document
          .querySelectorAll<HTMLIFrameElement>('iframe.demo-iframe')
          .forEach((iframe) => iframe.contentWindow?.postMessage(msg, '*'));
      }
      document.querySelectorAll<HTMLIFrameElement>('iframe.demo-iframe').forEach((iframe) => {
        iframe.addEventListener('load', () => broadcastTheme(iframe.contentWindow ?? undefined));
      });
      const themeObserver = new MutationObserver(() => broadcastTheme());
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class', 'data-theme'],
      });

      // Deep link / quest return: ?demo=<id> or ?open=<id> → open that app.
      const params = new URLSearchParams(location.search);
      const deepLink = params.get('demo') ?? params.get('open');
      if (isDemoId(deepLink)) {
        // Seed a selector entry *beneath* the deep-linked app so Back returns
        // to the selector (e.g. after a quest hand-back) instead of leaving the site.
        history.replaceState({}, '', location.pathname);
        history.pushState({ demo: deepLink }, '', `?demo=${deepLink}`);
        openApp(deepLink, false);
      } else {
        // Malformed ?demo=/?open= — the pre-paint hint hid the selector; nothing
        // opened, so restore it rather than leave a blank page.
        document.documentElement.classList.remove('deep-quest');
      }
    </script>

    <style lang="scss" is:global>
      /* ── Theme tokens ─────────────────────────────────────────────── */
      :root {
        /* header tokens */
        --bg-color: #ffffff;
        --text-color: #0f172a;
        --text-muted: #64748b;

        /* brand gradient = the pillars */
        --p1: #5b8cff;
        --p2: #9a6cff;
        --p3: #c861ec;
        --grad: linear-gradient(100deg, var(--p1) 0%, var(--p2) 50%, var(--p3) 100%);

        --radius: 16px;
        --radius-sm: 10px;
        --radius-lg: 24px;
        --maxw: 1200px;
        --gutter: clamp(20px, 4vw, 56px);
        --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'Fira Code', ui-monospace, 'SF Mono', Menlo, monospace;
        --font-pixel: 'Press Start 2P', 'Fira Code', monospace;

        /* surfaces — light */
        --surface: #ffffff;
        --surface-2: #fbfbfe;
        --surface-3: #f0f0f6;
        --border: rgba(15, 18, 40, 0.1);
        --border-strong: rgba(15, 18, 40, 0.18);
        --text: #14141c;
        --text-2: #54546a;
        --text-3: #8a8a9e;
        --shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 22px 50px -28px rgba(40, 30, 90, 0.28);
        --shadow-sm: 0 1px 0 rgba(255, 255, 255, 0.7) inset, 0 10px 24px -16px rgba(40, 30, 90, 0.22);
        --crt-bg: #1a1330;
        --crt-ink: #e6dcff;
        --bg-grad-tint: radial-gradient(1100px 650px at 80% -10%, #d9d3ff 0%, #f6f6fa00 55%),
          radial-gradient(800px 560px at -2% 0%, #cfe0ff 0%, #f6f6fa00 50%);
      }
      html.dark {
        --bg-color: #08080c;
        --text-color: #f1f5f9;
        --text-muted: #94a3b8;

        /* surfaces — dark */
        --surface: #0f0f17;
        --surface-2: #14141f;
        --surface-3: #1a1a27;
        --border: rgba(255, 255, 255, 0.09);
        --border-strong: rgba(255, 255, 255, 0.16);
        --text: #f3f3f7;
        --text-2: #a6a6b8;
        --text-3: #6e6e84;
        --shadow: 0 1px 0 rgba(255, 255, 255, 0.03) inset, 0 24px 60px -24px rgba(0, 0, 0, 0.7);
        --shadow-sm: 0 1px 0 rgba(255, 255, 255, 0.04) inset, 0 8px 24px -12px rgba(0, 0, 0, 0.6);
        --crt-bg: #0c0814;
        --crt-ink: #d9c8ff;
        --bg-grad-tint: radial-gradient(1200px 700px at 78% -8%, #2a1f57 0%, #14122400 55%),
          radial-gradient(900px 600px at 0% 0%, #122046 0%, #0a0c1800 50%);
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        background: var(--bg-color);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        line-height: 1.5;
        overflow-x: hidden;
        transition: background-color 0.4s ease, color 0.4s ease;
      }
      /* ambient brand tint behind the content */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background: var(--bg-grad-tint);
        pointer-events: none;
        z-index: 0;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      .wrap {
        max-width: var(--maxw);
        margin: 0 auto;
        padding-inline: var(--gutter);
      }
      .mono {
        font-family: var(--font-mono);
      }
      .grad-text {
        background: var(--grad);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      ::selection {
        background: #9a6cff55;
      }

      /* ── Header (unchanged) ───────────────────────────────────────── */
      .landing-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border-bottom: 1px solid rgba(226, 232, 240, 0.6);

        .container {
          display: flex;
          justify-content: space-between;
          align-items: center;
          height: 4rem;
        }
        .logo {
          display: inline-flex;
          align-items: center;
          text-decoration: none;
          color: var(--text-color);
          .logo-lockup {
            height: 36px;
            width: auto;
            display: block;
          }
        }
        nav.pill-nav {
          display: flex;
          align-items: center;
          gap: 0.35rem;
          padding: 0.25rem;
          background: rgba(148, 163, 184, 0.1);
          border-radius: 999px;
          a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9375rem;
            line-height: 1;
            padding: 0.45rem 0.95rem;
            border-radius: 999px;
            transition: color 0.2s, background 0.2s, box-shadow 0.2s;
            &:hover {
              color: var(--text-color);
            }
            &[aria-current='page'] {
              color: #fff;
              background: linear-gradient(135deg, #3b82f6, #8b5cf6);
              box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
            }
          }
        }
      }
      html.dark .landing-header {
        background: rgba(8, 8, 12, 0.72);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      /* ── Page scaffold ────────────────────────────────────────────── */
      main {
        position: relative;
        z-index: 1;
        box-sizing: border-box;
        padding-top: 4rem;
        min-height: 100vh;
        background: transparent;
      }
      .demos-select.is-hidden {
        display: none;
      }
      html.deep-quest .demos-select {
        display: none;
      }

      section {
        position: relative;
      }
      .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 18px;
      }
      .section-kicker .tick {
        width: 22px;
        height: 1px;
        background: var(--border-strong);
      }
      /* Match the home hero titles: 800 weight, tight tracking. */
      h1.hero-title {
        font-size: clamp(2rem, 3.6vw, 3rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
        font-weight: 800;
        margin: 0 0 1.1rem;
      }
      .lead {
        font-size: clamp(17px, 1.5vw, 20px);
        color: var(--text-2);
        max-width: 52rem;
        margin: 0;
        text-wrap: pretty;
      }
      .lead b {
        color: var(--text);
        font-weight: 600;
      }

      /* ── Hero ─────────────────────────────────────────────────────── */
      .hero {
        padding-top: 2.25rem;
        padding-bottom: 1.5rem;
      }
      .hero-copy {
        max-width: 56rem;
      }

      /* ── Five-pillar accordion ────────────────────────────────────── */
      .pillars-section {
        padding-bottom: clamp(40px, 6vw, 72px);
      }
      .ra {
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .rt-prompt {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
      }
      .hb-q {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-3);
      }
      .rt-prompt-hint {
        font-size: 14px;
        color: var(--text-3);
      }
      .ra-rows {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .ra-row {
        --accent: var(--p2);
        border: 1px solid var(--border);
        border-left: 3px solid color-mix(in srgb, var(--accent) 45%, var(--border));
        border-radius: 16px;
        background: var(--surface);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        transition: border-color 0.25s var(--ease), box-shadow 0.3s var(--ease), background 0.25s var(--ease);
      }
      .ra-row.open {
        border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
        border-left-color: var(--accent);
        background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 7%, transparent), transparent 32%), var(--surface);
        box-shadow: var(--shadow), 0 0 44px -22px color-mix(in srgb, var(--accent) 85%, transparent);
      }
      .ra-row:not(.open):hover {
        border-left-color: var(--accent);
      }
      .ra-head {
        width: 100%;
        text-align: left;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 22px;
        background: transparent;
        border: none;
        color: var(--text);
        cursor: pointer;
      }
      .rt-num {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        flex: none;
        border-radius: 9px;
        font-size: 15px;
        font-weight: 600;
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent) 36%, transparent);
      }
      .ra-row.open .rt-num {
        color: #fff;
        background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 92%, #fff), var(--accent));
        border-color: transparent;
        box-shadow: 0 8px 18px -8px color-mix(in srgb, var(--accent) 90%, transparent);
      }
      .rt-headtext {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
        flex: 1;
      }
      .rt-pain {
        font-size: clamp(16px, 1.7vw, 19px);
        font-weight: 600;
        letter-spacing: -0.015em;
        color: var(--text);
      }
      .rt-title {
        font-size: 11.5px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--accent) 78%, var(--text-3));
      }
      .rt-soon {
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.12em;
        color: var(--p1);
        padding: 2px 6px;
        border-radius: 5px;
        flex: none;
        background: color-mix(in srgb, var(--p1) 14%, transparent);
        border: 1px solid color-mix(in srgb, var(--p1) 34%, transparent);
      }
      .rt-chev {
        position: relative;
        width: 22px;
        height: 22px;
        flex: none;
      }
      .rt-chev span {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 13px;
        height: 2px;
        border-radius: 2px;
        background: var(--text-2);
        transition: transform 0.3s var(--ease);
        transform: translate(-50%, -50%);
      }
      .rt-chev span:nth-child(2) {
        transform: translate(-50%, -50%) rotate(90deg);
      }
      .open .rt-chev span:nth-child(2) {
        transform: translate(-50%, -50%) rotate(0deg);
      }
      .open .rt-chev span {
        background: var(--accent);
      }
      .ra-panel {
        display: none;
        padding: 0 22px 22px 74px;
      }
      .ra-row.open .ra-panel {
        display: block;
        animation: revealUp 0.4s var(--ease-out);
      }
      @keyframes revealUp {
        from {
          opacity: 0.35;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .ra-row.open .ra-panel {
          animation: none;
        }
      }

      /* unfolded pillar detail — blurb on the left, the CTA pinned right */
      .pd {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 26px;
      }
      .pd-body {
        font-size: 15.5px;
        line-height: 1.62;
        color: var(--text-2);
        margin: 0;
        text-wrap: pretty;
        max-width: 54ch;
      }
      .pd-body b,
      .pd-body strong {
        color: var(--text);
        font-weight: 600;
      }
      .pd-cta {
        flex: 0 0 auto;
        padding-inline: 24px;
      }
      @media (max-width: 760px) {
        .pd {
          flex-direction: column;
          align-items: stretch;
          gap: 18px;
        }
        .pd-cta {
          width: 100%;
        }
        .ra-panel {
          padding: 0 20px 20px;
        }
        .ra-head {
          padding: 18px;
          gap: 13px;
        }
      }

      /* ── Buttons ──────────────────────────────────────────────────── */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px 18px;
        border-radius: var(--radius-sm);
        font-size: 15px;
        font-weight: 600;
        white-space: nowrap;
        border: 1px solid transparent;
        cursor: pointer;
        transition: transform 0.15s var(--ease), box-shadow 0.25s var(--ease), background 0.25s var(--ease);
      }
      .btn-primary {
        color: #fff;
        background: var(--grad);
        background-size: 140% 140%;
        box-shadow: 0 10px 26px -12px #6f6cffaa, 0 1px 0 rgba(255, 255, 255, 0.18) inset;
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        background-position: 100% 0;
        box-shadow: 0 16px 34px -12px #6f6cffcc, 0 1px 0 rgba(255, 255, 255, 0.22) inset;
      }
      .btn-primary .arrow {
        transition: transform 0.25s var(--ease);
      }
      .btn-primary:hover .arrow {
        transform: translateX(3px);
      }
      .btn-disabled {
        color: var(--text-3);
        background: var(--surface-2);
        border-color: var(--border);
        cursor: not-allowed;
      }

      /* ── Quest banner — the same 8-bit strip the demos carry below their
         bar, for a consistent quest entry across the product. ─────────── */
      .quest-banner {
        --quest-violet: 124, 58, 237;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.6rem 1rem;
        padding: 0.85rem 1.25rem;
        text-decoration: none;
        background: rgba(var(--quest-violet), 0.06);
        border-bottom: 1px solid rgba(var(--quest-violet), 0.22);
        overflow: hidden;
      }
      .quest-banner::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: repeating-linear-gradient(
          to bottom,
          rgba(var(--quest-violet), 0.06) 0,
          rgba(var(--quest-violet), 0.06) 1px,
          transparent 1px,
          transparent 3px
        );
        opacity: 0.6;
      }
      .quest-banner > * {
        position: relative;
      }
      .qb-tag {
        font-family: var(--font-pixel);
        font-size: 0.58rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: rgb(var(--quest-violet));
        text-shadow: 0 0 8px rgba(var(--quest-violet), 0.5);
      }
      .qb-text {
        font-size: 0.9rem;
        color: var(--text-2);
      }
      .qb-btn {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-pixel);
        font-size: 0.6rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: #1a0b2e;
        background: linear-gradient(180deg, #b89dff 0%, #9a6cff 58%, #8a5cf0 100%);
        border: 1px solid #6a4cff;
        border-radius: 6px;
        padding: 0.55rem 0.8rem;
        box-shadow: 0 3px 0 #3a1f8c, 0 0 18px rgba(var(--quest-violet), 0.28);
        transition: transform 0.12s, box-shadow 0.12s, filter 0.12s;
      }
      .quest-banner:hover .qb-btn {
        transform: translateY(-1px);
        filter: brightness(1.05);
        box-shadow: 0 4px 0 #3a1f8c, 0 0 24px rgba(var(--quest-violet), 0.42);
      }
      .quest-banner:active .qb-btn {
        transform: translateY(2px);
        box-shadow: 0 1px 0 #3a1f8c, 0 0 12px rgba(var(--quest-violet), 0.3);
      }
      html.dark .quest-banner {
        --quest-violet: 154, 108, 255;
      }

      /* ── Mix & match → converge into {gui.} ───────────────────────── */
      .mm-section {
        padding: clamp(56px, 8vw, 96px) 0 clamp(64px, 9vw, 108px);
        margin-top: clamp(16px, 3vw, 28px);
        border-top: 1px solid var(--border);
      }
      .mm-head {
        max-width: 760px;
        margin-bottom: 30px;
      }
      .mm-title {
        font-size: clamp(28px, 4vw, 46px);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.05;
        margin: 0 0 16px;
        color: var(--text);
      }
      .mm2 {
        display: flex;
        flex-direction: column;
        gap: 26px;
      }
      .mm2-flow {
        display: grid;
        grid-template-columns: minmax(200px, 1fr) 88px auto 76px minmax(210px, 1.05fr);
        align-items: center;
        padding: 14px 10px;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: radial-gradient(80% 120% at 50% 50%, color-mix(in srgb, var(--p2) 9%, transparent), transparent 70%), var(--surface);
        box-shadow: var(--shadow);
      }
      .mm2-inputs {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 12px 14px;
      }
      .mm2-input {
        --a: var(--p2);
        text-align: left;
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 56px;
        padding: 11px 13px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--a) 7%, var(--surface));
        border: 1px solid color-mix(in srgb, var(--a) 34%, var(--border));
        transition: all 0.22s var(--ease);
      }
      .mm2-input-num {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        flex: none;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        color: #fff;
        background: linear-gradient(180deg, color-mix(in srgb, var(--a) 92%, #fff), var(--a));
        box-shadow: 0 6px 14px -6px color-mix(in srgb, var(--a) 90%, transparent);
      }
      .mm2-input-txt {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
      }
      .mm2-input-txt b {
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
        line-height: 1.2;
      }
      .mm2-input-txt em {
        font-style: normal;
        font-size: 10.5px;
        color: var(--text-3);
        letter-spacing: 0.02em;
      }
      .mm2-input:hover {
        border-color: var(--a);
        box-shadow: 0 14px 30px -18px color-mix(in srgb, var(--a) 90%, transparent);
        transform: translateX(3px);
      }
      .mm2-wires {
        width: 88px;
        height: 336px;
      }
      .mm2-wires path {
        stroke: var(--a);
        stroke-width: 2;
        stroke-opacity: 0.5;
        transition: stroke-opacity 0.2s var(--ease), stroke-width 0.2s var(--ease);
      }
      .mm2-flow[data-hot]:not([data-hot='']) .mm2-wires path {
        stroke-opacity: 0.12;
      }
      .mm2-flow[data-hot='studio'] .w-studio,
      .mm2-flow[data-hot='compose'] .w-compose,
      .mm2-flow[data-hot='data'] .w-data,
      .mm2-flow[data-hot='components'] .w-components,
      .mm2-flow[data-hot='enterprise'] .w-enterprise {
        stroke-opacity: 1;
        stroke-width: 3;
      }
      .mm2-core {
        display: grid;
        place-content: center;
        gap: 3px;
        text-align: center;
        width: clamp(104px, 12vw, 132px);
        height: clamp(104px, 12vw, 132px);
        border-radius: 22px;
        background: radial-gradient(120% 120% at 50% 0%, color-mix(in srgb, var(--p2) 24%, transparent), transparent 70%), var(--surface);
        border: 1px solid var(--border-strong);
        box-shadow: 0 0 0 1px #9a6cff22, 0 26px 54px -26px #6f6cff66;
      }
      .mm2-core-mark {
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: clamp(20px, 2.4vw, 26px);
        background: var(--grad);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .mm2-core-sub {
        font-size: 9.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-3);
      }
      .mm2-tail {
        display: flex;
        align-items: center;
        padding: 0 8px;
      }
      .mm2-tail-line {
        flex: 1;
        height: 2px;
        background: var(--grad);
      }
      .mm2-tail-tip {
        width: 0;
        height: 0;
        border: 5px solid transparent;
        border-left-color: var(--p3);
        margin-left: -1px;
      }
      .mm2-result {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 14px 16px 14px 4px;
      }
      .mm2-result-eyebrow {
        font-size: 10.5px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--text-3);
      }
      .mm2-result-title {
        font-size: clamp(24px, 3vw, 33px);
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.04;
        color: var(--text);
      }
      .mm2-result-sub {
        font-size: 14px;
        color: var(--text-2);
        max-width: 30ch;
        text-wrap: pretty;
      }
      @media (max-width: 900px) {
        .mm2-flow {
          grid-template-columns: 1fr;
          justify-items: center;
          gap: 8px;
          padding: 22px;
        }
        .mm2-inputs {
          width: 100%;
          max-width: 380px;
        }
        .mm2-wires {
          display: none;
        }
        .mm2-tail {
          transform: rotate(90deg);
          height: 28px;
        }
        .mm2-result {
          text-align: center;
          align-items: center;
          padding-top: 6px;
        }
      }

      /* ── App-direct host — hidden until a demo is opened ──────────── */
      /* The iframe grows to its content height (reported via golemui-resize),
         so the whole page scrolls as one — the demo never scrolls inside its
         own box — and the footer sits naturally below it. */
      .demos-viewport {
        display: none;
        width: 100%;
      }
      .demos-viewport.is-embedded {
        display: block;
      }
      .demo-pane[hidden] {
        display: none;
      }
      .demo-iframe {
        width: 100%;
        height: 0;
        min-height: calc(100vh - 4rem);
        border: none;
        display: block;
        background: var(--bg-color);
        transition: height 0.3s ease-out;
      }

    </style>
  </body>
</html>
