{
  "name": "validators-zod",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/validators-zod/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["build/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/validators-zod",
        "main": "libs/validators-zod/src/index.ts",
        "tsConfig": "libs/validators-zod/tsconfig.lib.json",
        "assets": ["libs/validators-zod/*.md"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
