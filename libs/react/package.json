{
  "name": "@golemui/react",
  "version": "0.0.1",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./*.d.ts",
      "import": "./*.js",
      "require": "./*.cjs"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "*.js",
    "*.cjs",
    "lib"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@golemui/react": "*",
    "@golemui/core": "*",
    "@golemui/shared-vanilla": "*"
  }
}
