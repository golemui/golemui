{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/dropdown.schema.json",
  "title": "Dropdown Widget",
  "type": "object",
  "$defs": {
    "disabledProp": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "readonlyProp": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "labelProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "placeholderProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "itemsProp": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template": {
            "type": "object"
          },
          "value": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "required": ["template", "value"]
      }
    },
    "labelFieldProp": {
      "type": "string"
    },
    "valueFieldProp": {
      "type": "string"
    },
    "searchFieldsProp": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heightProp": {
      "type": "number"
    },
    "itemHeightProp": {
      "type": "number"
    },
    "itemRendererProp": {
      "type": "string"
    },
    "inputDebounceProp": {
      "type": "number"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "dropdown"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelProp"
    },
    "disabled": {
      "$ref": "#/$defs/disabledProp"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyProp"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "placeholder": {
          "$ref": "#/$defs/placeholderProp"
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "items": {
          "$ref": "#/$defs/itemsProp"
        },
        "labelField": {
          "$ref": "#/$defs/labelFieldProp"
        },
        "valueField": {
          "$ref": "#/$defs/valueFieldProp"
        },
        "searchFields": {
          "$ref": "#/$defs/searchFieldsProp"
        },
        "height": {
          "$ref": "#/$defs/heightProp"
        },
        "itemHeight": {
          "$ref": "#/$defs/itemHeightProp"
        },
        "itemRenderer": {
          "$ref": "#/$defs/itemRendererProp"
        },
        "inputDebounce": {
          "$ref": "#/$defs/inputDebounceProp"
        }
      },
      "patternProperties": {
        "^placeholder\\.[^.]+$": {
          "$ref": "#/$defs/placeholderProp"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^items\\.[^.]+$": {
          "$ref": "#/$defs/itemsProp"
        },
        "^labelField\\.[^.]+$": {
          "$ref": "#/$defs/labelFieldProp"
        },
        "^valueField\\.[^.]+$": {
          "$ref": "#/$defs/valueFieldProp"
        },
        "^searchFields\\.[^.]+$": {
          "$ref": "#/$defs/searchFieldsProp"
        },
        "^height\\.[^.]+$": {
          "$ref": "#/$defs/heightProp"
        },
        "^itemHeight\\.[^.]+$": {
          "$ref": "#/$defs/itemHeightProp"
        },
        "^itemRenderer\\.[^.]+$": {
          "$ref": "#/$defs/itemRendererProp"
        },
        "^inputDebounce\\.[^.]+$": {
          "$ref": "#/$defs/inputDebounceProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelProp"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledProp"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyProp"
    }
  },
  "required": ["kind", "type", "path"]
}
