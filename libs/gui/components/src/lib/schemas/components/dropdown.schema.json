{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/dropdown.schema.json",
  "title": "Dropdown Widget",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "dropdown"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "template": {
                "type": "object"
              },
              "value": {
                "type": ["string", "number", "boolean", "null"]
              }
            },
            "required": ["template", "value"]
          }
        },
        "labelField": {
          "type": "string"
        },
        "valueField": {
          "type": "string"
        },
        "searchFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "height": {
          "type": "number"
        },
        "itemHeight": {
          "type": "number"
        },
        "itemRenderer": {
          "type": "string"
        },
        "inputDebounce": {
          "type": "number"
        }
      },
      "patternProperties": {
        "^[^.]*\\.?[[^.]]*$": {}
      },
      "additionalProperties": false
    }
  },
  "required": ["kind", "type", "path"]
}
