{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/list.schema.json",
  "title": "List Widget",
  "type": "object",
  "$defs": {
    "labelProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "hintProp": {
      v
    },
    "itemsProp": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template": {
            "type": "object"
          },
          "value": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "required": ["template", "value"]
      }
    },
    "valueFieldProp": {
      "type": "string"
    },
    "heightProp": {
      "type": "number"
    },
    "itemHeightProp": {
      "type": "number"
    },
    "itemRendererProp": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "list"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelProp"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "items": {
          "$ref": "#/$defs/itemsProp"
        },
        "valueField": {
          "$ref": "#/$defs/valueFieldProp"
        },
        "height": {
          "$ref": "#/$defs/heightProp"
        },
        "itemHeight": {
          "$ref": "#/$defs/itemHeightProp"
        },
        "itemRenderer": {
          "$ref": "#/$defs/itemRendererProp"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^items\\.[^.]+$": {
          "$ref": "#/$defs/itemsProp"
        },
        "^valueField\\.[^.]+$": {
          "$ref": "#/$defs/valueFieldProp"
        },
        "^height\\.[^.]+$": {
          "$ref": "#/$defs/heightProp"
        },
        "^itemHeight\\.[^.]+$": {
          "$ref": "#/$defs/itemHeightProp"
        },
        "^itemRenderer\\.[^.]+$": {
          "$ref": "#/$defs/itemRendererProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelProp"
    }
  },
  "required": ["kind", "type", "path"]
}
