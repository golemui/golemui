{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/number.schema.json",
  "title": "Number Widget",
  "type": "object",
  "$defs": {
    "labelProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "disabledProp": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "readonlyProp": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "placeholderProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "stepProp": {
      "type": "number"
    },
    "minimumProp": {
      "type": "number"
    },
    "maximumProp": {
      "type": "number"
    },
    "autoGrowProp": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "number"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelProp"
    },
    "disabled": {
      "$ref": "#/$defs/disabledProp"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyProp"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "defaultValue": {
      "type": "number"
    },
    "props": {
      "type": "object",
      "properties": {
        "placeholder": {
          "$ref": "#/$defs/placeholderProp"
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "step": {
          "$ref": "#/$defs/stepProp"
        },
        "minimum": {
          "$ref": "#/$defs/minimumProp"
        },
        "maximum": {
          "$ref": "#/$defs/maximumProp"
        },
        "autoGrow": {
          "$ref": "#/$defs/autoGrowProp"
        }
      },
      "patternProperties": {
        "^placeholder\\.[^.]+$": {
          "$ref": "#/$defs/placeholderProp"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^step\\.[^.]+$": {
          "$ref": "#/$defs/stepProp"
        },
        "^minimum\\.[^.]+$": {
          "$ref": "#/$defs/minimumProp"
        },
        "^maximum\\.[^.]+$": {
          "$ref": "#/$defs/maximumProp"
        },
        "^autoGrow\\.[^.]+$": {
          "$ref": "#/$defs/autoGrowProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelProp"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledProp"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyProp"
    }
  },
  "required": ["kind", "type", "path"]
}
