{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/accordion.schema.json",
  "title": "Accordion Widget",
  "type": "object",
  "$defs": {
    "singleOpenProp": {
      "type": "boolean"
    },
    "defaultOpenProp": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "minProperties": 1
    },
    "renderModeProp": {
      "enum": ["all", "activeOnly"]
    },
    "sectionsProp": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "$ref": "../common.schema.json#/definitions/localizable"
          },
          "uid": {
            "type": "string"
          }
        },
        "required": ["label", "uid"]
      }
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "layout"
    },
    "type": {
      "const": "accordion"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "singleOpen": {
          "$ref": "#/$defs/singleOpenProp"
        },
        "defaultOpen": {
          "$ref": "#/$defs/defaultOpenProp"
        },
        "renderMode": {
          "$ref": "#/$defs/renderModeProp"
        },
        "sections": {
          "$ref": "#/$defs/sectionsProp"
        }
      },
      "required": ["sections"],
      "patternProperties": {
        "^singleOpen\\.[^.]+$": {
          "$ref": "#/$defs/singleOpenProp"
        },
        "^defaultOpen\\.[^.]+$": {
          "$ref": "#/$defs/defaultOpenProp"
        },
        "^renderMode\\.[^.]+$": {
          "$ref": "#/$defs/renderModeProp"
        },
        "^sections\\.[^.]+$": {
          "$ref": "#/$defs/sectionsProp"
        }
      },
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../form.schema.json#/definitions/formWidget"
      }
    }
  },
  "required": ["kind", "type", "children", "props"]
}
