{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/datepicker.schema.json",
  "title": "DatePicker Widget",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "datePicker"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "prevMonthIcon": {
          "type": "string"
        },
        "nextMonthIcon": {
          "type": "string"
        },
        "prevMonthAriaLabel": {
          "type": "string"
        },
        "nextMonthAriaLabel": {
          "type": "string"
        },
        "dayFormat": {
          "enum": ["numeric", "2-digit"]
        },
        "weekdayFormat": {
          "enum": ["short", "long", "narrow"]
        },
        "monthFormat": {
          "enum": ["numeric", "2-digit", "long", "short", "narrow"]
        }
      },
      "patternProperties": {
        "^[^.]*\\.?[[^.]]*$": {}
      },
      "additionalProperties": false
    }
  },
  "required": ["kind", "type", "path"]
}
