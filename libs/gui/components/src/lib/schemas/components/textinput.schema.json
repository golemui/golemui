{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/textinput.schema.json",
  "title": "TextInput Widget",
  "type": "object",
  "$defs": {
    "disabledProp": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "readonlyProp": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "labelProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "placeholderProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "iconProp": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "textinput"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelProp"
    },
    "disabled": {
      "$ref": "#/$defs/disabledProp"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyProp"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "defaultValue": {
      "type": "string"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "placeholder": {
          "$ref": "#/$defs/placeholderProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^placeholder\\.[^.]+$": {
          "$ref": "#/$defs/placeholderProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledProp"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyProp"
    },
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelProp"
    }
  },
  "required": ["kind", "type", "path"]
}
