{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/dateinput.schema.json",
  "title": "DateInput Widget",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "dateInput"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^[^.]*\\.?[[^.]]*$": {}
      },
      "additionalProperties": false
    }
  },
  "required": ["kind", "type", "path"]
}
