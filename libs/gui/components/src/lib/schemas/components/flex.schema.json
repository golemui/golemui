{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/flex.schema.json",
  "title": "Flex Widget",
  "type": "object",
  "$defs": {
    "directionProp": {
      "enum": ["horizontal", "vertical"]
    },
    "alignProp": {
      "enum": ["center", "start", "end", "space-between", "space-around"]
    },
    "gapProp": {
      "type": "number"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "layout"
    },
    "type": {
      "const": "flex"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/directionProp"
        },
        "align": {
          "$ref": "#/$defs/alignProp"
        },
        "gap": {
          "$ref": "#/$defs/gapProp"
        }
      },
      "patternProperties": {
        "^direction\\.[^.]+$": {
          "$ref": "#/$defs/directionProp"
        },
        "^align\\.[^.]+$": {
          "$ref": "#/$defs/alignProp"
        },
        "^gap\\.[^.]+$": {
          "$ref": "#/$defs/gapProp"
        }
      },
      "additionalProperties": false
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "../form.schema.json#/definitions/formWidget"
      }
    }
  },
  "required": ["kind", "type", "children"]
}
