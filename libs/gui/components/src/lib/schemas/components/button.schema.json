{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/button.schema.json",
  "title": "Button Widget",
  "type": "object",
  "$defs": {
    "disabledProp": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "labelProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "variantProp": {
      "enum": ["filled", "outlined"]
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "action"
    },
    "type": {
      "const": "button"
    },
    "label": {
      "$ref": "#/$defs/labelProp"
    },
    "disabled": {
      "$ref": "#/$defs/disabledProp"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "additionalProperties": false,
    "props": {
      "properties": {
        "variant": {
          "$ref": "#/$defs/variantProp"
        }
      },
      "patternProperties": {
        "^variant\\.[^.]+$": {
          "$ref": "#/$defs/variantProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledProp"
    },
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelProp"
    }
  },
  "required": ["kind", "type"]
}
