{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/alert.schema.json",
  "title": "Alert Widget",
  "type": "object",
  "$defs": {
    "localizableTextProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "alertLevelProp": {
      "enum": ["default", "info", "success", "warning", "error"]
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "display"
    },
    "type": {
      "const": "alert"
    },
    "props": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/localizableTextProp"
        },
        "level": {
          "$ref": "#/$defs/alertLevelProp"
        }
      },
      "patternProperties": {
        "^text\\.[^.]+$": {
          "$ref": "#/$defs/localizableTextProp"
        },
        "^level\\.[^.]+$": {
          "$ref": "#/$defs/alertLevelProp"
        }
      },
      "required": ["text"],
      "additionalProperties": false
    }
  },
  "required": ["kind", "type", "props"]
}
