{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/alert.schema.json",
  "title": "Alert Widget",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "display"
    },
    "type": {
      "const": "alert"
    },
    "props": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "../common.schema.json#/definitions/localizable"
        },
        "level": {
          "enum": ["default", "info", "success", "warning", "error"]
        }
      },
      "required": ["text"],
      "patternProperties": {
        "^[^.]*\\.?[[^.]]*$": {}
      },
      "additionalProperties": false
    }
  },
  "required": ["kind", "type", "props"]
}
