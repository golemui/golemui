{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/toggle.schema.json",
  "title": "Toggle Widget",
  "type": "object",
  "$defs": {
    "labelProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "disabledProp": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "readonlyProp": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "togglePositionProp": {
      "enum": ["left", "right"]
    },
    "hintProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "toggle"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelProp"
    },
    "disabled": {
      "$ref": "#/$defs/disabledProp"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyProp"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "defaultValue": {
      "type": "boolean"
    },
    "props": {
      "type": "object",
      "properties": {
        "togglePosition": {
          "$ref": "#/$defs/togglePositionProp"
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        }
      },
      "patternProperties": {
        "^togglePosition\\.[^.]+$": {
          "$ref": "#/$defs/togglePositionProp"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelProp"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledProp"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyProp"
    }
  },
  "required": ["kind", "type", "path"]
}
