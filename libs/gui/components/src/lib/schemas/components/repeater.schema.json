{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/repeater.schema.json",
  "title": "Repeater Widget",
  "type": "object",
  "$defs": {
    "labelProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "addLabelProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "removeLabelProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "limitProp": {
      "type": "number"
    },
    "templateProp": {
      "$ref": "./flex.schema.json"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "repeater"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelProp"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "addLabel": {
          "$ref": "#/$defs/addLabelProp"
        },
        "removeLabel": {
          "$ref": "#/$defs/removeLabelProp"
        },
        "limit": {
          "$ref": "#/$defs/limitProp"
        },
        "template": {
          "$ref": "#/$defs/templateProp"
        }
      },
      "required": ["template"],
      "patternProperties": {
        "^addLabel\\.[^.]+$": {
          "$ref": "#/$defs/addLabelProp"
        },
        "^removeLabel\\.[^.]+$": {
          "$ref": "#/$defs/removeLabelProp"
        },
        "^limit\\.[^.]+$": {
          "$ref": "#/$defs/limitProp"
        },
        "^template\\.[^.]+$": {
          "$ref": "#/$defs/templateProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelProp"
    }
  },
  "required": ["kind", "type", "path", "props"]
}
