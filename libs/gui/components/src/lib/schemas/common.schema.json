{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/common.schema.json",
  "title": "Golem Common Definitions",
  "definitions": {
    "reactiveExpression": {
      "type": "string",
      "description": "A reactive expression string. Use `$form` to access form data e.g. `$form.termsAccepted === true`"
    },
    "dotPath": {
      "type": "string",
      "description": "A dot-separated path to a property in the form data"
    },
    "uid": {
      "type": "string",
      "description": "Unique identifier for the widget"
    },
    "localizable": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "default": {
              "type": "string"
            },
            "params": {
              "type": "object"
            }
          },
          "required": ["key"]
        }
      ]
    },
    "include": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "in": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["in"]
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/definitions/reactiveExpression"
            }
          },
          "required": ["when"]
        }
      ]
    },
    "exclude": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["from"]
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/definitions/reactiveExpression"
            }
          },
          "required": ["when"]
        }
      ]
    },
    "disabled": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/definitions/reactiveExpression"
            }
          },
          "required": ["when"]
        }
      ]
    },
    "on": {
      "type": "object",
      "properties": {
        "load": {
          "type": "string"
        },
        "click": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "filter": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^[^.]*\\.?[[^.]]*$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "baseWidget": {
      "type": "object",
      "properties": {
        "uid": {
          "$ref": "#/definitions/uid"
        },
        "type": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "include": {
          "$ref": "#/definitions/include"
        },
        "exclude": {
          "$ref": "#/definitions/exclude"
        }
      },
      "required": ["type"]
    }
  }
}
