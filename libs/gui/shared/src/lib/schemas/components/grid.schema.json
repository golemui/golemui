{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/grid.schema.json",
  "title": "Grid Widget",
  "type": "object",
  "$defs": {
    "directionProp": {
      "enum": ["row", "column"]
    },
    "columnGapProp": {
      "type": "number"
    },
    "rowGapProp": {
      "type": "number"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "layout"
    },
    "type": {
      "const": "grid"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../form.schema.json#/$defs/formWidget"
      }
    },
    "props": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/directionProp"
        },
        "columnGap": {
          "$ref": "#/$defs/columnGapProp"
        },
        "rowGap": {
          "$ref": "#/$defs/rowGapProp"
        }
      },
      "patternProperties": {
        "^direction\\.[^.]+$": {
          "$ref": "#/$defs/directionProp"
        },
        "^columnGap\\.[^.]+$": {
          "$ref": "#/$defs/columnGapProp"
        },
        "^rowGap\\.[^.]+$": {
          "$ref": "#/$defs/rowGapProp"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["kind", "type", "children"]
}
