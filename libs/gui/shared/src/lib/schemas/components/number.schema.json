{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/number.schema.json",
  "title": "Number Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "placeholderProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "stepProp": {
      "type": "number"
    },
    "minimumProp": {
      "type": "number"
    },
    "maximumProp": {
      "type": "number"
    },
    "autoGrowProp": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "number"
    },
    "path": {
      "$ref": "../common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../common.schema.json#/$defs/on"
    },
    "defaultValue": {
      "type": "number"
    },
    "props": {
      "type": "object",
      "properties": {
        "placeholder": {
          "$ref": "#/$defs/placeholderProp"
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "step": {
          "$ref": "#/$defs/stepProp"
        },
        "minimum": {
          "$ref": "#/$defs/minimumProp"
        },
        "maximum": {
          "$ref": "#/$defs/maximumProp"
        },
        "autoGrow": {
          "$ref": "#/$defs/autoGrowProp"
        }
      },
      "patternProperties": {
        "^placeholder\\.[^.]+$": {
          "$ref": "#/$defs/placeholderProp"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^step\\.[^.]+$": {
          "$ref": "#/$defs/stepProp"
        },
        "^minimum\\.[^.]+$": {
          "$ref": "#/$defs/minimumProp"
        },
        "^maximum\\.[^.]+$": {
          "$ref": "#/$defs/maximumProp"
        },
        "^autoGrow\\.[^.]+$": {
          "$ref": "#/$defs/autoGrowProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    }
  },
  "required": ["kind", "type", "path"]
}
