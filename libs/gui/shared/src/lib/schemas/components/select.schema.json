{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/select.schema.json",
  "title": "Select Widget",
  "type": "object",
  "$defs": {
    "disabledDef": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../common.schema.json#/definitions/boolOrWhen"
    },
    "labelDef": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "iconProp": {
      "type": "string"
    },
    "optionsProp": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "required": ["label", "value"]
      }
    },
    "placeholderProp": {
      "$ref": "../common.schema.json#/definitions/localizable"
    },
    "labelFieldProp": {
      "type": "string"
    },
    "valueFieldProp": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/definitions/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "select"
    },
    "path": {
      "$ref": "../common.schema.json#/definitions/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../common.schema.json#/definitions/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "options": {
          "$ref": "#/$defs/optionsProp"
        },
        "placeholder": {
          "$ref": "#/$defs/placeholderProp"
        },
        "labelField": {
          "$ref": "#/$defs/labelFieldProp"
        },
        "valueField": {
          "$ref": "#/$defs/valueFieldProp"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^options\\.[^.]+$": {
          "$ref": "#/$defs/optionsProp"
        },
        "^placeholder\\.[^.]+$": {
          "$ref": "#/$defs/placeholderProp"
        },
        "^labelField\\.[^.]+$": {
          "$ref": "#/$defs/labelFieldProp"
        },
        "^valueField\\.[^.]+$": {
          "$ref": "#/$defs/valueFieldProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    }
  },
  "required": ["kind", "type", "path"]
}
