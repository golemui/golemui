{
  "name": "@golemui/gui-shared",
  "version": "0.0.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.umd.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.umd.cjs"
    },
    "./internals": {
      "types": "./internals.d.ts",
      "import": "./internals.js",
      "require": "./internals.umd.cjs"
    },
    "./forms.css": "./forms.css"
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "index.umd.cjs",
    "internals.d.ts",
    "internals.js",
    "internals.umd.cjs",
    "*.js",
    "*.cjs",
    "*.md",
    "forms.css"
  ],
  "dependencies": {
    "@golemui/core": "*",
    "@golemui/dx": "*",
    "@golemui/gui-validators": "*",
    "@golemui/gui-components": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/gui/shared"
  }
}
