{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/widgets.schema.json",
  "$comment": "GENERATED by libs/gui/schemas/tools/generate-schemas.ts from src/lib/widget-manifest.ts. DO NOT EDIT. Regenerate with `npm run generate:schemas`.",
  "title": "Golem gui widgets",
  "$defs": {
    "knownWidgetTypes": {
      "description": "Built-in widget `type` identifiers. Used to exclude built-ins from the custom-widget fallback so every widget matches exactly one schema. Types listed here without a component schema are not expressible in JSON and are rejected entirely instead of validating as custom widgets.",
      "enum": [
        "calendar",
        "dateTimeCalendar",
        "checkbox",
        "currency",
        "dateInput",
        "datePicker",
        "dateTimeInput",
        "dateTimePicker",
        "dropdown",
        "list",
        "markdown",
        "number",
        "password",
        "radiogroup",
        "rangeCalendar",
        "rangeDateInput",
        "rangeDatePicker",
        "rangeDateTimeInput",
        "rangeDateTimeCalendar",
        "rangeDateTimePicker",
        "rangeTimeInput",
        "rangeTimePicker",
        "repeater",
        "select",
        "tags",
        "textarea",
        "textinput",
        "timeInput",
        "timePicker",
        "toggle",
        "accordion",
        "flex",
        "grid",
        "tabs",
        "alert",
        "markdownText",
        "renderer",
        "button"
      ]
    },
    "formWidget": {
      "description": "A form widget: one of the built-in component schemas, the custom-widget fallback, or a reference to an external chunk file.",
      "oneOf": [
        { "$ref": "./components/calendar.schema.json" },
        { "$ref": "./components/datetimecalendar.schema.json" },
        { "$ref": "./components/checkbox.schema.json" },
        { "$ref": "./components/currency.schema.json" },
        { "$ref": "./components/dateinput.schema.json" },
        { "$ref": "./components/datepicker.schema.json" },
        { "$ref": "./components/datetimeinput.schema.json" },
        { "$ref": "./components/datetimepicker.schema.json" },
        { "$ref": "./components/dropdown.schema.json" },
        { "$ref": "./components/list.schema.json" },
        { "$ref": "./components/markdown.schema.json" },
        { "$ref": "./components/number.schema.json" },
        { "$ref": "./components/password.schema.json" },
        { "$ref": "./components/radiogroup.schema.json" },
        { "$ref": "./components/rangecalendar.schema.json" },
        { "$ref": "./components/rangedateinput.schema.json" },
        { "$ref": "./components/rangedatepicker.schema.json" },
        { "$ref": "./components/rangedatetimeinput.schema.json" },
        { "$ref": "./components/rangedatetimecalendar.schema.json" },
        { "$ref": "./components/rangedatetimepicker.schema.json" },
        { "$ref": "./components/rangetimeinput.schema.json" },
        { "$ref": "./components/rangetimepicker.schema.json" },
        { "$ref": "./components/repeater.schema.json" },
        { "$ref": "./components/select.schema.json" },
        { "$ref": "./components/tags.schema.json" },
        { "$ref": "./components/textarea.schema.json" },
        { "$ref": "./components/textinput.schema.json" },
        { "$ref": "./components/timeinput.schema.json" },
        { "$ref": "./components/timepicker.schema.json" },
        { "$ref": "./components/toggle.schema.json" },
        { "$ref": "./components/accordion.schema.json" },
        { "$ref": "./components/flex.schema.json" },
        { "$ref": "./components/grid.schema.json" },
        { "$ref": "./components/tabs.schema.json" },
        { "$ref": "./components/alert.schema.json" },
        { "$ref": "./components/markdowntext.schema.json" },
        { "$ref": "./components/button.schema.json" },
        { "$ref": "./components/custom.schema.json" },
        { "$ref": "./core/common.schema.json#/$defs/chunkRef" }
      ]
    }
  }
}
