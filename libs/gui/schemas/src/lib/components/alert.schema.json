{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/alert.schema.json",
  "title": "Alert Widget",
  "type": "object",
  "$defs": {
    "textProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "levelProp": {
      "enum": ["default", "info", "success", "warning", "error"]
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "display"
    },
    "type": {
      "const": "alert"
    },
    "props": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/textProp"
        },
        "level": {
          "$ref": "#/$defs/levelProp"
        }
      },
      "patternProperties": {
        "^text\\.[^.]+$": {
          "$ref": "#/$defs/textProp"
        },
        "^level\\.[^.]+$": {
          "$ref": "#/$defs/levelProp"
        }
      },
      "required": ["text"],
      "additionalProperties": false
    }
  },
  "required": ["kind", "type", "props"],
  "unevaluatedProperties": false
}
