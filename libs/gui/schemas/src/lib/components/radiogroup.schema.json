{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/radiogroup.schema.json",
  "title": "RadioGroup Widget",
  "type": "object",
  "$defs": {
    "disabledDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "labelDef": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "optionsProp": {
      "type": "array",
      "description": "Options may be primitive values (string/number), structured `{ label, value }` records, or arbitrary objects (paired with `labelField`/`valueField` for custom rendering).",
      "items": {
        "type": ["string", "number", "object"]
      }
    },
    "labelFieldProp": {
      "type": "string",
      "description": "Object property used as the display label when options are objects (e.g. `\"name\"` reads `item.name`)"
    },
    "valueFieldProp": {
      "type": "string",
      "description": "Object property used as the stored value when options are objects (e.g. `\"id\"` stores `item.id`)"
    },
    "directionProp": {
      "description": "Layout direction for the radio buttons (`row` = horizontal, `column` = vertical). Defaults to `column`.",
      "enum": ["row", "column"],
      "default": "column"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "radiogroup"
    },
    "path": {
      "$ref": "../common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "options": {
          "$ref": "#/$defs/optionsProp"
        },
        "labelField": {
          "$ref": "#/$defs/labelFieldProp"
        },
        "valueField": {
          "$ref": "#/$defs/valueFieldProp"
        },
        "direction": {
          "$ref": "#/$defs/directionProp"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^options\\.[^.]+$": {
          "$ref": "#/$defs/optionsProp"
        },
        "^labelField\\.[^.]+$": {
          "$ref": "#/$defs/labelFieldProp"
        },
        "^valueField\\.[^.]+$": {
          "$ref": "#/$defs/valueFieldProp"
        },
        "^direction\\.[^.]+$": {
          "$ref": "#/$defs/directionProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
