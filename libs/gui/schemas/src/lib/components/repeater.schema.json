{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/repeater.schema.json",
  "title": "Repeater Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "addLabelProp": {
      "description": "Label for the button that adds a new repeated item",
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "removeLabelProp": {
      "description": "Label for the button that removes an existing repeated item",
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "limitProp": {
      "type": "number",
      "description": "Maximum number of items the user can add. No limit when omitted."
    },
    "templateProp": {
      "description": "Widget tree used as the template for each repeated item. Paths inside are resolved relative to the item's index in the array. Widgets inside the template can reference the current item in reactive expressions ('when' conditions, '{{}}' interpolation slots, and i18n params) through the scope variables '$item' (the item object, e.g. '$item.quantity') and '$index' (the item's zero-based position). For nested repeaters these bind to the innermost enclosing item.",
      "$ref": "../layout-widget.schema.json"
    },
    "titleProp": {
      "description": "Title displayed in the header of each item panel.",
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "addButtonIconProp": {
      "type": "string",
      "description": "Icon name or CSS class for the add-item button icon"
    },
    "removeButtonIconProp": {
      "type": "string",
      "description": "Icon name or CSS class for the remove-item button icon"
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "repeater"
    },
    "path": {
      "$ref": "../core/common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "on": {
      "$ref": "../core/common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "defaultValue": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "props": {
      "type": "object",
      "properties": {
        "addLabel": {
          "$ref": "#/$defs/addLabelProp"
        },
        "removeLabel": {
          "$ref": "#/$defs/removeLabelProp"
        },
        "limit": {
          "$ref": "#/$defs/limitProp"
        },
        "template": {
          "$ref": "#/$defs/templateProp"
        },
        "title": {
          "$ref": "#/$defs/titleProp"
        },
        "addButtonIcon": {
          "$ref": "#/$defs/addButtonIconProp"
        },
        "removeButtonIcon": {
          "$ref": "#/$defs/removeButtonIconProp"
        }
      },
      "required": ["template"],
      "patternProperties": {
        "^addLabel\\.[^.]+$": {
          "$ref": "#/$defs/addLabelProp"
        },
        "^removeLabel\\.[^.]+$": {
          "$ref": "#/$defs/removeLabelProp"
        },
        "^limit\\.[^.]+$": {
          "$ref": "#/$defs/limitProp"
        },
        "^template\\.[^.]+$": {
          "$ref": "#/$defs/templateProp"
        },
        "^title\\.[^.]+$": {
          "$ref": "#/$defs/titleProp"
        },
        "^addButtonIcon\\.[^.]+$": {
          "$ref": "#/$defs/addButtonIconProp"
        },
        "^removeButtonIcon\\.[^.]+$": {
          "$ref": "#/$defs/removeButtonIconProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path", "props"],
  "unevaluatedProperties": false
}
