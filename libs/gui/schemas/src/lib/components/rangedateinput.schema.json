{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/rangedateinput.schema.json",
  "title": "RangeDateInput Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "hintProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "iconProp": {
      "type": "string"
    },
    "separatorProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "removePillAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "startDateAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "endDateAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "dayAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "monthAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "yearAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "rangeDateInput"
    },
    "path": {
      "$ref": "../core/common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../core/common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    },
    "props": {
      "type": "object",
      "properties": {
        "invalidDateMessage": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "incompleteMessage": {
          "$ref": "../core/common.schema.json#/$defs/localizable",
          "description": "Error surfaced when focus leaves the widget with a partially filled entry behind; the value goes to null so validators report it even on non-required fields."
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "separator": {
          "$ref": "#/$defs/separatorProp"
        },
        "removePillAriaLabel": {
          "$ref": "#/$defs/removePillAriaLabelProp"
        },
        "startDateAriaLabel": {
          "$ref": "#/$defs/startDateAriaLabelProp"
        },
        "endDateAriaLabel": {
          "$ref": "#/$defs/endDateAriaLabelProp"
        },
        "dayAriaLabel": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "monthAriaLabel": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "yearAriaLabel": {
          "$ref": "#/$defs/yearAriaLabelProp"
        }
      },
      "patternProperties": {
        "^invalidDateMessage\\.[^.]+$": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "^incompleteMessage\\.[^.]+$": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^separator\\.[^.]+$": {
          "$ref": "#/$defs/separatorProp"
        },
        "^removePillAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/removePillAriaLabelProp"
        },
        "^startDateAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/startDateAriaLabelProp"
        },
        "^endDateAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/endDateAriaLabelProp"
        },
        "^dayAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "^monthAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "^yearAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/yearAriaLabelProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
