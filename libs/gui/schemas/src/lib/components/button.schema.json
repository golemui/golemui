{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/button.schema.json",
  "title": "Button Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "variantProp": {
      "enum": ["filled", "outlined", "link"]
    },
    "iconProp": {
      "type": "string"
    },
    "iconPositionProp": {
      "enum": ["left", "right"]
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "action"
    },
    "type": {
      "const": "button"
    },
    "actionType": {
      "enum": ["button", "submit"]
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "on": {
      "$ref": "../core/common.schema.json#/$defs/on"
    },
    "props": {
      "type": "object",
      "properties": {
        "variant": {
          "$ref": "#/$defs/variantProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "iconPosition": {
          "$ref": "#/$defs/iconPositionProp"
        }
      },
      "patternProperties": {
        "^variant\\.[^.]+$": {
          "$ref": "#/$defs/variantProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^iconPosition\\.[^.]+$": {
          "$ref": "#/$defs/iconPositionProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    }
  },
  "required": ["kind", "type"],
  "unevaluatedProperties": false
}
