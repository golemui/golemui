{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/dateinput.schema.json",
  "title": "DateInput Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "iconProp": {
      "type": "string"
    },
    "minDateProp": {
      "type": "string"
    },
    "maxDateProp": {
      "type": "string"
    },
    "dayAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "monthAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "yearAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "dateInput"
    },
    "path": {
      "$ref": "../common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "props": {
      "type": "object",
      "properties": {
        "invalidDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "minDate": {
          "$ref": "#/$defs/minDateProp"
        },
        "maxDate": {
          "$ref": "#/$defs/maxDateProp"
        },
        "minDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "maxDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "dayAriaLabel": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "monthAriaLabel": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "yearAriaLabel": {
          "$ref": "#/$defs/yearAriaLabelProp"
        }
      },
      "patternProperties": {
        "^invalidDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^minDate\\.[^.]+$": {
          "$ref": "#/$defs/minDateProp"
        },
        "^maxDate\\.[^.]+$": {
          "$ref": "#/$defs/maxDateProp"
        },
        "^minDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^maxDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^dayAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "^monthAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "^yearAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/yearAriaLabelProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
