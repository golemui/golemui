{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/toggle.schema.json",
  "title": "Toggle Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "togglePositionProp": {
      "enum": ["left", "right"],
      "default": "left"
    },
    "hintProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "toggle"
    },
    "path": {
      "$ref": "../core/common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../core/common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    },
    "defaultValue": {
      "type": "boolean"
    },
    "props": {
      "type": "object",
      "properties": {
        "togglePosition": {
          "$ref": "#/$defs/togglePositionProp"
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        }
      },
      "patternProperties": {
        "^togglePosition\\.[^.]+$": {
          "$ref": "#/$defs/togglePositionProp"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
