{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/currency.schema.json",
  "title": "Currency Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "currencyProp": {
      "type": "string"
    },
    "stepProp": {
      "type": "number"
    },
    "maximumFractionDigitsProp": {
      "type": "number"
    },
    "minimumFractionDigitsProp": {
      "type": "number"
    },
    "hintProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "placeholderProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "iconProp": {
      "type": "string"
    },
    "autocompleteProp": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "currency"
    },
    "path": {
      "$ref": "../core/common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../core/common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    },
    "defaultValue": {
      "type": "number"
    },
    "props": {
      "type": "object",
      "properties": {
        "currency": {
          "$ref": "#/$defs/currencyProp"
        },
        "step": {
          "$ref": "#/$defs/stepProp"
        },
        "maximumFractionDigits": {
          "$ref": "#/$defs/maximumFractionDigitsProp"
        },
        "minimumFractionDigits": {
          "$ref": "#/$defs/minimumFractionDigitsProp"
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "placeholder": {
          "$ref": "#/$defs/placeholderProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "autocomplete": {
          "$ref": "#/$defs/autocompleteProp"
        }
      },
      "patternProperties": {
        "^currency\\.[^.]+$": {
          "$ref": "#/$defs/currencyProp"
        },
        "^step\\.[^.]+$": {
          "$ref": "#/$defs/stepProp"
        },
        "^maximumFractionDigits\\.[^.]+$": {
          "$ref": "#/$defs/maximumFractionDigitsProp"
        },
        "^minimumFractionDigits\\.[^.]+$": {
          "$ref": "#/$defs/minimumFractionDigitsProp"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^placeholder\\.[^.]+$": {
          "$ref": "#/$defs/placeholderProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^autocomplete\\.[^.]+$": {
          "$ref": "#/$defs/autocompleteProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
