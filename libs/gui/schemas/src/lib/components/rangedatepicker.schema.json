        "weekdayFormat": {
          "$ref": "#/$defs/weekdayFormatProp"
        },
        "monthFormat": {
          "$ref": "#/$defs/monthFormatProp"
        },
        "minDate": {
          "$ref": "#/$defs/minDateProp"
        },
        "maxDate": {
          "$ref": "#/$defs/maxDateProp"
        },
        "numberOfMonths": {
          "$ref": "#/$defs/numberOfMonthsProp"
        },
        "disabledRanges": {
          "$ref": "#/$defs/disabledRangesProp"
        }
      },
      "patternProperties": {
        "^invalidDateMessage\\.[^.]+$": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
