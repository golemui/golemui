    },
    "yearAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "dayFormatProp": {
      "enum": ["numeric", "2-digit"]
    },
    "weekdayFormatProp": {
      "enum": ["short", "long", "narrow"]
    },
    "monthFormatProp": {
      "enum": ["numeric", "2-digit", "long", "short", "narrow"]
    },
    "minDateProp": {
      "type": "string"
    },
    "maxDateProp": {
      "type": "string"
    },
    "numberOfMonthsProp": {
      "type": "number"
    },
    "disabledRangesProp": {
      "type": "array",
      "items": {
        "$ref": "../core/common.schema.json#/$defs/dateRange"
      }
    }
