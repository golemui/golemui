          "$ref": "#/$defs/prevMonthIconProp"
        },
        "nextMonthIcon": {
          "$ref": "#/$defs/nextMonthIconProp"
        },
        "prevMonthAriaLabel": {
          "$ref": "#/$defs/prevMonthAriaLabelProp"
        },
        "nextMonthAriaLabel": {
          "$ref": "#/$defs/nextMonthAriaLabelProp"
        },
        "toggleAriaLabel": {
          "$ref": "#/$defs/toggleAriaLabelProp"
        },
        "selectYearAriaLabel": {
          "$ref": "#/$defs/selectYearAriaLabelProp"
        },
        "yearGridAriaLabel": {
          "$ref": "#/$defs/yearGridAriaLabelProp"
        },
        "dayAriaLabel": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "monthAriaLabel": {
          "$ref": "#/$defs/monthAriaLabelProp"
