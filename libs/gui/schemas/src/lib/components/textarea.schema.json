{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/textarea.schema.json",
  "title": "TextArea Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "hintProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "placeholderProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "counterModeProp": {
      "enum": ["remaining", "current"]
    },
    "minimumHeightProp": {
      "type": "number"
    },
    "autoGrowProp": {
      "type": "boolean"
    },
    "maxLengthProp": {
      "type": "number"
    },
    "autocompleteProp": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "textarea"
    },
    "path": {
      "$ref": "../core/common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../core/common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    },
    "defaultValue": {
      "type": "string"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "placeholder": {
          "$ref": "#/$defs/placeholderProp"
        },
        "counterMode": {
          "$ref": "#/$defs/counterModeProp"
        },
        "minimumHeight": {
          "$ref": "#/$defs/minimumHeightProp"
        },
        "autoGrow": {
          "$ref": "#/$defs/autoGrowProp"
        },
        "maxLength": {
          "$ref": "#/$defs/maxLengthProp"
        },
        "autocomplete": {
          "$ref": "#/$defs/autocompleteProp"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^placeholder\\.[^.]+$": {
          "$ref": "#/$defs/placeholderProp"
        },
        "^counterMode\\.[^.]+$": {
          "$ref": "#/$defs/counterModeProp"
        },
        "^minimumHeight\\.[^.]+$": {
          "$ref": "#/$defs/minimumHeightProp"
        },
        "^autoGrow\\.[^.]+$": {
          "$ref": "#/$defs/autoGrowProp"
        },
        "^maxLength\\.[^.]+$": {
          "$ref": "#/$defs/maxLengthProp"
        },
        "^autocomplete\\.[^.]+$": {
          "$ref": "#/$defs/autocompleteProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
