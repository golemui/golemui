{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/list.schema.json",
  "title": "List Widget",
  "type": "object",
  "$defs": {
    "disabledDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "labelDef": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "itemsProp": {
      "type": "array",
      "description": "Items are either primitive values (string/number) or arbitrary record objects (paired with `labelField`/`valueField`/`itemRenderer` for custom rendering). Note: widget templates inside items are only supported on `repeater`, not here.",
      "items": {
        "type": ["string", "number", "object"]
      }
    },
    "labelFieldProp": {
      "type": "string"
    },
    "valueFieldProp": {
      "type": "string"
    },
    "heightProp": {
      "type": "number"
    },
    "itemHeightProp": {
      "type": "number"
    },
    "itemRendererProp": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "list"
    },
    "path": {
      "$ref": "../common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "items": {
          "$ref": "#/$defs/itemsProp"
        },
        "labelField": {
          "$ref": "#/$defs/labelFieldProp"
        },
        "valueField": {
          "$ref": "#/$defs/valueFieldProp"
        },
        "height": {
          "$ref": "#/$defs/heightProp"
        },
        "itemHeight": {
          "$ref": "#/$defs/itemHeightProp"
        },
        "itemRenderer": {
          "$ref": "#/$defs/itemRendererProp"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^items\\.[^.]+$": {
          "$ref": "#/$defs/itemsProp"
        },
        "^labelField\\.[^.]+$": {
          "$ref": "#/$defs/labelFieldProp"
        },
        "^valueField\\.[^.]+$": {
          "$ref": "#/$defs/valueFieldProp"
        },
        "^height\\.[^.]+$": {
          "$ref": "#/$defs/heightProp"
        },
        "^itemHeight\\.[^.]+$": {
          "$ref": "#/$defs/itemHeightProp"
        },
        "^itemRenderer\\.[^.]+$": {
          "$ref": "#/$defs/itemRendererProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
