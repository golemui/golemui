{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/rangedatetimeinput.schema.json",
  "title": "RangeDateTimeInput Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "iconProp": {
      "type": "string"
    },
    "separatorProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "removePillAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "startDateTimeAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "endDateTimeAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "hourFormatProp": {
      "enum": ["12", "24"]
    },
    "minuteStepProp": {
      "type": "number",
      "minimum": 1
    },
    "minDateProp": {
      "type": "string"
    },
    "maxDateProp": {
      "type": "string"
    },
    "isoTimeProp": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "rangeDateTimeInput"
    },
    "path": {
      "$ref": "../common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "separator": {
          "$ref": "#/$defs/separatorProp"
        },
        "removePillAriaLabel": {
          "$ref": "#/$defs/removePillAriaLabelProp"
        },
        "startDateTimeAriaLabel": {
          "$ref": "#/$defs/startDateTimeAriaLabelProp"
        },
        "endDateTimeAriaLabel": {
          "$ref": "#/$defs/endDateTimeAriaLabelProp"
        },
        "hourFormat": {
          "$ref": "#/$defs/hourFormatProp"
        },
        "minuteStep": {
          "$ref": "#/$defs/minuteStepProp"
        },
        "invalidDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "minDate": {
          "$ref": "#/$defs/minDateProp"
        },
        "maxDate": {
          "$ref": "#/$defs/maxDateProp"
        },
        "minTime": {
          "$ref": "#/$defs/isoTimeProp"
        },
        "maxTime": {
          "$ref": "#/$defs/isoTimeProp"
        },
        "minDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "maxDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "minTimeMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "maxTimeMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^separator\\.[^.]+$": {
          "$ref": "#/$defs/separatorProp"
        },
        "^removePillAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/removePillAriaLabelProp"
        },
        "^startDateTimeAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/startDateTimeAriaLabelProp"
        },
        "^endDateTimeAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/endDateTimeAriaLabelProp"
        },
        "^hourFormat\\.[^.]+$": {
          "$ref": "#/$defs/hourFormatProp"
        },
        "^minuteStep\\.[^.]+$": {
          "$ref": "#/$defs/minuteStepProp"
        },
        "^invalidDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^minDate\\.[^.]+$": {
          "$ref": "#/$defs/minDateProp"
        },
        "^maxDate\\.[^.]+$": {
          "$ref": "#/$defs/maxDateProp"
        },
        "^minTime\\.[^.]+$": {
          "$ref": "#/$defs/isoTimeProp"
        },
        "^maxTime\\.[^.]+$": {
          "$ref": "#/$defs/isoTimeProp"
        },
        "^minDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^maxDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^minTimeMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^maxTimeMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
