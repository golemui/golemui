{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/rangedatetimeinput.schema.json",
  "title": "RangeDateTimeInput Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "hintProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "iconProp": {
      "type": "string"
    },
    "separatorProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "removePillAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "startDateTimeAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "endDateTimeAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "hourFormatProp": {
      "enum": ["12", "24"]
    },
    "minuteStepProp": {
      "type": "number",
      "minimum": 1
    },
    "minDateTimeProp": {
      "type": "string",
      "description": "ISO-8601 date-time string for the earliest selectable date-time (inclusive). Each endpoint of the value is an instant, so the bound is an instant too."
    },
    "maxDateTimeProp": {
      "type": "string",
      "description": "ISO-8601 date-time string for the latest selectable date-time (inclusive)"
    },
    "dayAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "monthAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "yearAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "hourAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "minuteAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "dayPeriodAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "rangeDateTimeInput"
    },
    "path": {
      "$ref": "../core/common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../core/common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "defaultValue": {
      "type": "array",
      "items": {
        "$ref": "../ranges.schema.json#/$defs/dateTimeRange"
      }
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "separator": {
          "$ref": "#/$defs/separatorProp"
        },
        "removePillAriaLabel": {
          "$ref": "#/$defs/removePillAriaLabelProp"
        },
        "startDateTimeAriaLabel": {
          "$ref": "#/$defs/startDateTimeAriaLabelProp"
        },
        "endDateTimeAriaLabel": {
          "$ref": "#/$defs/endDateTimeAriaLabelProp"
        },
        "hourFormat": {
          "$ref": "#/$defs/hourFormatProp"
        },
        "minuteStep": {
          "$ref": "#/$defs/minuteStepProp"
        },
        "invalidDateMessage": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "minDateTime": {
          "$ref": "#/$defs/minDateTimeProp"
        },
        "maxDateTime": {
          "$ref": "#/$defs/maxDateTimeProp"
        },
        "minDateTimeMessage": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "maxDateTimeMessage": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "incompleteMessage": {
          "$ref": "../core/common.schema.json#/$defs/localizable",
          "description": "Error surfaced when focus leaves the widget with a partially filled entry behind; the value goes to null so validators report it even on non-required fields."
        },
        "dayAriaLabel": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "monthAriaLabel": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "yearAriaLabel": {
          "$ref": "#/$defs/yearAriaLabelProp"
        },
        "hourAriaLabel": {
          "$ref": "#/$defs/hourAriaLabelProp"
        },
        "minuteAriaLabel": {
          "$ref": "#/$defs/minuteAriaLabelProp"
        },
        "dayPeriodAriaLabel": {
          "$ref": "#/$defs/dayPeriodAriaLabelProp"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^separator\\.[^.]+$": {
          "$ref": "#/$defs/separatorProp"
        },
        "^removePillAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/removePillAriaLabelProp"
        },
        "^startDateTimeAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/startDateTimeAriaLabelProp"
        },
        "^endDateTimeAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/endDateTimeAriaLabelProp"
        },
        "^hourFormat\\.[^.]+$": {
          "$ref": "#/$defs/hourFormatProp"
        },
        "^minuteStep\\.[^.]+$": {
          "$ref": "#/$defs/minuteStepProp"
        },
        "^invalidDateMessage\\.[^.]+$": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "^minDateTime\\.[^.]+$": {
          "$ref": "#/$defs/minDateTimeProp"
        },
        "^maxDateTime\\.[^.]+$": {
          "$ref": "#/$defs/maxDateTimeProp"
        },
        "^minDateTimeMessage\\.[^.]+$": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "^maxDateTimeMessage\\.[^.]+$": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "^incompleteMessage\\.[^.]+$": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        },
        "^dayAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "^monthAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "^yearAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/yearAriaLabelProp"
        },
        "^hourAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/hourAriaLabelProp"
        },
        "^minuteAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/minuteAriaLabelProp"
        },
        "^dayPeriodAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/dayPeriodAriaLabelProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
