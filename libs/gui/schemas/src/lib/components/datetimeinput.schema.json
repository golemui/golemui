{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/datetimeinput.schema.json",
  "title": "DateTimeInput Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "iconProp": {
      "type": "string"
    },
    "hourFormatProp": {
      "enum": ["12", "24"]
    },
    "minuteStepProp": {
      "type": "number",
      "minimum": 1
    },
    "minDateProp": {
      "type": "string"
    },
    "maxDateProp": {
      "type": "string"
    },
    "minTimeProp": {
      "type": "string"
    },
    "maxTimeProp": {
      "type": "string"
    },
    "dayAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "monthAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "yearAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "hourAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "minuteAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "dayPeriodAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "dateTimeInput"
    },
    "path": {
      "$ref": "../common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "props": {
      "type": "object",
      "properties": {
        "invalidDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "hourFormat": {
          "$ref": "#/$defs/hourFormatProp"
        },
        "minuteStep": {
          "$ref": "#/$defs/minuteStepProp"
        },
        "minDate": {
          "$ref": "#/$defs/minDateProp"
        },
        "maxDate": {
          "$ref": "#/$defs/maxDateProp"
        },
        "minTime": {
          "$ref": "#/$defs/minTimeProp"
        },
        "maxTime": {
          "$ref": "#/$defs/maxTimeProp"
        },
        "minDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "maxDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "minTimeMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "maxTimeMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "dayAriaLabel": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "monthAriaLabel": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "yearAriaLabel": {
          "$ref": "#/$defs/yearAriaLabelProp"
        },
        "hourAriaLabel": {
          "$ref": "#/$defs/hourAriaLabelProp"
        },
        "minuteAriaLabel": {
          "$ref": "#/$defs/minuteAriaLabelProp"
        },
        "dayPeriodAriaLabel": {
          "$ref": "#/$defs/dayPeriodAriaLabelProp"
        }
      },
      "patternProperties": {
        "^invalidDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^minDate\\.[^.]+$": {
          "$ref": "#/$defs/minDateProp"
        },
        "^maxDate\\.[^.]+$": {
          "$ref": "#/$defs/maxDateProp"
        },
        "^minTime\\.[^.]+$": {
          "$ref": "#/$defs/minTimeProp"
        },
        "^maxTime\\.[^.]+$": {
          "$ref": "#/$defs/maxTimeProp"
        },
        "^minDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^maxDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^minTimeMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^maxTimeMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^hourFormat\\.[^.]+$": {
          "$ref": "#/$defs/hourFormatProp"
        },
        "^minuteStep\\.[^.]+$": {
          "$ref": "#/$defs/minuteStepProp"
        },
        "^dayAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "^monthAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "^yearAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/yearAriaLabelProp"
        },
        "^hourAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/hourAriaLabelProp"
        },
        "^minuteAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/minuteAriaLabelProp"
        },
        "^dayPeriodAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/dayPeriodAriaLabelProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
