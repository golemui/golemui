{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/password.schema.json",
  "title": "Password Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "hintProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "placeholderProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "iconProp": {
      "type": "string"
    },
    "showPasswordIconProp": {
      "type": "string"
    },
    "hidePasswordIconProp": {
      "type": "string"
    },
    "showPasswordLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "hidePasswordLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "autocompleteProp": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "password"
    },
    "path": {
      "$ref": "../core/common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../core/common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    },
    "defaultValue": {
      "type": "string"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "placeholder": {
          "$ref": "#/$defs/placeholderProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "showPasswordIcon": {
          "$ref": "#/$defs/showPasswordIconProp"
        },
        "hidePasswordIcon": {
          "$ref": "#/$defs/hidePasswordIconProp"
        },
        "showPasswordLabel": {
          "$ref": "#/$defs/showPasswordLabelProp"
        },
        "hidePasswordLabel": {
          "$ref": "#/$defs/hidePasswordLabelProp"
        },
        "autocomplete": {
          "$ref": "#/$defs/autocompleteProp"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^placeholder\\.[^.]+$": {
          "$ref": "#/$defs/placeholderProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^showPasswordIcon\\.[^.]+$": {
          "$ref": "#/$defs/showPasswordIconProp"
        },
        "^hidePasswordIcon\\.[^.]+$": {
          "$ref": "#/$defs/hidePasswordIconProp"
        },
        "^showPasswordLabel\\.[^.]+$": {
          "$ref": "#/$defs/showPasswordLabelProp"
        },
        "^hidePasswordLabel\\.[^.]+$": {
          "$ref": "#/$defs/hidePasswordLabelProp"
        },
        "^autocomplete\\.[^.]+$": {
          "$ref": "#/$defs/autocompleteProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../core/validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
