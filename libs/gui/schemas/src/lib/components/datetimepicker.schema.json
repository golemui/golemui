{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/components/datetimepicker.schema.json",
  "title": "DateTimePicker Widget",
  "type": "object",
  "$defs": {
    "labelDef": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "disabledDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../common.schema.json#/$defs/boolOrWhen"
    },
    "hintProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "iconProp": {
      "type": "string"
    },
    "prevMonthIconProp": {
      "type": "string"
    },
    "nextMonthIconProp": {
      "type": "string"
    },
    "prevMonthAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "nextMonthAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "toggleAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "selectYearAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "yearGridAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "dayAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "monthAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "yearAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "hourAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "minuteAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "dayPeriodAriaLabelProp": {
      "$ref": "../common.schema.json#/$defs/localizable"
    },
    "dayFormatProp": {
      "description": "Formatting of day numbers in the calendar grid (`numeric` = 1–31, `2-digit` = 01–31)",
      "enum": ["numeric", "2-digit"]
    },
    "weekdayFormatProp": {
      "description": "Formatting of weekday column headers (`short` = Mon, `long` = Monday, `narrow` = M)",
      "enum": ["short", "long", "narrow"]
    },
    "monthFormatProp": {
      "description": "Formatting of the month heading (`long` = January, `short` = Jan, `narrow` = J, `numeric` = 1, `2-digit` = 01)",
      "enum": ["numeric", "2-digit", "long", "short", "narrow"]
    },
    "minDateProp": {
      "type": "string",
      "description": "ISO-8601 date string for the earliest selectable date (inclusive)"
    },
    "maxDateProp": {
      "type": "string",
      "description": "ISO-8601 date string for the latest selectable date (inclusive)"
    },
    "numberOfMonthsProp": {
      "type": "number",
      "description": "Number of month panels to display side by side. Defaults to 1. The time row and grid render on the first panel only."
    },
    "disabledRangesProp": {
      "type": "array",
      "description": "Date ranges that are shown but cannot be selected",
      "items": {
        "$ref": "../common.schema.json#/$defs/dateRange"
      }
    },
    "hourFormatProp": {
      "enum": ["12", "24"]
    },
    "allowCustomTimeProp": {
      "type": "boolean"
    },
    "minuteStepProp": {
      "type": "number",
      "minimum": 1
    },
    "isoTimeProp": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
    },
    "disabledTimeRangesProp": {
      "type": "array",
      "description": "Time ranges rendered disabled; entries optionally scope to a date and/or weekdays",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "#/$defs/isoTimeProp"
          },
          "end": {
            "$ref": "#/$defs/isoTimeProp"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO date: the range only applies on that date"
          },
          "weekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "description": "Date.prototype.getDay() numbering: 0=Sunday … 6=Saturday"
          }
        },
        "required": ["start", "end"],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "dateTimePicker"
    },
    "path": {
      "$ref": "../common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "props": {
      "type": "object",
      "properties": {
        "invalidDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "minDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "maxDateMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "disabledDateRangeMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "minTimeMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "maxTimeMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "disabledTimeRangeMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "noAvailableTimesMessage": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "incompleteMessage": {
          "$ref": "../common.schema.json#/$defs/localizable",
          "description": "Error surfaced when focus leaves the widget with a partially filled entry behind; the value goes to null so validators report it even on non-required fields."
        },
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "icon": {
          "$ref": "#/$defs/iconProp"
        },
        "prevMonthIcon": {
          "$ref": "#/$defs/prevMonthIconProp"
        },
        "nextMonthIcon": {
          "$ref": "#/$defs/nextMonthIconProp"
        },
        "prevMonthAriaLabel": {
          "$ref": "#/$defs/prevMonthAriaLabelProp"
        },
        "nextMonthAriaLabel": {
          "$ref": "#/$defs/nextMonthAriaLabelProp"
        },
        "toggleAriaLabel": {
          "$ref": "#/$defs/toggleAriaLabelProp"
        },
        "selectYearAriaLabel": {
          "$ref": "#/$defs/selectYearAriaLabelProp"
        },
        "yearGridAriaLabel": {
          "$ref": "#/$defs/yearGridAriaLabelProp"
        },
        "dayAriaLabel": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "monthAriaLabel": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "yearAriaLabel": {
          "$ref": "#/$defs/yearAriaLabelProp"
        },
        "hourAriaLabel": {
          "$ref": "#/$defs/hourAriaLabelProp"
        },
        "minuteAriaLabel": {
          "$ref": "#/$defs/minuteAriaLabelProp"
        },
        "dayPeriodAriaLabel": {
          "$ref": "#/$defs/dayPeriodAriaLabelProp"
        },
        "dayFormat": {
          "$ref": "#/$defs/dayFormatProp"
        },
        "weekdayFormat": {
          "$ref": "#/$defs/weekdayFormatProp"
        },
        "monthFormat": {
          "$ref": "#/$defs/monthFormatProp"
        },
        "minDate": {
          "$ref": "#/$defs/minDateProp"
        },
        "maxDate": {
          "$ref": "#/$defs/maxDateProp"
        },
        "numberOfMonths": {
          "$ref": "#/$defs/numberOfMonthsProp"
        },
        "disabledRanges": {
          "$ref": "#/$defs/disabledRangesProp"
        },
        "hourFormat": {
          "$ref": "#/$defs/hourFormatProp"
        },
        "minuteStep": {
          "$ref": "#/$defs/minuteStepProp"
        },
        "minTime": {
          "$ref": "#/$defs/isoTimeProp"
        },
        "maxTime": {
          "$ref": "#/$defs/isoTimeProp"
        },
        "disabledTimeRanges": {
          "$ref": "#/$defs/disabledTimeRangesProp"
        },
        "allowCustomTime": {
          "$ref": "#/$defs/allowCustomTimeProp"
        }
      },
      "patternProperties": {
        "^invalidDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^minDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^maxDateMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^disabledDateRangeMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^minTimeMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^maxTimeMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^disabledTimeRangeMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^noAvailableTimesMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^incompleteMessage\\.[^.]+$": {
          "$ref": "../common.schema.json#/$defs/localizable"
        },
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^icon\\.[^.]+$": {
          "$ref": "#/$defs/iconProp"
        },
        "^prevMonthIcon\\.[^.]+$": {
          "$ref": "#/$defs/prevMonthIconProp"
        },
        "^nextMonthIcon\\.[^.]+$": {
          "$ref": "#/$defs/nextMonthIconProp"
        },
        "^prevMonthAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/prevMonthAriaLabelProp"
        },
        "^nextMonthAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/nextMonthAriaLabelProp"
        },
        "^toggleAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/toggleAriaLabelProp"
        },
        "^selectYearAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/selectYearAriaLabelProp"
        },
        "^yearGridAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/yearGridAriaLabelProp"
        },
        "^dayAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/dayAriaLabelProp"
        },
        "^monthAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/monthAriaLabelProp"
        },
        "^yearAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/yearAriaLabelProp"
        },
        "^hourAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/hourAriaLabelProp"
        },
        "^minuteAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/minuteAriaLabelProp"
        },
        "^dayPeriodAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/dayPeriodAriaLabelProp"
        },
        "^dayFormat\\.[^.]+$": {
          "$ref": "#/$defs/dayFormatProp"
        },
        "^weekdayFormat\\.[^.]+$": {
          "$ref": "#/$defs/weekdayFormatProp"
        },
        "^monthFormat\\.[^.]+$": {
          "$ref": "#/$defs/monthFormatProp"
        },
        "^minDate\\.[^.]+$": {
          "$ref": "#/$defs/minDateProp"
        },
        "^maxDate\\.[^.]+$": {
          "$ref": "#/$defs/maxDateProp"
        },
        "^numberOfMonths\\.[^.]+$": {
          "$ref": "#/$defs/numberOfMonthsProp"
        },
        "^disabledRanges\\.[^.]+$": {
          "$ref": "#/$defs/disabledRangesProp"
        },
        "^hourFormat\\.[^.]+$": {
          "$ref": "#/$defs/hourFormatProp"
        },
        "^minuteStep\\.[^.]+$": {
          "$ref": "#/$defs/minuteStepProp"
        },
        "^minTime\\.[^.]+$": {
          "$ref": "#/$defs/isoTimeProp"
        },
        "^maxTime\\.[^.]+$": {
          "$ref": "#/$defs/isoTimeProp"
        },
        "^disabledTimeRanges\\.[^.]+$": {
          "$ref": "#/$defs/disabledTimeRangesProp"
        },
        "^allowCustomTime\\.[^.]+$": {
          "$ref": "#/$defs/allowCustomTimeProp"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
