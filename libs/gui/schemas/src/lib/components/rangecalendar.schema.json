{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/rangecalendar.schema.json",
  "title": "RangeCalendar Widget",
  "type": "object",
  "$defs": {
    "disabledDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "readonlyDef": {
      "$ref": "../core/common.schema.json#/$defs/boolOrWhen"
    },
    "labelDef": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "hintProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "prevMonthIconProp": {
      "type": "string"
    },
    "nextMonthIconProp": {
      "type": "string"
    },
    "prevMonthAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "nextMonthAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "selectYearAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "yearGridAriaLabelProp": {
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "removePillAriaLabelProp": {
      "description": "Accessible label for the button that clears the selected range pill",
      "$ref": "../core/common.schema.json#/$defs/localizable"
    },
    "dayFormatProp": {
      "description": "Formatting of day numbers in the calendar grid (`numeric` = 1–31, `2-digit` = 01–31)",
      "enum": ["numeric", "2-digit"]
    },
    "weekdayFormatProp": {
      "description": "Formatting of weekday column headers (`short` = Mon, `long` = Monday, `narrow` = M)",
      "enum": ["short", "long", "narrow"]
    },
    "monthFormatProp": {
      "description": "Formatting of the month heading (`long` = January, `short` = Jan, `narrow` = J, `numeric` = 1, `2-digit` = 01)",
      "enum": ["numeric", "2-digit", "long", "short", "narrow"]
    },
    "minDateProp": {
      "type": "string",
      "description": "ISO-8601 date string for the earliest selectable date (inclusive)"
    },
    "maxDateProp": {
      "type": "string",
      "description": "ISO-8601 date string for the latest selectable date (inclusive)"
    },
    "numberOfMonthsProp": {
      "type": "number",
      "description": "Number of month panels to display side by side. Defaults to 1."
    },
    "disabledRangesProp": {
      "type": "array",
      "description": "Date ranges that are shown but cannot be selected",
      "items": {
        "$ref": "../ranges.schema.json#/$defs/dateRange"
      }
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "input"
    },
    "type": {
      "const": "rangeCalendar"
    },
    "path": {
      "$ref": "../core/common.schema.json#/$defs/dotPath"
    },
    "label": {
      "$ref": "#/$defs/labelDef"
    },
    "disabled": {
      "$ref": "#/$defs/disabledDef"
    },
    "readonly": {
      "$ref": "#/$defs/readonlyDef"
    },
    "on": {
      "$ref": "../core/common.schema.json#/$defs/on"
    },
    "validator": {
      "$ref": "../validators.schema.json#/$defs/validator"
    },
    "props": {
      "type": "object",
      "properties": {
        "hint": {
          "$ref": "#/$defs/hintProp"
        },
        "prevMonthIcon": {
          "$ref": "#/$defs/prevMonthIconProp"
        },
        "nextMonthIcon": {
          "$ref": "#/$defs/nextMonthIconProp"
        },
        "prevMonthAriaLabel": {
          "$ref": "#/$defs/prevMonthAriaLabelProp"
        },
        "nextMonthAriaLabel": {
          "$ref": "#/$defs/nextMonthAriaLabelProp"
        },
        "selectYearAriaLabel": {
          "$ref": "#/$defs/selectYearAriaLabelProp"
        },
        "yearGridAriaLabel": {
          "$ref": "#/$defs/yearGridAriaLabelProp"
        },
        "removePillAriaLabel": {
          "$ref": "#/$defs/removePillAriaLabelProp"
        },
        "dayFormat": {
          "$ref": "#/$defs/dayFormatProp"
        },
        "weekdayFormat": {
          "$ref": "#/$defs/weekdayFormatProp"
        },
        "monthFormat": {
          "$ref": "#/$defs/monthFormatProp"
        },
        "minDate": {
          "$ref": "#/$defs/minDateProp"
        },
        "maxDate": {
          "$ref": "#/$defs/maxDateProp"
        },
        "numberOfMonths": {
          "$ref": "#/$defs/numberOfMonthsProp"
        },
        "disabledRanges": {
          "$ref": "#/$defs/disabledRangesProp"
        },
        "disabledDateRangeMessage": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        }
      },
      "patternProperties": {
        "^hint\\.[^.]+$": {
          "$ref": "#/$defs/hintProp"
        },
        "^prevMonthIcon\\.[^.]+$": {
          "$ref": "#/$defs/prevMonthIconProp"
        },
        "^nextMonthIcon\\.[^.]+$": {
          "$ref": "#/$defs/nextMonthIconProp"
        },
        "^prevMonthAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/prevMonthAriaLabelProp"
        },
        "^nextMonthAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/nextMonthAriaLabelProp"
        },
        "^selectYearAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/selectYearAriaLabelProp"
        },
        "^yearGridAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/yearGridAriaLabelProp"
        },
        "^removePillAriaLabel\\.[^.]+$": {
          "$ref": "#/$defs/removePillAriaLabelProp"
        },
        "^dayFormat\\.[^.]+$": {
          "$ref": "#/$defs/dayFormatProp"
        },
        "^weekdayFormat\\.[^.]+$": {
          "$ref": "#/$defs/weekdayFormatProp"
        },
        "^monthFormat\\.[^.]+$": {
          "$ref": "#/$defs/monthFormatProp"
        },
        "^minDate\\.[^.]+$": {
          "$ref": "#/$defs/minDateProp"
        },
        "^maxDate\\.[^.]+$": {
          "$ref": "#/$defs/maxDateProp"
        },
        "^numberOfMonths\\.[^.]+$": {
          "$ref": "#/$defs/numberOfMonthsProp"
        },
        "^disabledRanges\\.[^.]+$": {
          "$ref": "#/$defs/disabledRangesProp"
        },
        "^disabledDateRangeMessage\\.[^.]+$": {
          "$ref": "../core/common.schema.json#/$defs/localizable"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^label\\.[^.]+$": {
      "$ref": "#/$defs/labelDef"
    },
    "^disabled\\.[^.]+$": {
      "$ref": "#/$defs/disabledDef"
    },
    "^readonly\\.[^.]+$": {
      "$ref": "#/$defs/readonlyDef"
    },
    "^validator\\.[^.]+$": {
      "$ref": "../validators.schema.json#/$defs/validator"
    }
  },
  "required": ["kind", "type", "path"],
  "unevaluatedProperties": false
}
