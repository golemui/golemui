{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/grid.schema.json",
  "title": "Grid Widget",
  "type": "object",
  "$defs": {
    "directionProp": {
      "enum": ["row", "column"],
      "description": "`column`, the default, stacks the children. `row` puts them on one line, sharing the width by their `size`."
    },
    "columnsProp": {
      "description": "Wraps the children in columns and overrides `direction`: that many equal columns, which a child spans by its `size`, or as many as fit with \"auto\".",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        {
          "const": "auto"
        }
      ]
    },
    "gapProp": {
      "enum": ["none", "xs", "sm", "md", "lg", "xl"],
      "description": "The space between the children. Defaults to `md`."
    },
    "justifyProp": {
      "enum": ["stretch", "start", "center", "end", "space-between"],
      "description": "How a row's children use its width. `stretch`, the default, shares it by `size`; any other value keeps each child at its own width and places them on the row."
    },
    "columnGapProp": {
      "type": "number",
      "deprecated": true,
      "description": "Deprecated: use `gap`. Pixels become the nearest gap step."
    },
    "rowGapProp": {
      "type": "number",
      "deprecated": true,
      "description": "Deprecated: use `gap`. Pixels become the nearest gap step."
    },
    "autoFitProp": {
      "type": "boolean",
      "deprecated": true,
      "description": "Deprecated: use `columns`. `false` is `columns: 12`; `true` is a row."
    },
    "alignProp": {
      "enum": [
        "center",
        "start",
        "end",
        "space-between",
        "space-around",
        "space-evenly",
        "stretch"
      ],
      "deprecated": true,
      "description": "Deprecated: use `justify`, which places the children along the row."
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "layout"
    },
    "type": {
      "const": "grid"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../widgets.schema.json#/$defs/formWidget"
      }
    },
    "props": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/directionProp"
        },
        "columns": {
          "$ref": "#/$defs/columnsProp"
        },
        "gap": {
          "$ref": "#/$defs/gapProp"
        },
        "justify": {
          "$ref": "#/$defs/justifyProp"
        },
        "columnGap": {
          "$ref": "#/$defs/columnGapProp"
        },
        "rowGap": {
          "$ref": "#/$defs/rowGapProp"
        },
        "autoFit": {
          "$ref": "#/$defs/autoFitProp"
        },
        "align": {
          "$ref": "#/$defs/alignProp"
        }
      },
      "patternProperties": {
        "^direction\\.[^.]+$": {
          "$ref": "#/$defs/directionProp"
        },
        "^columns\\.[^.]+$": {
          "$ref": "#/$defs/columnsProp"
        },
        "^gap\\.[^.]+$": {
          "$ref": "#/$defs/gapProp"
        },
        "^justify\\.[^.]+$": {
          "$ref": "#/$defs/justifyProp"
        },
        "^columnGap\\.[^.]+$": {
          "$ref": "#/$defs/columnGapProp"
        },
        "^rowGap\\.[^.]+$": {
          "$ref": "#/$defs/rowGapProp"
        },
        "^autoFit\\.[^.]+$": {
          "$ref": "#/$defs/autoFitProp"
        },
        "^align\\.[^.]+$": {
          "$ref": "#/$defs/alignProp"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["kind", "type", "children"],
  "unevaluatedProperties": false,
  "description": "A layout. With no direction it stacks its children; `direction: \"row\"` puts them on one line, sharing the width by `size`; `columns` wraps them in columns."
}
