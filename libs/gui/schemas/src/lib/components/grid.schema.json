{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/gui/components/grid.schema.json",
  "title": "Grid Widget",
  "type": "object",
  "$defs": {
    "directionProp": {
      "enum": ["row", "column"]
    },
    "columnGapProp": {
      "type": "number"
    },
    "rowGapProp": {
      "type": "number"
    },
    "autoFitProp": {
      "type": "boolean"
    },
    "alignProp": {
      "enum": ["center", "start", "end", "space-between", "space-around", "space-evenly", "stretch"]
    },
    "justifyProp": {
      "enum": ["center", "start", "end", "stretch"]
    }
  },
  "allOf": [
    {
      "$ref": "../core/common.schema.json#/$defs/baseWidget"
    }
  ],
  "properties": {
    "kind": {
      "const": "layout"
    },
    "type": {
      "const": "grid"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../widgets.schema.json#/$defs/formWidget"
      }
    },
    "props": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/directionProp"
        },
        "columnGap": {
          "$ref": "#/$defs/columnGapProp"
        },
        "rowGap": {
          "$ref": "#/$defs/rowGapProp"
        },
        "autoFit": {
          "$ref": "#/$defs/autoFitProp"
        },
        "align": {
          "$ref": "#/$defs/alignProp"
        },
        "justify": {
          "$ref": "#/$defs/justifyProp"
        }
      },
      "patternProperties": {
        "^direction\\.[^.]+$": {
          "$ref": "#/$defs/directionProp"
        },
        "^columnGap\\.[^.]+$": {
          "$ref": "#/$defs/columnGapProp"
        },
        "^rowGap\\.[^.]+$": {
          "$ref": "#/$defs/rowGapProp"
        },
        "^autoFit\\.[^.]+$": {
          "$ref": "#/$defs/autoFitProp"
        },
        "^align\\.[^.]+$": {
          "$ref": "#/$defs/alignProp"
        },
        "^justify\\.[^.]+$": {
          "$ref": "#/$defs/justifyProp"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["kind", "type", "children"],
  "unevaluatedProperties": false
}
