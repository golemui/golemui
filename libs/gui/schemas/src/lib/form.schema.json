{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golemui.com/schemas/form.schema.json",
  "title": "Golem Form DSL",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "states": {
      "type": "object",
      "description": "Named boolean conditions keyed by state name, each mapping to a reactive expression. States serve two purposes: (1) gating widget visibility via `include.in` / `exclude.from`; (2) overriding individual widget properties when a state is active by appending `\".<stateName>\"` to any property key — e.g. `\"label.myState\": \"Active label\"` or `\"props.hint.myState\": \"Active hint\"`. Root-level suffixable props: `label`, `disabled`, `readonly`, `validator`, `size`. Any key inside `props` can also be suffixed.",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/reactiveExpression"
      }
    },
    "form": {
      "type": "array",
      "description": "The ordered list of widgets that make up the form body",
      "items": {
        "$ref": "#/$defs/formWidget"
      }
    },
    "autocomplete": {
      "type": "string",
      "description": "HTML `autocomplete` attribute applied to the `<form>` element (e.g. `on`, `off`)"
    }
  },
  "required": ["form"],
  "additionalProperties": false,
  "$defs": {
    "chunkRef": {
      "type": "object",
      "description": "A reference to an external chunk file whose widget array will be inlined at this position in the form",
      "properties": {
        "$ref": { "type": "string", "description": "Relative path to a JSON chunk file" }
      },
      "required": ["$ref"],
      "additionalProperties": false
    },
    "formWidget": {
      "oneOf": [
        {
          "$ref": "./components/accordion.schema.json"
        },
        {
          "$ref": "./components/alert.schema.json"
        },
        {
          "$ref": "./components/button.schema.json"
        },
        {
          "$ref": "./components/calendar.schema.json"
        },
        {
          "$ref": "./components/checkbox.schema.json"
        },
        {
          "$ref": "./components/currency.schema.json"
        },
        {
          "$ref": "./components/dateinput.schema.json"
        },
        {
          "$ref": "./components/datetimeinput.schema.json"
        },
        {
          "$ref": "./components/datepicker.schema.json"
        },
        {
          "$ref": "./components/dropdown.schema.json"
        },
        {
          "$ref": "./components/list.schema.json"
        },
        {
          "$ref": "./components/markdown.schema.json"
        },
        {
          "$ref": "./components/markdowntext.schema.json"
        },
        {
          "$ref": "./components/number.schema.json"
        },
        {
          "$ref": "./components/password.schema.json"
        },
        {
          "$ref": "./components/radiogroup.schema.json"
        },
        {
          "$ref": "./components/rangecalendar.schema.json"
        },
        {
          "$ref": "./components/rangedateinput.schema.json"
        },
        {
          "$ref": "./components/rangedatepicker.schema.json"
        },
        {
          "$ref": "./components/repeater.schema.json"
        },
        {
          "$ref": "./components/select.schema.json"
        },
        {
          "$ref": "./components/flex.schema.json"
        },
        {
          "$ref": "./components/grid.schema.json"
        },
        {
          "$ref": "./components/tabs.schema.json"
        },
        {
          "$ref": "./components/tags.schema.json"
        },
        {
          "$ref": "./components/textarea.schema.json"
        },
        {
          "$ref": "./components/textinput.schema.json"
        },
        {
          "$ref": "./components/timeinput.schema.json"
        },
        {
          "$ref": "./components/timepicker.schema.json"
        },
        {
          "$ref": "./components/toggle.schema.json"
        },
        {
          "$ref": "./components/custom.schema.json"
        },
        {
          "$ref": "#/$defs/chunkRef"
        }
      ]
    }
  }
}
