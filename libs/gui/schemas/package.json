{
  "name": "@golemui/gui-schemas",
  "version": "0.0.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./json-schema": {
      "types": "./json-schema.d.ts",
      "import": "./json-schema.js",
      "require": "./json-schema.cjs"
    },
    "./schemas/*.schema.json": "./schemas/*.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "schemas",
    "*.js",
    "*.cjs",
    "*.d.ts",
    "*.md"
  ],
  "dependencies": {
    "@golemui/schemas": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/gui/schemas"
  }
}
