{
  "name": "@golemui/gui-validators",
  "version": "0.0.0",
  "description": "Validators for GolemUI dynamic forms: built-in rules for strings, numbers, booleans, arrays and files, plus your own custom validators. Open source (MIT).",
  "keywords": [
    "golemui",
    "dynamic-forms",
    "json-forms",
    "forms",
    "validation",
    "validators",
    "form-validation"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.umd.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.umd.cjs"
    }
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "index.umd.cjs",
    "*.md"
  ],
  "peerDependencies": {
    "zod": "^4.0.0",
    "@standard-schema/spec": "^1.0.0",
    "@golemui/core": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/gui/validators"
  }
}
