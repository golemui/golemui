{
  "formDefinition": {
    "$schema": "https://golemui.com/schemas/form.schema.json",
    "form": [
      {
        "kind": "input",
        "type": "repeater",
        "path": "addresses",
        "label": "Addresses",
        "props": {
          "addLabel": "Add address",
          "removeLabel": "Remove",
          "template": {
            "kind": "layout",
            "type": "grid",
            "props": {
              "gap": "sm"
            },
            "children": [
              {
                "kind": "input",
                "type": "textinput",
                "path": "addresses.items.street",
                "label": "Street",
                "validator": {
                  "type": "string",
                  "required": true
                }
              },
              {
                "kind": "input",
                "type": "textinput",
                "path": "addresses.items.city",
                "label": "City"
              }
            ]
          }
        }
      }
    ]
  },
  "unmapped": [],
  "diagnostics": [],
  "validation": {
    "valid": true,
    "errors": [],
    "warnings": [],
    "expressionWarnings": [],
    "interpolationWarnings": []
  }
}