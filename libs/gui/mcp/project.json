{
  "name": "gui-mcp",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/gui/mcp/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:impl", "impl:gui", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/gui/mcp",
        "configFile": "libs/gui/mcp/vite.config.ts"
      },
      "dependsOn": ["^build", "generate-validators"]
    },
    "generate-validators": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/tools/**/*",
        "{projectRoot}/src/json/schemas/index.ts",
        "{projectRoot}/src/json/schemas/validator-schemas.ts",
        "^production",
        {
          "externalDependencies": ["ajv"]
        }
      ],
      "outputs": ["{projectRoot}/src/json/schemas/generated/validators.js"],
      "options": {
        "command": "tsx --tsconfig ./libs/gui/mcp/tsconfig.json libs/gui/mcp/tools/generate-validators.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "vite:test": {
      "dependsOn": ["^build", "generate-validators"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
