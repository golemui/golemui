{
  "name": "@golemui/gui-mcp",
  "version": "0.0.0",
  "description": "MCP server for GolemUI dynamic forms: gives AI coding assistants schema validation and form generation for GolemUI form definitions. Open source (MIT).",
  "keywords": [
    "golemui",
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-agents",
    "dynamic-forms",
    "json-forms",
    "form-builder",
    "form",
    "json-schema"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib.js",
  "module": "./lib.js",
  "types": "./lib.d.ts",
  "exports": {
    ".": {
      "types": "./lib.d.ts",
      "import": "./lib.js"
    },
    "./json": {
      "types": "./json.d.ts",
      "import": "./json.js"
    }
  },
  "bin": {
    "golemui-mcp": "./cli.js"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "json",
    "dx",
    "shared",
    "*.md"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "typescript": "^5.9.2",
    "@golemui/gui-schemas": "*",
    "@golemui/schemas": "*",
    "@golemui/gui-shared": "*",
    "@golemui/gui-validators": "*",
    "@golemui/dx": "*",
    "@golemui/core": "*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.0.0",
    "@standard-schema/spec": "^1.0.0",
    "rxjs": "^7.8.0",
    "ts.data.json": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/gui/mcp"
  }
}
