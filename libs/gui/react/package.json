    "*.js",
    "*.md"
  ],
  "dependencies": {
    "@lit/react": "^1.0.8"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@golemui/react": "*",
    "@golemui/core": "*",
    "@golemui/gui-components": "*",
    "@golemui/gui-shared": "*",
    "@golemui/gui-validators": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/gui/react"
  }
}
