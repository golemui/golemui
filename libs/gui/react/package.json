{
  "name": "@golemui/gui-react",
  "version": "0.0.0",
  "description": "Dynamic forms from JSON in React: the GolemUI GuiForm component, with server-side rendering in React and Next.js. Open source (MIT).",
  "keywords": [
    "golemui",
    "dynamic-forms",
    "json-forms",
    "json-schema-form",
    "form-builder",
    "form-generator",
    "forms",
    "validation",
    "react",
    "react-forms",
    "nextjs",
    "ssr"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.umd.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.umd.cjs"
    }
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "index.umd.cjs",
    "*.js",
    "*.md"
  ],
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@golemui/react": "*",
    "@golemui/core": "*",
    "@golemui/gui-components": "*",
    "@golemui/gui-shared": "*",
    "@golemui/gui-validators": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/gui/react"
  }
}
