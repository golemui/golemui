{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "es2022",
    "verbatimModuleSyntax": true,
    "target": "es2022",
    "moduleResolution": "node",
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "ts-lit-plugin",
        "strict": true,
        "rules": {
          "no-unknown-tag-name": "error",
          "no-unknown-attribute": "error",
          "no-unknown-property": "error",
          "no-incompatible-type": "error"
        }
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.spec.jsx",
    "cypress/**/*",
    "cypress.config.ts",
    "**/*.cy.ts",
    "**/*.cy.js"
  ]
}
