{
  "name": "@golemui/gui-lit",
  "version": "0.0.0",
  "description": "Dynamic forms from JSON with Lit or vanilla JS: the GolemUI form element, with server-side rendering in Lit and Astro. Open source (MIT).",
  "keywords": [
    "golemui",
    "dynamic-forms",
    "json-forms",
    "json-schema-form",
    "form-builder",
    "form-generator",
    "forms",
    "validation",
    "lit",
    "web-components",
    "vanilla-js",
    "astro",
    "ssr"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.umd.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.umd.cjs"
    }
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "index.umd.cjs",
    "*.js",
    "*.md"
  ],
  "peerDependencies": {
    "@golemui/lit": "*",
    "@golemui/core": "*",
    "@golemui/gui-components": "*",
    "@golemui/gui-shared": "*",
    "@golemui/gui-validators": "*",
    "@lit/context": "^1.1.6",
    "lit-html": "^3.3.1",
    "lit": "^3.3.1",
    "rxjs": "^7.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/gui/lit"
  }
}
