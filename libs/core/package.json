{
  "name": "@golemui/core",
  "version": "0.0.0",
  "description": "Dynamic forms from JSON for React, Angular, Vue, Lit and vanilla JS: the framework-agnostic core of the GolemUI forms engine. Open source (MIT).",
  "keywords": [
    "golemui",
    "dynamic-forms",
    "json-forms",
    "json-schema-form",
    "form-builder",
    "form-generator",
    "forms",
    "validation",
    "react",
    "angular",
    "vue",
    "lit",
    "web-components",
    "typescript",
    "mcp"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.umd.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.umd.cjs"
    },
    "./internals": {
      "types": "./internals.d.ts",
      "import": "./internals.js",
      "require": "./internals.umd.cjs"
    }
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "index.umd.cjs",
    "internals.d.ts",
    "internals.js",
    "internals.umd.cjs",
    "*.js",
    "*.cjs",
    "*.md"
  ],
  "dependencies": {
    "ts.data.json": "^4.1.0"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0",
    "@standard-schema/spec": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/core"
  }
}
