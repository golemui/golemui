{
  "name": "@golemui/core",
  "version": "0.0.1",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js",
      "require": "./src/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "*.md"
  ],
  "peerDependencies": {
    "tslib": "^2.3.0",
    "subscript": "^9.1.0",
    "zod": "^3.25.0 || ^4.0.0",
    "rxjs": "^7.8.0",
    "@standard-schema/spec": "^1.0.0"
  }
}
