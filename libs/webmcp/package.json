{
  "name": "@golemui/webmcp",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Exposes GolemUI forms to browser AI agents through WebMCP (document.modelContext): each form becomes fill / submit tools driven by the real widgets and gated by the form's own validation.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./index.umd.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.umd.cjs"
    }
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "index.umd.cjs",
    "*.md"
  ],
  "keywords": [
    "webmcp",
    "model-context",
    "golemui",
    "forms",
    "ai",
    "agents"
  ],
  "peerDependencies": {
    "@golemui/core": "*",
    "rxjs": "^7.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/webmcp"
  }
}
