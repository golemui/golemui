{
  "name": "@golemui/dx",
  "version": "0.0.0",
  "description": "The typed form-authoring pipeline behind GolemUI widget sets: generates a gui.* style builder for your own widget set. Open source (MIT).",
  "keywords": [
    "golemui",
    "dynamic-forms",
    "form-builder",
    "forms",
    "typescript",
    "widget-set",
    "codegen"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.umd.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.umd.cjs"
    }
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "index.umd.cjs",
    "*.md"
  ],
  "dependencies": {
    "@golemui/core": "*",
    "@golemui/gui-validators": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/dx"
  }
}
