{
  "name": "@golemui/lit",
  "version": "0.0.0",
  "description": "Lit and web component bindings of the GolemUI forms engine, for building widget sets. For dynamic forms with Lit, install @golemui/gui-lit. Open source (MIT).",
  "keywords": [
    "golemui",
    "dynamic-forms",
    "json-forms",
    "forms",
    "lit",
    "web-components",
    "widget-set"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./internals": {
      "types": "./internals.d.ts",
      "import": "./internals.js",
      "require": "./internals.cjs"
    },
    "./ssr": {
      "types": "./ssr.d.ts",
      "import": "./ssr.js",
      "require": "./ssr.cjs"
    }
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "index.cjs",
    "internals.d.ts",
    "internals.js",
    "internals.cjs",
    "ssr.d.ts",
    "ssr.js",
    "ssr.cjs",
    "*.js",
    "*.cjs",
    "*.md"
  ],
  "dependencies": {
    "@golemui/dx": "*",
    "@golemui/lit-utils": "*"
  },
  "peerDependencies": {
    "@golemui/core": "*",
    "@lit/context": "^1.1.6",
    "@lit-labs/ssr": "^4.1.0",
    "lit": "^3.3.1",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@lit-labs/ssr": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/lit"
  }
}
