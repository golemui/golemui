{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://golemui.com/schemas/components/button.schema.json",
    "title": "Button Widget",
    "type": "object",
    "allOf": [
        {
            "$ref": "../common.schema.json#/definitions/baseWidget"
        }
    ],
    "properties": {
        "kind": {
            "const": "action"
        },
        "type": {
            "const": "button"
        },
        "label": {
            "$ref": "../common.schema.json#/definitions/localizable"
        },
        "disabled": {
            "oneOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "object",
                    "properties": {
                        "when": {
                            "$ref": "../common.schema.json#/definitions/reactiveExpression"
                        }
                    },
                    "required": [
                        "when"
                    ]
                }
            ]
        },
        "on": {
            "$ref": "../common.schema.json#/definitions/on"
        },
        "props": {
            "type": "object",
            "patternProperties": {
                "^.*\\..*$": {}
            }
        }
    },
    "required": [
        "kind",
        "type"
    ]
}