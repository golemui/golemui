{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://golemui.com/schemas/components/alert.schema.json",
    "title": "Alert Widget",
    "type": "object",
    "allOf": [
        {
            "$ref": "../common.schema.json#/definitions/baseWidget"
        }
    ],
    "properties": {
        "kind": {
            "const": "display"
        },
        "type": {
            "const": "alert"
        },
        "props": {
            "type": "object",
            "properties": {
                "text": {
                    "type": "string"
                },
                "level": {
                    "enum": [
                        "default",
                        "info",
                        "success",
                        "warning",
                        "error"
                    ]
                }
            },
            "required": [
                "text"
            ],
            "patternProperties": {
                "^.*\\..*$": {}
            }
        }
    },
    "required": [
        "kind",
        "type",
        "props"
    ]
}