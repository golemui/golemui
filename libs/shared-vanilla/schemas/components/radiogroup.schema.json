{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://golemui.com/schemas/components/radiogroup.schema.json",
    "title": "RadioGroup Widget",
    "type": "object",
    "allOf": [
        {
            "$ref": "../common.schema.json#/definitions/baseWidget"
        }
    ],
    "properties": {
        "kind": {
            "const": "input"
        },
        "type": {
            "const": "radiogroup"
        },
        "path": {
            "$ref": "../common.schema.json#/definitions/dotPath"
        },
        "label": {
            "$ref": "../common.schema.json#/definitions/localizable"
        },
        "on": {
            "$ref": "../common.schema.json#/definitions/on"
        },
        "props": {
            "type": "object",
            "properties": {
                "hint": {
                    "type": "string"
                },
                "options": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "label": {
                                "type": "string"
                            },
                            "value": {
                                "type": [
                                    "string",
                                    "number",
                                    "boolean",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "label",
                            "value"
                        ]
                    }
                },
                "labelField": {
                    "type": "string"
                },
                "valueField": {
                    "type": "string"
                }
            },
            "patternProperties": {
                "^.*\\..*$": {}
            }
        }
    },
    "required": [
        "kind",
        "type",
        "path"
    ]
}