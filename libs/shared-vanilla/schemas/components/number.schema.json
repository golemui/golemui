{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://golemui.com/schemas/components/number.schema.json",
    "title": "Number Widget",
    "type": "object",
    "allOf": [
        {
            "$ref": "../common.schema.json#/definitions/baseWidget"
        }
    ],
    "properties": {
        "kind": {
            "const": "input"
        },
        "type": {
            "const": "number"
        },
        "path": {
            "$ref": "../common.schema.json#/definitions/dotPath"
        },
        "label": {
            "$ref": "../common.schema.json#/definitions/localizable"
        },
        "disabled": {
            "oneOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "object",
                    "properties": {
                        "when": {
                            "$ref": "../common.schema.json#/definitions/reactiveExpression"
                        }
                    },
                    "required": [
                        "when"
                    ]
                }
            ]
        },
        "readonly": {
            "oneOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "object",
                    "properties": {
                        "when": {
                            "$ref": "../common.schema.json#/definitions/reactiveExpression"
                        }
                    },
                    "required": [
                        "when"
                    ]
                }
            ]
        },
        "on": {
            "$ref": "../common.schema.json#/definitions/on"
        },
        "defaultValue": {
            "type": "number"
        },
        "props": {
            "type": "object",
            "properties": {
                "placeholder": {
                    "type": "string"
                },
                "hint": {
                    "type": "string"
                },
                "step": {
                    "type": "number"
                },
                "minimum": {
                    "type": "number"
                },
                "maximum": {
                    "type": "number"
                },
                "autoGrow": {
                    "const": true
                }
            },
            "patternProperties": {
                "^.*\\..*$": {}
            }
        }
    },
    "required": [
        "kind",
        "type",
        "path"
    ]
}