{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://golemui.com/schemas/components/calendar.schema.json",
    "title": "Calendar Widget",
    "type": "object",
    "allOf": [
        {
            "$ref": "../common.schema.json#/definitions/baseWidget"
        }
    ],
    "properties": {
        "kind": {
            "const": "input"
        },
        "type": {
            "const": "calendar"
        },
        "path": {
            "$ref": "../common.schema.json#/definitions/dotPath"
        },
        "label": {
            "$ref": "../common.schema.json#/definitions/localizable"
        },
        "on": {
            "$ref": "../common.schema.json#/definitions/on"
        },
        "props": {
            "type": "object",
            "properties": {
                "hint": {
                    "type": "string"
                },
                "prevMonthIcon": {
                    "type": "string"
                },
                "nextMonthIcon": {
                    "type": "string"
                },
                "prevMonthAriaLabel": {
                    "type": "string"
                },
                "nextMonthAriaLabel": {
                    "type": "string"
                },
                "dayFormat": {
                    "enum": [
                        "numeric",
                        "2-digit"
                    ]
                },
                "weekdayFormat": {
                    "enum": [
                        "short",
                        "long",
                        "narrow"
                    ]
                },
                "monthFormat": {
                    "enum": [
                        "numeric",
                        "2-digit",
                        "long",
                        "short",
                        "narrow"
                    ]
                },
                "minDate": {
                    "type": "string"
                },
                "maxDate": {
                    "type": "string"
                },
                "numberOfMonths": {
                    "type": "number"
                }
            },
            "patternProperties": {
                "^.*\\..*$": {}
            }
        }
    },
    "required": [
        "kind",
        "type",
        "path"
    ]
}