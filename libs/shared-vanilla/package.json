{
  "name": "@golemui/shared-vanilla",
  "version": "0.0.1",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "import": "./*.js",
      "require": "./*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.js",
    "index.cjs",
    "*.js",
    "*.cjs",
    "*.md"
  ],
  "peerDependencies": {
    "@golemui/core": "*",
    "tslib": "^2.3.0"
  }
}
