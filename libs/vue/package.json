{
  "name": "@golemui/vue",
  "version": "0.0.0",
  "description": "Vue bindings of the GolemUI forms engine, for building widget sets. For dynamic forms in Vue, install @golemui/gui-vue. Open source (MIT).",
  "keywords": [
    "golemui",
    "dynamic-forms",
    "json-forms",
    "forms",
    "vue",
    "widget-set"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.umd.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.umd.cjs"
    }
  },
  "files": [
    "lib",
    "index.d.ts",
    "index.js",
    "index.umd.cjs",
    "*.md"
  ],
  "dependencies": {
    "@golemui/dx": "*"
  },
  "peerDependencies": {
    "vue": ">=3.3.0",
    "@golemui/core": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git",
    "directory": "libs/vue"
  }
}
