{
  "name": "@golemui/source",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/golemui/golemui.git"
  },
  "license": "MIT",
  "scripts": {
    "format": "nx format:write --all",
    "precz": "nx run-many --target=lint --all --exclude=@golemui/source && nx format:write --all && git update-index --again",
    "cz": "czg checkbox",
    "reset:dev": "pkill -f 'astro dev' 2>/dev/null; pkill -f 'nx run-many' 2>/dev/null; lsof -ti:4220,4221,4222,4223,4321,4322,4323 2>/dev/null | xargs kill -9 2>/dev/null; rm -rf docs/.astro docs/node_modules/.astro node_modules/.astro; npx nx reset",
    "start:angular": "nx run angular-playground:serve",
    "start:lit": "nx run lit-playground:serve",
    "start:react": "nx run react-playground:serve",
    "start:vue": "nx run vue-playground:serve",
    "start:mcp": "npx nx run gui-mcp:build && npx @modelcontextprotocol/inspector node dist/libs/gui/mcp/cli.js",
    "test:angular": "nx run gui-angular:component-test --watch",
    "test:lit": "nx run gui-lit:component-test --watch",
    "test:react": "nx run gui-react:component-test --watch",
    "test:vue": "nx run gui-vue:component-test --watch",
    "test:all": "nx run-many --target=component-test",
    "test:affected": "nx affected --target=component-test",
    "lint:affected": "nx affected -t lint test --no-cloud",
    "build:libs": "npx nx run-many --target=build --projects=libs/**/*",
    "build:styles": "sh ./tools/build-sass.sh",
    "cz:breaking": "npm run precz && czg break",
    "release": "npm run build:libs && npm run build:styles && tsx tools/release.ts"
  },
  "private": true,
