{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowSyntheticDefaultImports": true,
    "types": ["node", "vite/client", "vue-shim"],
    "sourceMap": false,
    "importHelpers": false,
    "typeRoots": ["./node_modules/@types", "./skills/.types", "./node_modules"]
  },
  "include": []
}
