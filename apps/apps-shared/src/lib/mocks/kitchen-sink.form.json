{
  "$schema": "../../../../../libs/gui/schemas/src/lib/form.schema.json",
  "states": {
    "limitReached": "$form.repeaters.users?.length === 5",
    "hasSubregionSelect": "!!$form.selects.subregion",
    "hasSubregionRadiogroup": "!!$form.radiogroups.subregion"
  },
  "form": [
    {
      "kind": "display",
      "type": "heading",
      "props": {
        "text": "KITCHEN SINK",
        "level": 1
      }
    },
    {
      "kind": "layout",
      "type": "tabs",
      "props": {
        "defaultOpen": "tabAlert",
        "tabs": [
          { "label": "Accordion Layout", "uid": "tabAccordion" },
          { "label": "Alert Component", "uid": "tabAlert" },
          { "label": "Button Component", "uid": "tabButton" },
          { "label": "Calendar Component", "uid": "tabCalendar" },
          { "label": "Checkbox Component", "uid": "tabCheckbox" },
          { "label": "Currency Component", "uid": "tabCurrency" },
          { "label": "Date Input Component", "uid": "tabDateInput" },
          { "label": "Date Picker Component", "uid": "tabDatePicker" },
          { "label": "Date Time Calendar Component", "uid": "tabDateTimeCalendar" },
          { "label": "Date Time Input Component", "uid": "tabDateTimeInput" },
          { "label": "Date Time Picker Component", "uid": "tabDateTimePicker" },
          { "label": "Dropdown Component", "uid": "tabDropdown" },
          { "label": "Flex Layout", "uid": "tabFlex" },
          { "label": "Grid Layout", "uid": "tabGrid" },
          { "label": "List Component", "uid": "tabList" },
          { "label": "Markdown Component", "uid": "tabMarkdown" },
          { "label": "Markdown Text Component", "uid": "tabMarkdownText" },
          { "label": "Number Component", "uid": "tabNumber" },
          { "label": "Password Component", "uid": "tabPassword" },
          { "label": "Radiogroup Component", "uid": "tabRadiogroup" },
          { "label": "Range Calendar Component", "uid": "tabRangeCalendar" },
          { "label": "Range Date Input Component", "uid": "tabRangeDateInput" },
          { "label": "Range Time Input Component", "uid": "tabRangeTimeInput" },
          { "label": "Range Date Picker Component", "uid": "tabRangeDatePicker" },
          { "label": "Repeater Component", "uid": "tabRepeater" },
          { "label": "Select Component", "uid": "tabSelect" },
          { "label": "Tags Component", "uid": "tabTags" },
          { "label": "Textarea Component", "uid": "tabTextarea" },
          { "label": "Textinput Component", "uid": "tabTextinput" },
          { "label": "Time Picker Component", "uid": "tabTimePicker" },
          { "label": "Time Input Component", "uid": "tabTimeInput" },
          { "label": "Toggle Component", "uid": "tabToggle" }
        ]
      },
      "on": { "change": "onTabEvent" },
      "children": [
        { "$ref": "./tabs/alert.form-chunk.json" },
        { "$ref": "./tabs/button.form-chunk.json" },
        { "$ref": "./tabs/markdown-text.form-chunk.json" },
        { "$ref": "./tabs/accordion.form-chunk.json" },
        { "$ref": "./tabs/flex.form-chunk.json" },
        { "$ref": "./tabs/grid.form-chunk.json" },
        { "$ref": "./tabs/textinput.form-chunk.json" },
        { "$ref": "./tabs/password.form-chunk.json" },
        { "$ref": "./tabs/number.form-chunk.json" },
        { "$ref": "./tabs/currency.form-chunk.json" },
        { "$ref": "./tabs/dateinput.form-chunk.json" },
        { "$ref": "./tabs/calendar.form-chunk.json" },
        { "$ref": "./tabs/datepicker.form-chunk.json" },
        { "$ref": "./tabs/rangedateinput.form-chunk.json" },
        { "$ref": "./tabs/rangetimeinput.form-chunk.json" },
        { "$ref": "./tabs/rangecalendar.form-chunk.json" },
        { "$ref": "./tabs/rangedatepicker.form-chunk.json" },
        { "$ref": "./tabs/timeinput.form-chunk.json" },
        { "$ref": "./tabs/timepicker.form-chunk.json" },
        { "$ref": "./tabs/datetimeinput.form-chunk.json" },
        { "$ref": "./tabs/datetimecalendar.form-chunk.json" },
        { "$ref": "./tabs/datetimepicker.form-chunk.json" },
        { "$ref": "./tabs/markdown.form-chunk.json" },
        { "$ref": "./tabs/textarea.form-chunk.json" },
        { "$ref": "./tabs/checkbox.form-chunk.json" },
        { "$ref": "./tabs/toggle.form-chunk.json" },
        { "$ref": "./tabs/radiogroup.form-chunk.json" },
        { "$ref": "./tabs/select.form-chunk.json" },
        { "$ref": "./tabs/dropdown.form-chunk.json" },
        { "$ref": "./tabs/list.form-chunk.json" },
        { "$ref": "./tabs/repeater.form-chunk.json" },
        { "$ref": "./tabs/tags.form-chunk.json" }
      ]
    },
    {
      "uid": "submit-button",
      "kind": "action",
      "type": "button",
      "actionType": "submit",
      "label": "Submit",
      "props": {
        "icon": "save",
        "iconPosition": "right"
      },
      "disabled": { "when": "$formIsInvalid" }
    }
  ]
}
