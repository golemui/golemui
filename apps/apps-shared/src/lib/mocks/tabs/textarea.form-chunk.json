{
  "$schema": "../../../../../../libs/gui/shared/src/lib/schemas/layout-widget.schema.json",
  "uid": "tabTextarea",
  "kind": "layout",
  "type": "flex",
  "children": [
    {
      "kind": "input",
      "type": "textarea",
      "path": "textarea",
      "props": {
        "autocomplete": "off"
      }
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "textareaDisabled",
      "disabled": true,
      "readonly": true
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "textareaAutoGrow",
      "props": {
        "placeholder": "This textarea will grow automatically when you type in it.",
        "autoGrow": true,
        "minimumHeight": 80
      }
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "textareaWithHint",
      "props": {
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number"
      }
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "textareaWithIcon",
      "props": {
        "icon": "phone_callback",
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number",
        "counterMode": "current",
        "minimumHeight": 80
      },
      "validator": { "type": "string", "maxLength": 10, "required": true }
    }
  ]
}
