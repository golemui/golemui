{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabTextarea",
  "kind": "layout",
  "type": "grid",
  "children": [
    {
      "kind": "input",
      "type": "textarea",
      "path": "textarea",
      "label": "Textarea",
      "props": {
        "autocomplete": "off"
      }
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "textareaDisabled",
      "label": "Disabled textarea",
      "disabled": true,
      "readonly": true
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "textareaAutoGrow",
      "label": "Auto-growing textarea",
      "props": {
        "placeholder": "This textarea will grow automatically when you type in it.",
        "autoGrow": true,
        "minimumHeight": 80
      }
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "textareaWithHint",
      "label": "Textarea with hint",
      "props": {
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number"
      }
    },
    {
      "kind": "input",
      "type": "textarea",
      "path": "textareaWithCounter",
      "label": "Textarea with counter",
      "props": {
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number",
        "counterMode": "current",
        "minimumHeight": 80
      },
      "validator": { "type": "string", "maxLength": 10, "required": true }
    }
  ]
}
