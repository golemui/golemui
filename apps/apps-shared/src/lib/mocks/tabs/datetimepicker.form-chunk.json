{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabDateTimePicker",
  "kind": "layout",
  "type": "flex",
  "children": [
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerEmpty",
      "label": "Empty",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30,
        "allowCustomTime": true
      }
    },
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerDefault",
      "defaultValue": "2026-02-13T09:30:00",
      "label": "With default value",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerDisabled",
      "defaultValue": "2026-02-13T09:30:00",
      "disabled": true,
      "label": "Disabled",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerReadonly",
      "defaultValue": "2026-02-13T09:30:00",
      "readonly": true,
      "label": "Read only",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerValidation",
      "label": "Required (validation)",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30
      },
      "validator": {
        "type": "string",
        "required": true,
        "format": "date-time"
      }
    },
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerDisabledRanges",
      "defaultValue": "2026-02-16T09:30:00",
      "label": "Disabled date & time ranges",
      "props": {
        "icon": "calendar_month",
        "allowCustomTime": true,
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30,
        "minDate": "2026-02-01",
        "maxDate": "2026-07-31",
        "disabledRanges": [
          {
            "start": "2026-02-09",
            "end": "2026-02-10"
          },
          {
            "start": "2026-02-17"
          }
        ],
        "disabledTimeRanges": [
          {
            "start": "13:00:00",
            "end": "14:00:00",
            "weekdays": [1, 2, 3, 4, 5]
          },
          {
            "start": "09:00:00",
            "end": "10:30:00",
            "date": "2026-02-13"
          }
        ]
      }
    }
  ]
}
