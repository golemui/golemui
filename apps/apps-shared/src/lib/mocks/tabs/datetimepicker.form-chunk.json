{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabDateTimePicker",
  "kind": "layout",
  "type": "flex",
  "children": [
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerEmpty",
      "label": "Empty",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerDefault",
      "defaultValue": "2026-02-13T09:30:00",
      "label": "With default value",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerDisabled",
      "defaultValue": "2026-02-13T09:30:00",
      "disabled": true,
      "label": "Disabled",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerReadonly",
      "defaultValue": "2026-02-13T09:30:00",
      "readonly": true,
      "label": "Read only",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "dateTimePicker",
      "path": "dateTimePickerValidation",
      "label": "Required (validation)",
      "props": {
        "icon": "calendar_month",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 30
      },
      "validator": {
        "type": "string",
        "required": true,
        "format": "date-time"
      }
    }
  ]
}
