{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabRepeater",
  "kind": "layout",
  "type": "grid",
  "children": [
    {
      "kind": "input",
      "type": "repeater",
      "path": "repeaters.users",
      "label": "Team Members",
      "props": {
        "title": "Developer",
        "addButtonIcon": "person_add",
        "removeButtonIcon": "delete",
        "addLabel": "Add new developer",
        "addLabel.limitReached": "'Limit Reached, you can't add more'",
        "removeLabel": "Delete",
        "limit": 5,
        "template": {
          "kind": "layout",
          "type": "grid",
          "props": { "direction": "row" },
          "children": [
            {
              "kind": "input",
              "type": "textinput",
              "path": "repeaters.users.items.firstName",
              "size": 5,
              "validator": { "type": "string", "required": true }
            },
            {
              "kind": "input",
              "type": "textinput",
              "path": "repeaters.users.items.lastName",
              "size": 5
            },
            {
              "uid": "userRowMenu",
              "kind": "action",
              "type": "menu",
              "on": {
                "click": "repeaterRowAction"
              },
              "props": {
                "items": [
                  {
                    "label": "Edit",
                    "value": "edit"
                  },
                  {
                    "label": "Duplicate",
                    "value": "duplicate"
                  }
                ],
                "ariaLabel": "Row actions",
                "icon": "more_vert",
                "variant": "outlined",
                "placement": "bottom-end"
              }
            }
          ]
        }
      },
      "validator": {
        "type": "array",
        "required": true,
        "minItems": 1,
        "maxItems": 2
      }
    },
    {
      "uid": "repeaterRowActionResult",
      "kind": "display",
      "type": "alert",
      "props": {
        "text": "Pick an action in the menu of a row.",
        "level": "info"
      }
    }
  ]
}
