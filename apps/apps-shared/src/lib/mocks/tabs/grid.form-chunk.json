{
  "$schema": "../../../../../../libs/gui/shared/src/lib/schemas/layout-widget.schema.json",
  "uid": "tabGrid",
  "kind": "layout",
  "type": "grid",
  "props": {
    "direction": "column"
  },
  "children": [
    {
      "kind": "layout",
      "type": "grid",
      "props": {
        "direction": "row"
      },
      "children": [
        {
          "kind": "input",
          "type": "textinput",
          "path": "listName",
          "label": "List Name",
          "size": 4,
          "props": {
            "hint": "This is a hint"
          },
          "validator": { "type": "string", "required": true }
        },
        {
          "kind": "input",
          "type": "textinput",
          "path": "listOwner",
          "label": "List Owner",
          "size": 4,
          "validator": { "type": "string", "required": true }
        }
      ]
    },
    {
      "kind": "layout",
      "type": "grid",
      "props": {
        "direction": "row"
      },
      "children": [
        {
          "kind": "input",
          "type": "textinput",
          "path": "listName3",
          "label": "List Name",
          "size": 3,
          "validator": { "type": "string", "required": true }
        },
        {
          "kind": "input",
          "type": "textinput",
          "path": "listOwner3",
          "label": "List Owner",
          "size": 3,
          "validator": { "type": "string", "required": true }
        },
        {
          "kind": "input",
          "type": "toggle",
          "label": "Toggle",
          "path": "tg1",
          "size": 3,
          "props": {
            "togglePosition": "left",
            "hint": "Long hints are discouraged with checkboxes and toggles when these share a row with a text input"
          },
          "validator": { "type": "boolean", "required": true }
        },
        {
          "kind": "input",
          "type": "checkbox",
          "label": "Checkbox",
          "path": "cb1",
          "size": 3,
          "props": {
            "checkboxPosition": "left",
            "hint": "Long hints are discouraged with checkboxes and toggles when these share a row with a text input"
          },
          "validator": { "type": "boolean", "required": true }
        }
      ]
    }
  ]
}
