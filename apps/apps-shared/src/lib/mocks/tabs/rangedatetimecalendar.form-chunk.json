          "start": "2026-02-13T09:00:00",
          "end": "2026-02-13T11:00:00"
        }
      ],
      "disabled": true,
      "label": "Disabled",
      "props": {
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "rangeDateTimeCalendar",
      "path": "rangeDateTimeCalendarReadonly",
      "defaultValue": [
        {
          "start": "2026-02-13T09:00:00",
          "end": "2026-02-13T11:00:00"
        }
