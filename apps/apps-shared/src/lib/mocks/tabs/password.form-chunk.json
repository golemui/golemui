{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabPassword",
  "kind": "layout",
  "type": "flex",
  "children": [
    {
      "kind": "input",
      "type": "password",
      "path": "password",
      "props": {
        "autocomplete": "off"
      }
    },
    {
      "kind": "input",
      "type": "password",
      "path": "passwordDisabled",
      "disabled": true,
      "readonly": true
    },
    {
      "kind": "input",
      "type": "password",
      "path": "passwordPhone",
      "props": {
        "placeholder": "Please enter your phone number"
      }
    },
    {
      "kind": "input",
      "type": "password",
      "path": "passwordWithHint",
      "props": {
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number"
      }
    },
    {
      "kind": "input",
      "type": "password",
      "path": "passwordWithIcon",
      "props": {
        "icon": "phone_callback",
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number"
      }
    },
    {
      "kind": "input",
      "type": "password",
      "path": "passwordIconRight",
      "props": {
        "icon": "lock",
        "showPasswordIcon": "visibility",
        "hidePasswordIcon": "visibility_off",
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number"
      },
      "validator": { "type": "string", "required": true }
    }
  ]
}
