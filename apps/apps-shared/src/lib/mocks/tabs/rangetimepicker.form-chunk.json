{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabRangeTimePicker",
  "kind": "layout",
  "type": "grid",
  "children": [
    {
      "kind": "input",
      "type": "rangeTimePicker",
      "path": "rangeTimePickerEmpty",
      "label": "Empty",
      "props": {
        "icon": "schedule",
        "separator": "to",
        "hourFormat": "24",
        "minTime": "06:00:00",
        "maxTime": "22:00:00",
        "minuteStep": 30,
        "allowCustomTime": true,
        "startTimeLabel": "Time In",
        "endTimeLabel": "Time Out",
        "disabledRanges": [
          {
            "start": "13:00:00",
            "end": "14:00:00"
          }
        ],
        "disabledRangeMessage": "Time is withing a disabled range."
      }
    },
    {
      "kind": "input",
      "type": "rangeTimePicker",
      "path": "rangeTimePickerDefault",
      "defaultValue": {
        "start": "09:00:00",
        "end": "12:00:00"
      },
      "label": "Shift schedule",
      "props": {
        "icon": "schedule",
        "separator": "to",
        "hourFormat": "24",
        "minTime": "06:00:00",
        "maxTime": "22:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "rangeTimePicker",
      "path": "rangeTimePickerConstraints",
      "label": "Booking with lunch break",
      "props": {
        "icon": "schedule",
        "separator": "to",
        "hourFormat": "24",
        "minTime": "09:00:00",
        "maxTime": "18:00:00",
        "minuteStep": 15,
        "allowCustomTime": true,
        "disabledRanges": [
          {
            "start": "13:00:00",
            "end": "14:00:00"
          }
        ]
      }
    },
    {
      "kind": "input",
      "type": "rangeTimePicker",
      "path": "rangeTimePickerDisabled",
      "defaultValue": {
        "start": "09:00:00",
        "end": "12:00:00"
      },
      "disabled": true,
      "label": "Disabled",
      "props": {
        "icon": "schedule",
        "separator": "to",
        "hourFormat": "24",
        "minTime": "06:00:00",
        "maxTime": "22:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "rangeTimePicker",
      "path": "rangeTimePickerReadonly",
      "defaultValue": {
        "start": "09:00:00",
        "end": "12:00:00"
      },
      "readonly": true,
      "label": "Read only",
      "props": {
        "icon": "schedule",
        "separator": "to",
        "hourFormat": "24",
        "minTime": "06:00:00",
        "maxTime": "22:00:00",
        "minuteStep": 30
      }
    },
    {
      "kind": "input",
      "type": "rangeTimePicker",
      "path": "rangeTimePickerValidation",
      "label": "Required (validation)",
      "props": {
        "icon": "schedule",
        "separator": "to",
        "hourFormat": "24",
        "minTime": "06:00:00",
        "maxTime": "22:00:00",
        "minuteStep": 30
      },
      "validator": {
        "type": "range",
        "required": true,
        "messages": {
          "required": "Pick a start and an end",
          "invalid": "Pick a start and an end"
        }
      }
    },
    {
      "kind": "layout",
      "type": "grid",
      "props": {
        "direction": "row"
      },
      "children": [
        {
          "kind": "input",
          "type": "textinput",
          "path": "rangeTimePickerShiftNote",
          "label": "Note"
        },
        {
          "kind": "input",
          "type": "rangeTimePicker",
          "path": "rangeTimePickerShift",
          "label": "Shift",
          "props": {
            "icon": "schedule",
            "separator": "to",
            "hourFormat": "24",
            "minuteStep": 30
          }
        }
      ]
    }
  ]
}
