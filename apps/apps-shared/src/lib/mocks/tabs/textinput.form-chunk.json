{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabTextinput",
  "kind": "layout",
  "type": "grid",
  "children": [
    {
      "kind": "input",
      "type": "textinput",
      "path": "textinput",
      "label": "Text input",
      "props": {
        "autocomplete": "off"
      }
    },
    {
      "kind": "input",
      "type": "textinput",
      "path": "textinputDisabled",
      "label": "Disabled text input",
      "disabled": true,
      "readonly": true
    },
    {
      "kind": "input",
      "type": "textinput",
      "path": "textinputPhone",
      "label": "Phone number",
      "props": {
        "placeholder": "Please enter your phone number"
      }
    },
    {
      "kind": "input",
      "type": "textinput",
      "path": "textinputWithHint",
      "label": "Text input with hint",
      "props": {
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number"
      }
    },
    {
      "kind": "input",
      "type": "textinput",
      "path": "textinputWithIcon",
      "label": "Text input with icon",
      "props": {
        "icon": "phone_callback",
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number"
      }
    },
    {
      "kind": "input",
      "type": "textinput",
      "path": "textinputIconRight",
      "label": "Required text input with icon",
      "props": {
        "icon": "phone_callback",
        "hint": "This is a hint",
        "placeholder": "Please enter your phone number"
      },
      "validator": { "type": "string", "required": true }
    },
    {
      "kind": "input",
      "type": "textinput",
      "path": "textinputCustomValidator",
      "label": "Name",
      "props": {
        "hint": "Try a name other than John or Jane",
        "placeholder": "Enter a name"
      },
      "validator": { "type": "custom", "allowedNames": ["John", "Jane"] }
    }
  ]
}
