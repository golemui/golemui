{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabTimeInput",
  "kind": "layout",
  "type": "flex",
  "children": [
    {
      "kind": "input",
      "type": "timeInput",
      "path": "timeInputEmpty",
      "label": "Empty",
      "props": {
        "icon": "schedule",
        "minuteStep": 15
      }
    },
    {
      "kind": "input",
      "type": "timeInput",
      "path": "timeInputDefault",
      "defaultValue": "09:30:00",
      "label": "With default value",
      "props": {
        "icon": "schedule",
        "minuteStep": 15
      }
    },
    {
      "kind": "input",
      "type": "timeInput",
      "path": "timeInputDisabled",
      "defaultValue": "09:30:00",
      "disabled": true,
      "label": "Disabled",
      "props": {
        "icon": "schedule",
        "minuteStep": 15
      }
    },
    {
      "kind": "input",
      "type": "timeInput",
      "path": "timeInputReadonly",
      "defaultValue": "09:30:00",
      "readonly": true,
      "label": "Read only",
      "props": {
        "icon": "schedule",
        "minuteStep": 15
      }
    },
    {
      "kind": "input",
      "type": "timeInput",
      "path": "timeInputValidation",
      "label": "Required (validation)",
      "props": {
        "icon": "schedule",
        "minuteStep": 15
      },
      "validator": {
        "type": "string",
        "required": true,
        "format": "time"
      }
    }
  ]
}
