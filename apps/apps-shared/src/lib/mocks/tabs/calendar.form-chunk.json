{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabCalendar",
  "kind": "layout",
  "type": "flex",
  "children": [
    {
      "kind": "input",
      "type": "calendar",
      "path": "calendarEmpty",
      "label": "Empty"
    },
    {
      "kind": "input",
      "type": "calendar",
      "path": "calendarDefault",
      "defaultValue": "2026-02-13",
      "label": "With default value"
    },
    {
      "kind": "input",
      "type": "calendar",
      "path": "calendarDisabled",
      "defaultValue": "2026-02-13",
      "disabled": true,
      "label": "Disabled"
    },
    {
      "kind": "input",
      "type": "calendar",
      "path": "calendarReadonly",
      "defaultValue": "2026-02-13",
      "readonly": true,
      "label": "Read only"
    },
    {
      "kind": "input",
      "type": "calendar",
      "path": "calendarValidation",
      "label": "Required (validation)",
      "validator": {
        "type": "string",
        "required": true,
        "format": "date"
      }
    },
    {
      "kind": "input",
      "type": "calendar",
      "path": "calendarDisabledRanges",
      "defaultValue": "2026-02-13",
      "label": "Disabled date ranges",
      "props": {
        "disabledRanges": [
          {
            "start": "2026-02-09",
            "end": "2026-02-10"
          },
          {
            "start": "2026-02-17"
          }
        ]
      }
    }
  ]
}
