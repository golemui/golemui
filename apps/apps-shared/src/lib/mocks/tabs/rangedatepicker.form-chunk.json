{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabRangeDatePicker",
  "kind": "layout",
  "type": "flex",
  "children": [
    {
      "kind": "input",
      "type": "rangeDatePicker",
      "path": "rangeDatePickerEmpty",
      "label": "Empty",
      "props": {
        "icon": "calendar_month",
        "separator": "to"
      }
    },
    {
      "kind": "input",
      "type": "rangeDatePicker",
      "path": "rangeDatePickerMinMax",
      "defaultValue": [
        {
          "start": "2026-02-20"
        }
      ],
      "label": "Min/Max",
      "props": {
        "icon": "calendar_month",
        "separator": "to",
        "minDate": "2026-02-01",
        "maxDate": "2026-02-28",
        "minDateMessage": "Min date is 01.02.2026",
        "maxDateMessage": "Max date is 28.02.2026"
      }
    },
    {
      "kind": "input",
      "type": "rangeDatePicker",
      "path": "rangeDatePickerDefault",
      "defaultValue": [
        {
          "start": "2026-02-13",
          "end": "2026-02-16"
        },
        {
          "start": "2026-02-20"
        }
      ],
      "label": "With default value",
      "props": {
        "icon": "calendar_month",
        "separator": "to"
      }
    },
    {
      "kind": "input",
      "type": "rangeDatePicker",
      "path": "rangeDatePickerEditable",
      "defaultValue": [
        {
          "start": "2026-02-13",
          "end": "2026-02-16"
        },
        {
          "start": "2026-02-20"
        }
      ],
      "label": "Editable",
      "props": {
        "allowEdit": true,
        "icon": "calendar_month",
        "separator": "to"
      }
    },
    {
      "kind": "input",
      "type": "rangeDatePicker",
      "path": "rangeDatePickerDisabled",
      "defaultValue": [
        {
          "start": "2026-02-13",
          "end": "2026-02-16"
        },
        {
          "start": "2026-02-20"
        }
      ],
      "disabled": true,
      "label": "Disabled",
      "props": {
        "icon": "calendar_month",
        "separator": "to"
      }
    },
    {
      "kind": "input",
      "type": "rangeDatePicker",
      "path": "rangeDatePickerReadonly",
      "defaultValue": [
        {
          "start": "2026-02-13",
          "end": "2026-02-16"
        },
        {
          "start": "2026-02-20"
        }
      ],
      "readonly": true,
      "label": "Read only",
      "props": {
        "icon": "calendar_month",
        "separator": "to"
      }
    },
    {
      "kind": "input",
      "type": "rangeDatePicker",
      "path": "rangeDatePickerValidation",
      "label": "Required (validation)",
      "props": {
        "icon": "calendar_month",
        "separator": "to"
      },
      "validator": {
        "type": "array",
        "required": true
      }
    },
    {
      "kind": "input",
      "type": "rangeDatePicker",
      "path": "rangeDatePickerDisabledRanges",
      "defaultValue": [
        {
          "start": "2026-02-13",
          "end": "2026-02-16"
        },
        {
          "start": "2026-02-20"
        }
      ],
      "label": "Disabled date ranges",
      "props": {
        "icon": "calendar_month",
        "separator": "to",
        "disabledRanges": [
          {
            "start": "2026-02-09",
            "end": "2026-02-10"
          },
          {
            "start": "2026-02-17"
          }
        ]
      }
    }
  ]
}
