{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabRangeSlider",
  "kind": "layout",
  "type": "grid",
  "children": [
    {
      "kind": "input",
      "type": "rangeSlider",
      "path": "rangeSliders.price",
      "label": "Price per night",
      "props": {
        "hint": "In euros. Screen readers name the thumbs \"From\" and \"To\"",
        "maximum": 500,
        "step": 10,
        "format": {
          "style": "currency",
          "currency": "EUR",
          "maximumFractionDigits": 0
        },
        "startLabel": "From",
        "endLabel": "To"
      },
      "defaultValue": {
        "start": 100,
        "end": 300
      }
    },
    {
      "kind": "input",
      "type": "rangeSlider",
      "path": "rangeSliders.age",
      "label": "Age range",
      "props": {
        "hint": "No range until you move a thumb. Required: an error shows once it is touched",
        "minimum": 18,
        "maximum": 99
      },
      "validator": {
        "type": "range",
        "required": true,
        "messages": {
          "required": "Pick an age range"
        }
      }
    },
    {
      "kind": "input",
      "type": "rangeSlider",
      "path": "rangeSliders.hours",
      "label": "Opening hours",
      "props": {
        "hint": "Labelled marks, and the values in the label and in bubbles",
        "maximum": 24,
        "marks": [
          {
            "value": 0,
            "label": "0:00"
          },
          {
            "value": 6,
            "label": "6:00"
          },
          {
            "value": 12,
            "label": "12:00"
          },
          {
            "value": 18,
            "label": "18:00"
          },
          {
            "value": 24,
            "label": "24:00"
          }
        ],
        "valuePlacement": "both"
      },
      "defaultValue": {
        "start": 9,
        "end": 18
      }
    },
    {
      "kind": "input",
      "type": "rangeSlider",
      "path": "rangeSliders.disabled",
      "label": "Disabled",
      "disabled": true,
      "defaultValue": {
        "start": 20,
        "end": 60
      }
    },
    {
      "kind": "layout",
      "type": "grid",
      "props": {
        "direction": "row"
      },
      "children": [
        {
          "kind": "input",
          "type": "textinput",
          "path": "rangeSliders.city",
          "label": "City",
          "props": {
            "hint": "Where to stay"
          }
        },
        {
          "kind": "input",
          "type": "rangeSlider",
          "path": "rangeSliders.budget",
          "label": "Budget",
          "props": {
            "maximum": 1000,
            "step": 50,
            "format": {
              "style": "currency",
              "currency": "EUR",
              "maximumFractionDigits": 0
            },
            "marks": [
              {
                "value": 0,
                "label": "€0"
              },
              {
                "value": 1000,
                "label": "€1,000"
              }
            ]
          }
        }
      ]
    }
  ]
}
