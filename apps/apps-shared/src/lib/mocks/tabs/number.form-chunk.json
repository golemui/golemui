{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabNumber",
  "kind": "layout",
  "type": "flex",
  "children": [
    {
      "kind": "input",
      "type": "number",
      "path": "number",
      "label": "Celsius",
      "props": {
        "hint": "This is a hint",
        "placeholder": "ºC",
        "minimum": -45,
        "maximum": 42,
        "step": 0.5,
        "autoGrow": true,
        "autocomplete": "off"
      },
      "validator": { "type": "number", "minimum": -45, "maximum": 42, "required": true }
    },
    {
      "kind": "input",
      "type": "number",
      "path": "numberDisabled",
      "disabled": true,
      "readonly": true
    },
    {
      "kind": "input",
      "type": "number",
      "path": "percentage",
      "props": {
        "placeholder": "%"
      }
    },
    {
      "kind": "input",
      "type": "number",
      "path": "percentageWithHint",
      "label": "Percentage",
      "props": {
        "hint": "This is a hint",
        "placeholder": "%"
      }
    },
    {
      "kind": "input",
      "type": "number",
      "path": "numberIcon",
      "props": {
        "hint": "This is a hint",
        "placeholder": "ms"
      }
    },
    {
      "kind": "input",
      "type": "number",
      "path": "numberIconRight",
      "props": {
        "hint": "This is a hint",
        "placeholder": "Inch"
      }
    },
    {
      "kind": "input",
      "type": "number",
      "path": "height",
      "label": "Height",
      "props": {
        "hint": "In meters",
        "step": 0.01
      },
      "validator": { "type": "number", "minimum": 0, "maximum": 2.5, "required": true }
    }
  ]
}
