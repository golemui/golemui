{
  "$schema": "../../../../../../libs/gui/schemas/src/lib/layout-widget.schema.json",
  "uid": "tabCurrency",
  "kind": "layout",
  "type": "grid",
  "children": [
    {
      "kind": "input",
      "type": "currency",
      "path": "currency",
      "label": "Currency",
      "props": {
        "autocomplete": "off"
      }
    },
    {
      "kind": "input",
      "type": "currency",
      "path": "currencyDisabled",
      "label": "Disabled currency",
      "disabled": true,
      "readonly": true
    },
    {
      "kind": "input",
      "type": "currency",
      "path": "currencyMaximumFractionDigits",
      "label": "Currency with maximum fraction digits",
      "props": {
        "placeholder": "maximum 2 digits after the decimal point",
        "maximumFractionDigits": 2
      }
    },
    {
      "kind": "input",
      "type": "currency",
      "path": "currencyMinimumFractionDigits",
      "label": "Currency with minimum fraction digits",
      "props": {
        "placeholder": "minimum 4 digits after the decimal point",
        "minimumFractionDigits": 4
      }
    },
    {
      "kind": "input",
      "type": "currency",
      "path": "currencyWithIcon",
      "label": "Currency with icon",
      "props": {
        "icon": "phone_callback",
        "hint": "This is a hint",
        "placeholder": "Please enter price in USD"
      }
    },
    {
      "kind": "input",
      "type": "currency",
      "path": "currencyIconRightWithEUR",
      "label": "Currency in EUR",
      "props": {
        "currency": "EUR",
        "icon": "phone_callback",
        "hint": "This is a hint",
        "placeholder": "Please enter price in EUR"
      },
      "validator": { "type": "number", "required": true, "minimum": 100 }
    }
  ]
}
