{
  "$schema": "../../../../../libs/gui/schemas/src/lib/form.schema.json",
  "form": [
    {
      "uid": "tab15",
      "kind": "layout",
      "type": "grid",
      "props": { "direction": "row" },
      "children": [
        {
          "kind": "input",
          "type": "dropdown",
          "path": "from",
          "label": "From",
          "size": 1,
          "props": {
            "height": 300,
            "itemHeight": 60,
            "itemRenderer": "airportItemRenderer",
            "labelField": "name",
            "valueField": "iata",
            "inputDebounce": 300,
            "items": []
          },
          "on": {
            "load": "getFromAirports",
            "filter": "getFromAirports"
          }
        },
        {
          "kind": "input",
          "type": "dropdown",
          "path": "to",
          "label": "To",
          "size": 1,
          "props": {
            "height": 300,
            "itemHeight": 60,
            "itemRenderer": "airportItemRenderer",
            "labelField": "name",
            "valueField": "iata",
            "inputDebounce": 300,
            "items": []
          },
          "on": {
            "load": "getToAirports",
            "filter": "getToAirports"
          }
        },
        {
          "kind": "input",
          "type": "number",
          "path": "passengers",
          "defaultValue": 1,
          "label": "Number of passengers"
        }
      ]
    },
    {
      "kind": "input",
      "type": "rangeCalendar",
      "path": "dates",
      "label": "Outbound/Return Dates",
      "props": {
        "prevMonthIcon": "chevron_left",
        "nextMonthIcon": "chevron_right",
        "minDate": "2026-05-13",
        "maxDate": "2026-12-31",
        "disabledRanges": [],
        "numberOfMonths": 2
      }
    }
  ]
}
