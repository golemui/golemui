{
  "name": "tanstack-playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/tanstack-playground/src",
  "tags": ["scope:app", "type:app"],
  "// targets": "to see all targets run: nx show project tanstack-playground --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        { "externalDependencies": ["@tanstack/react-start", "vite"] }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/tanstack-playground"],
      "options": {
        "cwd": "apps/tanstack-playground",
        "command": "npx vite build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/tanstack-playground",
        "command": "npx vite dev"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/tanstack-playground",
        "command": "npx vite preview"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        { "externalDependencies": ["@tanstack/react-start", "typescript"] }
      ],
      "options": {
        "cwd": "apps/tanstack-playground",
        "command": "npx tsc -p tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
