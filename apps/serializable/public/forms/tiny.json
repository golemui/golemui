{
  "form": {
    "uid": "login",
    "kind": "layout",
    "type": "flex",
    "props": { "direction": "column", "gap": "12px" },
    "children": [
      {
        "uid": "login-email",
        "kind": "input",
        "type": "textinput",
        "label": "Email",
        "path": "login.email",
        "props": { "placeholder": "example@domain.com" }
      },
      {
        "uid": "login-password",
        "kind": "input",
        "type": "password",
        "label": "Password",
        "path": "login.password",
        "props": { "placeholder": "Enter your password..." }
      },
      {
        "uid": "login-submit",
        "kind": "action",
        "type": "button",
        "label": "Login"
      }
    ]
  }
}
