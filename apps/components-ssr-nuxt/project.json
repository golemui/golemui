{
  "name": "components-ssr-nuxt",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/components-ssr-nuxt/app",
  "tags": ["scope:app", "type:app"],
  "// targets": "to see all targets run: nx show project components-ssr-nuxt --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", { "externalDependencies": ["nuxt"] }],
      "outputs": ["{workspaceRoot}/dist/apps/components-ssr-nuxt"],
      "options": {
        "cwd": "apps/components-ssr-nuxt",
        "command": "npx nuxt build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/components-ssr-nuxt",
        "command": "npx nuxt dev"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "PORT=3614 node dist/apps/components-ssr-nuxt/server/index.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        { "externalDependencies": ["nuxt", "vue-tsc", "typescript"] }
      ],
      "options": {
        "cwd": "apps/components-ssr-nuxt",
        "command": "npx nuxt typecheck"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
