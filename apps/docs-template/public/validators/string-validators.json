{
  "form": {
    "uid": "",
    "kind": "layout",
    "widget": "stack",
    "children": [
      {
        "uid": "userPasswordInput",
        "kind": "control",
        "widget": "textinput",
        "path": "user.password",
        "validator": {
          "type": "string",
          "required": true,
          "minLength": 8,
          "maxLength": 20,
          "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d]+$"
        }
      }
    ]
  }
}
