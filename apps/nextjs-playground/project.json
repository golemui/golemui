{
  "name": "nextjs-playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/nextjs-playground/src",
  "tags": ["scope:app", "type:app"],
  "// targets": "to see all targets run: nx show project nextjs-playground --web",
  "// outputs": "Next.js requires distDir inside the project dir, so unlike nuxt-playground the build output is apps/nextjs-playground/.next, not dist/apps.",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", { "externalDependencies": ["next"] }],
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "cwd": "apps/nextjs-playground",
        "command": "npx next build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/nextjs-playground",
        "command": "npx next dev -p 3800"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/nextjs-playground",
        "command": "npx next start -p 3800"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production", { "externalDependencies": ["next", "typescript"] }],
      "options": {
        "cwd": "apps/nextjs-playground",
        "command": "npx tsc -p tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
