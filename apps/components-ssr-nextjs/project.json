{
  "name": "components-ssr-nextjs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/components-ssr-nextjs/src",
  "tags": ["scope:app", "type:app"],
  "// targets": "to see all targets run: nx show project components-ssr-nextjs --web",
  "// outputs": "Next.js requires distDir inside the project dir, so the build output is apps/components-ssr-nextjs/.next, not dist/apps.",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", { "externalDependencies": ["next"] }],
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "cwd": "apps/components-ssr-nextjs",
        "command": "npx next build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/components-ssr-nextjs",
        "command": "npx next dev -p 3613"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/components-ssr-nextjs",
        "command": "npx next start -p 3613"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production", "^production", { "externalDependencies": ["next", "typescript"] }],
      "options": {
        "cwd": "apps/components-ssr-nextjs",
        "command": "npx tsc -p tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
