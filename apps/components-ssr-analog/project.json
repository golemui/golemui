{
  "name": "components-ssr-analog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/components-ssr-analog/src",
  "tags": ["scope:app", "type:app"],
  "// targets": "to see all targets run: nx show project components-ssr-analog --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", { "externalDependencies": ["@analogjs/platform"] }],
      "outputs": ["{workspaceRoot}/dist/apps/components-ssr-analog"],
      "options": {
        "cwd": "apps/components-ssr-analog",
        "command": "npx vite build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/components-ssr-analog",
        "command": "npx vite dev"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "PORT=3615 node dist/apps/components-ssr-analog/analog/server/index.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        { "externalDependencies": ["@analogjs/platform", "typescript"] }
      ],
      "options": {
        "cwd": "apps/components-ssr-analog",
        "command": "npx tsc -p tsconfig.app.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
