{
  "name": "astro-playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/astro-playground/src",
  "tags": ["scope:app", "type:app"],
  "// targets": "to see all targets run: nx show project astro-playground --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", { "externalDependencies": ["astro"] }],
      "outputs": ["{workspaceRoot}/dist/apps/astro-playground"],
      "options": {
        "cwd": "apps/astro-playground",
        "command": "ASTRO_TELEMETRY_DISABLED=1 npx astro build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/astro-playground",
        "command": "ASTRO_TELEMETRY_DISABLED=1 npx astro dev"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "PORT=3900 node dist/apps/astro-playground/server/entry.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        { "externalDependencies": ["astro", "@astrojs/check", "typescript"] }
      ],
      "options": {
        "cwd": "apps/astro-playground",
        "command": "ASTRO_TELEMETRY_DISABLED=1 npx astro check"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
