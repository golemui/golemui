---
import '../styles.scss';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<!-- data-theme is the GolemUI theme hook, same as the other playgrounds. -->
<html lang="en" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main class="container">
      <slot />
    </main>
  </body>
</html>
