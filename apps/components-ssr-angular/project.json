{
  "name": "components-ssr-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/components-ssr-angular/src",
  "tags": ["scope:app", "type:app"],
  "// targets": "to see all targets run: nx show project components-ssr-angular --web",
  "targets": {
    "build": {
      "dependsOn": ["build-server"]
    },
    "build-server": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/components-ssr-angular/server"],
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/components-ssr-angular",
        "command": "npx vite build --ssr src/entry-server.ts"
      }
    },
    "serve-ssr": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "node apps/components-ssr-angular/server.mjs"
      }
    },
    "serve-ssr-prod": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/components-ssr-angular/server.mjs --production"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
